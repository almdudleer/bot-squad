# Copy to .env and fill in real values. .env is gitignored.

# Domain root used by traefik (host = bot-squad.${DOMAIN})
DOMAIN=dev.uzinvestapi.com

# JWT signing key for the TG-Login session cookie. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-32-bytes-hex

# Telegram bot used for Login Widget AND for outbound notifications later.
# Reuses @watchbot — same token used by signal-tracker.
TG_BOT_TOKEN=replace-me-with-the-token-from-botfather

# Container UID/GID — must match almdudleer on host so file perms align.
UID=1000
GID=1000
