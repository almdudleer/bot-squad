# Copy to .env and fill in real values. .env is gitignored.

# Domain root used by traefik (host = bot-squad.${DOMAIN})
DOMAIN=dev.uzinvestapi.com

# JWT signing key for the TG-Login session cookie. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-32-bytes-hex

# Telegram bot used for Login Widget AND for outbound notifications later.
# Reuses @watchbot — same token used by signal-tracker.
TG_BOT_TOKEN=8036906248:AAGSZYha1vNkKvA3FYoy_tS7YuTQhbo84c4

# T-0179: at-rest encryption key for secrets.toml values (e.g. the TG bot
# token). One urlsafe-base64 Fernet key, or several comma-separated for
# rotation (first = primary for new writes, rest decrypt only). Loaded by BOTH
# the API container (env_file) and the worker (EnvironmentFile=-.env on its
# systemd unit). Leave BLANK in dev / fresh install → values stay plaintext
# (encryption is opt-in; nothing breaks). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   # or, without python deps:  openssl rand -base64 32 | tr '+/' '-_'
# Rotation: prepend a new key (NEW,OLD), restart API + worker, re-save the
# token in Settings (re-encrypts under NEW), then drop OLD and restart.
BOT_SQUAD_SECRETS_KEY=

# Container UID/GID — must match almdudleer on host so file perms align.
UID=1000
GID=1000
