#!/usr/bin/env bash
#
# pre-push hook — a REFUSING secret gate (T-0659), then the invariant gates
# (T-0186 attr smoke, T-0738/T-0743 mirrors).
#
# GATE 0 — NO PUSHED COMMIT MAY INTRODUCE A SECRET-LIKE PATH (T-0659)
# -------------------------------------------------------------------
# Ported whole from the sibling repository, where T-0658 built it. It exists
# because `pre-commit` is only ever run by `git commit`: cherry-pick, merge,
# rebase, am, `--no-verify`, `commit-tree` and a clone with `core.hooksPath`
# unset all reach history without it — measured there, not assumed. A release is
# a cherry-pick by construction, so that is not an exotic path, it is the
# shipping path. On 2026-08-14 this repository took `4576a03` — 425 files as
# `t <t@t>`, `api/_t/cfg/secrets.toml` among them.
#
# It runs FIRST and is released only by its OWN key, which must NAME every path:
#   BOT_SQUAD_ALLOW_SECRET_PUSH='<path>[,<path>…]' git push …
# Never by BOT_SQUAD_SKIP_ATTR_SMOKE, which belongs to the lint gates below: one
# habitual variable must not disarm two unrelated defences, and that one is
# typed whenever the lint gates are in the way. Its placement above that
# variable's early exit is load-bearing for exactly the same reason.
#
# --- the invariant gates, unchanged from here down -------------------------
#
# The shared dev clone is edited by many concurrent bot-squad sessions. A
# peer's raw `git add -A` / `git add <dir>` can sweep ANOTHER session's
# unstaged, in-flight edits into the peer's commit (the T-0068 / T-0145
# incident class). The danger is a *split* absorb: a multi-file change where
# only SOME files get swept — e.g. `actions.py` ships referencing a new
# `Config` field while the `config.py` that defines it does not (the live
# `fb01921` / T-0171 break → AttributeError on origin, after deploy).
#
# The related failure is a *duplicate divergence*: this repo keeps several
# modules in two copies on purpose (worker vs api, independent packages), and a
# fix that lands in only one copy ships broken. T-0733 did exactly that to
# `task_body.py` in 5fe547f, with CI green — the guard existed and was silent
# because nothing ran it, until a session ran the full worker suite by hand
# hours later (T-0736 / T-0738). T-0743 widened that gate from `task_body.py`
# alone to every duplicated-by-design pair in the repo; each pair's own check
# had been sitting in the same never-run worker suite, and `frontmatter.py` had
# no check at all.
#
# So this hook runs the cheap invariant gates before a push reaches origin (and
# thus before the deploy, which builds from origin):
#
#   cross_module_attr_smoke.py  proves every `cfg.<attr>` access in a consumer
#                               resolves to a real member of the provider class
#   module_mirrors.py           proves every declared duplicated-by-design pair
#                               (worker/tests/test_module_mirrors.py::MIRRORS)
#                               is still identical
#
# Both are pure stdlib — no deps, no venv, no data tree, sub-second. They are
# the class of check that belongs on EVERY push. Full suites (worker ~137s and
# needing its venv, api needing its image) deliberately do NOT run here; see
# .github/workflows/lint.yml. Any failure blocks the push. CI runs the same two
# scripts as defense-in-depth for pushes that bypass the hook.
#
# Enable in this clone with: git config core.hooksPath .githooks
# Skip per-push (not recommended): BOT_SQUAD_SKIP_ATTR_SMOKE=1 skips both gates
# (the historical name, kept working; it is the documented override).

set -uo pipefail

# ---- gate 0: the secret gate (T-0659) — before ANY early exit --------------
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/commit-policy.sh
. "${HOOK_DIR}/lib/commit-policy.sh"   # cp__is_secretlike, cp__strip, pa_* fallbacks
# shellcheck source=lib/push-policy.sh
. "${HOOK_DIR}/lib/push-policy.sh"

PP_REMOTE="${1:-}"

# Slurp stdin BEFORE running any git: git subprocesses inherit this stdin and
# would eat the ref lines out from under the loop.
pp_ref_lines=()
while IFS= read -r pp_line; do
    [ -n "$pp_line" ] && pp_ref_lines+=("$pp_line")
done

pp_rc=0
if [ "${#pp_ref_lines[@]}" -gt 0 ]; then
    for pp_line in "${pp_ref_lines[@]}"; do
        # shellcheck disable=SC2086  # deliberate word split of the 4-field line
        set -- $pp_line
        pp_check_push "$PP_REMOTE" "${1:-}" "${2:-}" "${3:-}" "${4:-}" </dev/null || pp_rc=1
    done
fi
[ "$pp_rc" -eq 0 ] || exit 1

# ---- the invariant gates (T-0186 / T-0738 / T-0743) — unchanged ------------

[ "${BOT_SQUAD_SKIP_ATTR_SMOKE:-}" = "1" ] && exit 0

# Resolve the repo root from the hook's location (.githooks/ is at the top).
hook_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd "$hook_dir/.." && pwd)

failed=0

# run_gate <script-basename> <block-message>
# A missing script (older checkout) is skipped, not a block.
run_gate() {
    local script="$repo_root/scripts/lint/$1"
    local message="$2"

    [ -f "$script" ] || return 0

    python3 "$script" --root "$repo_root"
    local rc=$?
    if [ "$rc" -ne 0 ]; then
        printf '\033[31m%s\033[0m\n' "$message"
        failed=1
    fi
}

run_gate cross_module_attr_smoke.py \
    "pre-push BLOCKED by cross-module attribute smoke (T-0186): a consumer references a provider member that does not exist — likely a wide-add absorption split. Fix the missing field/import and re-push."

run_gate module_mirrors.py \
    "pre-push BLOCKED by the duplicated-module mirror gate (T-0738/T-0743): a module this repo keeps in two copies on purpose has diverged — a change landed in only one copy (the T-0714 / T-0733 failure). The offending pair(s) are named above. Mirror the change into the other copy and re-push."

if [ "$failed" -ne 0 ]; then
    printf '\033[31m%s\033[0m\n' \
        "(override with BOT_SQUAD_SKIP_ATTR_SMOKE=1 — not recommended: every gate above is a bug that has already shipped to origin once)"
    exit 1
fi
exit 0
