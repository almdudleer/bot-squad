# Runtime data — never tracked
data/
archived/

# Worker socket directory contents (the dir exists, contents are runtime)
data/_sock/*
data/_worker/*

# Secrets
.env
config/auth.toml
config/secrets.toml

# Runtime system settings (managed by admin UI, not source)
config/system_settings.toml

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Node
node_modules/
web/dist/
# TypeScript incremental compile cache — regenerated every build
web/tsconfig.tsbuildinfo

# Editor
.vscode/
.idea/
.claude/

# Initial credentials file (for stakeholder reference)
INITIAL_LOGIN.txt

# Playwright dev-dep installed at repo root for staging UI verification
# (operator-authorized 2026-05-26 per T-0117). node_modules/ already ignored
# above. These two land in the repo root, not in web/.
/package.json
/package-lock.json

# Project docs live in the ops data dir (data/<slug>/docs/), surfaced into
# the clone as a `docs/` symlink by `bsq docs sync` (T-0172/T-0183). The
# legacy tracked docs/ (multi-user-setup + superpowers plans|specs) was
# migrated into the docs system as D-0004..D-0016; ignore the symlink.
/docs
