#27 [frontend-unit-gate 3/3] RUN --mount=type=bind,rw,source=web,target=/app/web     --mount=type=bind,source=tests,target=/app/tests     --mount=type=bind,rw,from=frontend-deps,source=/app/web/node_modules,target=/app/web/node_modules     case "0" in       1) bash tests/frontend-unit-gate-selftest.sh;          bash tests/frontend-unit-gate.sh 2>&1 | tee /gate.log;          { echo "gate=on"; grep -E '^# (tests|pass|fail) ' /gate.log; } > /gate-receipt ;;       0) echo "gate=off (WR_FE_UNIT_GATE=0)" > /gate-receipt ;;       *) echo "FATAL: WR_FE_UNIT_GATE не задан. Допустимо 1 (гонять сьюту) или 0 (не гонять)." >&2;          exit 1 ;;     esac
