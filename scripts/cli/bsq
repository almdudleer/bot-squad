# --------------------------------------------------------------------------
# T-0482: user-controlled execution pace (Process Paradigm M3 / F3.4).
#
# The user surface for the pace-control config the operator consumes
# (`worker/bot_squad_worker/pace.py` is the worker-side SSOT). This verb writes
# the SAME per-project JSON the worker reads (`_worker/pace/pace.json`) directly
# — no worker action, so it never co-edits the single-owner actions.py / closed
# allowlist. Global pause delegates to the operator_redrive flag file (the one
# pause SSOT the re-drive cadence already honors).
#
# Storage shape mirrors pace.py: {max_in_progress:int, initiatives:{<.md>:{weight,
# priority,paused}}}. Display applies the same defaults pace.read_config does.
# --------------------------------------------------------------------------
_PACE_DEFAULT_WEIGHT = 1.0
_PACE_DEFAULT_PRIORITY = 0


def _pace_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "_worker" / "pace"


def _pace_config_path(slug: str) -> Path:
    return _pace_dir(slug) / "pace.json"


def _pace_redrive_flag(slug: str) -> Path:
    # SAME path operator_redrive._pause_flag_path writes/reads (single pause SSOT).
    return Path(BOT_SQUAD) / "data" / slug / "_worker" / "operator_redrive" / "operator_paused.flag"


def _pace_normalize_initiative(name: str) -> str:
    """Canonical key = the .md basename form (matches task `initiative:` field).
    Mirrors pace.normalize_initiative so both sides address one initiative id."""
    base = Path(str(name).strip()).name
    if base.lower().endswith(".md"):
        base = base[:-3]
    return f"{base}.md" if base else ""


def _pace_load_raw(slug: str) -> dict:
    p = _pace_config_path(slug)
    if not p.exists():
        return {}
    try:
        data = json.loads(p.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def _pace_save_raw(slug: str, data: dict) -> None:
    d = _pace_dir(slug)
    d.mkdir(parents=True, exist_ok=True)
    p = _pace_config_path(slug)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True))
    os.replace(tmp, p)


def _pace_norm_entry(body: dict) -> dict:
    body = body if isinstance(body, dict) else {}

    def _f(v, d):
        try:
            return float(v)
        except (TypeError, ValueError):
            return d

    def _i(v, d):
        try:
            return int(v)
        except (TypeError, ValueError):
            return d

    return {
        "weight": _f(body.get("weight"), _PACE_DEFAULT_WEIGHT),
        "priority": _i(body.get("priority"), _PACE_DEFAULT_PRIORITY),
        "paused": str(body.get("paused", "")).strip().lower() in ("true", "yes", "1", "on")
        if not isinstance(body.get("paused"), bool) else body.get("paused"),
    }


def _pace_initiatives(raw: dict) -> dict:
    out: dict = {}
    src = raw.get("initiatives")
    if isinstance(src, dict):
        for name, body in src.items():
            key = _pace_normalize_initiative(name)
            if key:
                out[key] = _pace_norm_entry(body)
    return out


def _pace_weekly_target_pct(slug: str) -> float | None:
    """Mirrors operator_redrive.weekly_quota_target_pct: best-effort read of
    ``[operator].weekly_quota_target_pct`` from system_settings.toml."""
    path = Path(BOT_SQUAD) / "config" / "system_settings.toml"
    if not path.exists():
        return None
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    v = (data.get("operator") or {}).get("weekly_quota_target_pct")
    try:
        return float(v) if v is not None else None
    except (TypeError, ValueError):
        return None


def _pace_spend_pct(slug: str) -> float | None:
    """Mirrors operator_redrive._burn_signal's spend_pct (F2.7): best-effort
    percent of the operator-set ``[quota]`` budget spent to date, derived from
    ``_worker/telemetry/_quota.json``'s persisted anchor + remaining_tokens
    (T-0646: was bare ``_telemetry/``, the SAME wrong path _burn_signal had —
    telemetry.py's ``_telemetry_dir`` is ``_worker/telemetry``). None when no
    anchor is set (no total to measure spend against)."""
    path = Path(BOT_SQUAD) / "data" / slug / "_worker" / "telemetry" / "_quota.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    anchor = data.get("anchor") or {}
    remaining = data.get("remaining_tokens")
    try:
        budget = float(anchor.get("budget_tokens"))
        if budget > 0 and remaining is not None:
            return max(0.0, min(100.0, 100.0 * (budget - float(remaining)) / budget))
    except (TypeError, ValueError):
        pass
    return None


def _pace_verdict(target_pct: float | None, spend_pct: float | None) -> str | None:
    """Mirrors operator_redrive.pace_verdict: under/on/over, or None if either
    signal is unknown."""
    if target_pct is None or spend_pct is None:
        return None
    if spend_pct < target_pct:
        return "under"
    if spend_pct > target_pct:
        return "over"
    return "on"


def cmd_pace_show(args) -> None:
    """T-0482: print the project's pace-control config (the user's pace surface).
    T-0579/F2.7: also surfaces the weekly-quota-target pace verdict (under/on/over)."""
    slug = resolve_slug()
    raw = _pace_load_raw(slug)
    try:
        mip = max(0, int(raw.get("max_in_progress", 0)))
    except (TypeError, ValueError):
        mip = 0
    paused = _pace_redrive_flag(slug).exists()
    inits = _pace_initiatives(raw)
    print(f"pace control for {slug}:")
    print(f"  max_in_progress: {mip if mip else '0 (unlimited)'}")
    print(f"  paused (global): {'yes' if paused else 'no'}")
    if inits:
        print("  initiatives:")
        for key in sorted(inits):
            e = inits[key]
            print(f"    {key}  weight={e['weight']} priority={e['priority']} "
                  f"paused={'yes' if e['paused'] else 'no'}")
    else:
        print("  initiatives: (none)")
    target = _pace_weekly_target_pct(slug)
    if target is None:
        print("  weekly quota target: (none set)")
    else:
        spend = _pace_spend_pct(slug)
        verdict = _pace_verdict(target, spend)
        spend_s = f"{spend:.1f}%" if spend is not None else "unknown (no quota anchor)"
        verdict_s = verdict if verdict is not None else "unknown"
        print(f"  weekly quota target: {target}%  spend-to-date: {spend_s}  "
              f"verdict: {verdict_s}")


def cmd_pace_set(args) -> None:
    """T-0482: set the global max-in-progress ceiling (0 = unlimited)."""
    slug = resolve_slug()
    if args.max_in_progress is None:
        die("nothing to set — pass --max-in-progress N")
    n = max(0, int(args.max_in_progress))
    raw = _pace_load_raw(slug)
    raw["max_in_progress"] = n
    _pace_save_raw(slug, raw)
    print(f"pace[{slug}]: max_in_progress = {n if n else '0 (unlimited)'}")


def cmd_pace_initiative(args) -> None:
    """T-0482: set a per-initiative weight / priority / pause (steer the order)."""
    slug = resolve_slug()
    key = _pace_normalize_initiative(args.name)
    if not key:
        die("initiative name must be non-empty")
    if args.weight is None and args.priority is None and not args.pause and not args.resume:
        die("nothing to set — pass --weight / --priority / --pause / --resume")
    if args.pause and args.resume:
        die("--pause and --resume are mutually exclusive")
    raw = _pace_load_raw(slug)
    inits = _pace_initiatives(raw)
    entry = inits.get(key, {
        "weight": _PACE_DEFAULT_WEIGHT, "priority": _PACE_DEFAULT_PRIORITY, "paused": False})
    if args.weight is not None:
        entry["weight"] = float(args.weight)
    if args.priority is not None:
        entry["priority"] = int(args.priority)
    if args.pause:
        entry["paused"] = True
    if args.resume:
        entry["paused"] = False
    inits[key] = entry
    raw["initiatives"] = inits
    _pace_save_raw(slug, raw)
    print(f"pace[{slug}]: {key}  weight={entry['weight']} priority={entry['priority']} "
          f"paused={'yes' if entry['paused'] else 'no'}")


def cmd_pace_clear(args) -> None:
    """T-0482: drop one initiative's pace entry (revert it to defaults)."""
    slug = resolve_slug()
    key = _pace_normalize_initiative(args.name)
    raw = _pace_load_raw(slug)
    inits = _pace_initiatives(raw)
    if key not in inits:
        print(f"pace[{slug}]: no entry for {key} (already at defaults)")
        return
    del inits[key]
    raw["initiatives"] = inits
    _pace_save_raw(slug, raw)
    print(f"pace[{slug}]: cleared {key}")


def cmd_pace_pause(args) -> None:
    """T-0482: GLOBAL operator pause — stop the re-drive from starting new work.
    Writes the SAME flag operator_redrive.is_paused honors (single pause SSOT)."""
    slug = resolve_slug()
    flag = _pace_redrive_flag(slug)
    flag.parent.mkdir(parents=True, exist_ok=True)
    meta = {"paused_by": require_sid(getattr(args, "sid", None)) or "user",
            "reason": getattr(args, "reason", "") or "", "paused_at": time.time()}
    tmp = flag.with_suffix(".flag.tmp")
    tmp.write_text(json.dumps(meta, indent=2))
    os.replace(tmp, flag)
    print(f"pace[{slug}]: PAUSED — operator re-drive stops starting new work "
          f"(resume with `bsq pace resume`)")


def cmd_pace_resume(args) -> None:
    """T-0482: clear the GLOBAL operator pause."""
    slug = resolve_slug()
    flag = _pace_redrive_flag(slug)
    if flag.exists():
        flag.unlink()
        print(f"pace[{slug}]: RESUMED — operator re-drive may start new work")
    else:
        print(f"pace[{slug}]: not paused (nothing to resume)")


# --------------------------------------------------------------------------
# T-0215: per-session hunk-isolated commits for co-edited files.
#
# The shared clone has one working tree + one `.git/index` across ~10 sessions.
# `bsq commit -- <f>` (pathspec) is absorb-proof for the INDEX but still commits
# the WHOLE file from the worktree — so a peer's dirty hunks in <f> ride along.
# Approach A (T-0215): `bsq edit-begin <f>` snapshots this session's baseline;
# `bsq commit --hunks -- <f>` commits only the (baseline → current) diff, applied
# onto a TEMP index seeded from HEAD. The shared index and the peer's worktree
# hunks are never touched, so a co-edited file can't sweep a peer's work.
# Limitation: if a peer edits the SAME region AFTER your edit-begin, the apply
# fails loud (never corrupts) and you resolve manually.
# --------------------------------------------------------------------------
def _sanitize_sid(sid: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]", "_", sid or "")


def worktree_store(slug: str, sid: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "_worktree" / _sanitize_sid(sid)


def _snapshot_path(store: Path, relpath: str) -> Path:
    """Mirror a repo-relative path under <store>/files/, rejecting traversal."""
    rel = (relpath or "").strip()
    if not rel or os.path.isabs(rel):
        raise ValueError(f"unsafe snapshot path: {relpath!r}")
    files_root = (store / "files").resolve()
    target = (files_root / rel).resolve()
    if target != files_root and not str(target).startswith(str(files_root) + os.sep):
        raise ValueError(f"path escapes snapshot store: {relpath!r}")
    return store / "files" / rel


def _rewrite_patch_headers(raw: str, relpath: str) -> str:
    """Normalize git `--no-index` scratch a//b// paths to repo-relative a/<rel> b/<rel>.

    Leaves /dev/null markers (new/deleted file) and every body line intact so the
    result applies with `git apply -p1` at the right repo location.
    """
    a, b = f"a/{relpath}", f"b/{relpath}"
    out: list[str] = []
    for line in raw.splitlines(keepends=True):
        nl = "\n" if line.endswith("\n") else ""
        s = line.rstrip("\n")
        if s.startswith("diff --git "):
            out.append(f"diff --git {a} {b}{nl}")
        elif s.startswith("--- "):
            out.append(f"--- {'/dev/null' if s[4:] == '/dev/null' else a}{nl}")
        elif s.startswith("+++ "):
            out.append(f"+++ {'/dev/null' if s[4:] == '/dev/null' else b}{nl}")
        else:
            out.append(line)
    return "".join(out)


def make_hunk_patch(relpath: str, baseline: Path, current: Path) -> str:
    """Unified diff baseline→current as a `git apply -p1` patch; '' if identical."""
    proc = subprocess.run(
        ["git", "diff", "--no-color", "--no-index", "--", str(baseline), str(current)],
        capture_output=True, text=True,
    )
    if proc.returncode == 0 or not proc.stdout:
        return ""  # identical (rc 0) or a hard error with no diff body
    return _rewrite_patch_headers(proc.stdout, relpath)


def _repo_root() -> str:
    rr = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    ).stdout.strip()
    if not rr:
        die("not inside a git repo")
    return rr


def _repo_relpath(repo_root: str, f: str) -> str:
    p = Path(f)
    ap = p if p.is_absolute() else Path(os.getcwd()) / p
    rel = os.path.relpath(os.path.realpath(ap), os.path.realpath(repo_root))
    if rel.startswith(".."):
        die(f"path not under repo: {f}")
    return rel


def cmd_edit_begin(args) -> None:
    """Snapshot files' current bytes as this session's baseline for `commit --hunks`."""
    slug = resolve_slug()
    sid = require_sid(getattr(args, "sid", None))
    repo_root = _repo_root()
    store = worktree_store(slug, sid)
    absent: list[str] = []
    for f in args.files:
        rel = _repo_relpath(repo_root, f)
        snap = _snapshot_path(store, rel)
        snap.parent.mkdir(parents=True, exist_ok=True)
        src = Path(repo_root) / rel
        if src.exists():
            shutil.copyfile(src, snap)
        else:
            if snap.exists():
                snap.unlink()
            absent.append(rel)
    if absent:
        ab = store / "absent.txt"
        have = set(ab.read_text().split()) if ab.exists() else set()
        have.update(absent)
        ab.write_text("\n".join(sorted(have)) + "\n")
    print(f"edit-begin: baselined {len(args.files)} file(s) for {sid}")


def _commit_hunks(args, repo_root: str) -> None:
    slug = resolve_slug()
    sid = require_sid(getattr(args, "sid", None))
    if not args.files:
        die("commit --hunks needs explicit file paths")
    store = worktree_store(slug, sid)
    if not store.exists():
        die("commit --hunks: no baseline for this session — run "
            "`bsq edit-begin <files>` before editing")
    ab = store / "absent.txt"
    absent = set(ab.read_text().split()) if ab.exists() else set()

    patches: list[str] = []
    rels: list[str] = []
    for f in args.files:
        rel = _repo_relpath(repo_root, f)
        snap = _snapshot_path(store, rel)
        cur = Path(repo_root) / rel
        if snap.exists():
            baseline = snap
        elif rel in absent:
            baseline = Path("/dev/null")
        else:
            die(f"commit --hunks: no baseline for {rel} — run `bsq edit-begin {rel}` first")
        if not cur.exists():
            die(f"commit --hunks: {rel} no longer exists in the worktree")
        patch = make_hunk_patch(rel, baseline, cur)
        if patch:
            patches.append(patch)
            rels.append(rel)
    if not patches:
        print("commit --hunks: no changes since edit-begin; nothing to commit")
        return

    pf = tempfile.NamedTemporaryFile("w", suffix=".patch", delete=False)
    pf.write("".join(patches))
    pf.close()
    tmp_index = pf.name + ".index"
    env = dict(os.environ)
    env["GIT_INDEX_FILE"] = tmp_index
    try:
        rt = subprocess.run(["git", "read-tree", "HEAD"], cwd=repo_root, env=env,
                            capture_output=True, text=True)
        if rt.returncode != 0:
            die(f"commit --hunks: git read-tree HEAD failed: {rt.stderr.strip()}")
        ap = subprocess.run(
            ["git", "apply", "--cached", "--recount", "--whitespace=nowarn", pf.name],
            cwd=repo_root, env=env, capture_output=True, text=True,
        )
        if ap.returncode != 0:
            die("commit --hunks: could not apply your hunks onto HEAD — your edit "
                "likely overlaps a peer's concurrent change in the same region; "
                f"resolve manually.\n{ap.stderr.strip()}")
        safe_commit = f"{BOT_SQUAD}/scripts/cli/safe-commit.sh"
        if not os.path.exists(safe_commit):
            safe_commit = str(Path(repo_root) / "ops" / "bot-squad-bin" / "safe-commit")
        if args.ack:
            env["BOT_SQUAD_ACK_PEERS"] = "1"
        # No pathspec: the temp index already holds EXACTLY HEAD + my hunks.
        rc = subprocess.run([safe_commit, "-m", args.message], cwd=repo_root, env=env).returncode
        if rc != 0:
            if not args.ack:
                print(
                    "\nbsq: commit --hunks blocked by the peer-activity hook (expected "
                    "on the first attempt). Review the report above, then re-run with "
                    f"--ack:\n  bsq commit --hunks --ack -m {json.dumps(args.message)} "
                    f"{' '.join(args.files)}",
                    file=sys.stderr,
                )
            sys.exit(rc)
    finally:
        for p in (pf.name, tmp_index):
            try:
                os.unlink(p)
            except OSError:
                pass
    # Success — clear the consumed baselines so a later edit re-snapshots fresh.
    for rel in rels:
        try:
            _snapshot_path(store, rel).unlink()
        except (OSError, ValueError):
            pass
    if ab.exists():
        remaining = absent - set(rels)
        if remaining:
            ab.write_text("\n".join(sorted(remaining)) + "\n")
        else:
            ab.unlink()
    print(f"commit --hunks: committed {len(rels)} file(s)' own hunks for {sid}")
    sys.exit(0)


def _is_install_clone(repo_root: str) -> bool:
    """True when ``repo_root`` is the running installation's own clone
    (``BOT_SQUAD``) rather than a project's editing (dev/master) clone.

    The install is a deploy TARGET, not an editing surface. A commit made
    there never reaches origin through the normal dev-clone flow and can trip
    the deploy commit-guard's destroy check (T-0305 incident, 2026-07-18:
    534bf49 committed in-place in /home/www/bot-squad failed the destroy-guard
    and needed operator cherry-pick + reset recovery — T-0651).
    """
    return os.path.realpath(repo_root) == os.path.realpath(BOT_SQUAD)


def _dev_clone_hint() -> str:
    """Best-effort bot-squad dev-clone path to point a misdirected commit at."""
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
        repo_path = cfg.get("projects", {}).get("bot-squad", {}).get("repo_path")
        if repo_path:
            return repo_path
    except OSError:
        pass
    return "the project's dev clone (see repo_path in projects.toml)"


def cmd_commit(args) -> None:
    repo_root = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    ).stdout.strip()
    if not repo_root:
        die("not inside a git repo")
    if _is_install_clone(repo_root):
        die(
            f"refusing to commit inside the INSTALL clone ({BOT_SQUAD}) — "
            "that's the deploy TARGET, not an editing surface. A commit made "
            "here can trip the deploy destroy-guard (T-0305/T-0651). cd to "
            f"the dev clone and retry:\n  cd {_dev_clone_hint()}"
        )
    if getattr(args, "hunks", False):
        return _commit_hunks(args, repo_root)
    if not args.files:
        die("commit needs explicit file paths (never wide-add)")
    safe_commit = f"{BOT_SQUAD}/scripts/cli/safe-commit.sh"
    if not os.path.exists(safe_commit):
        safe_commit = str(Path(repo_root) / "ops" / "bot-squad-bin" / "safe-commit")

    # Stage ONLY the explicit paths (no `git add .` / `-u` / dir — that
    # sweeps peers' in-flight work into your commit) — and do it INSIDE
    # safe-commit's advisory lock (T-0648), not here. A `git add` run here,
    # before the lock, races a concurrent lane's locked `git commit` for
    # `.git/index.lock`: both processes touch the one shared index, and
    # under stress that collision surfaces as either a hard EEXIST failure
    # or (via the peer-activity hook re-reading a part-written index) a
    # dev believing nothing landed when it did, or vice versa — the
    # p31/p34 2026-07-18 incident. Handing the path list to safe-commit.sh
    # via a NUL-separated temp file makes stage+commit one lock-scoped
    # critical section, so no interleaving with a peer's add/commit is
    # possible.
    stage_file = tempfile.NamedTemporaryFile(
        mode="wb", suffix=".stage-paths", delete=False
    )
    try:
        stage_file.write(b"".join(f.encode() + b"\0" for f in args.files))
        stage_file.close()

        env = dict(os.environ)
        env["BOT_SQUAD_STAGE_PATHS_FILE"] = stage_file.name
        if args.ack:
            env["BOT_SQUAD_ACK_PEERS"] = "1"
        cmd = [safe_commit, "-m", args.message, "--", *args.files]
        rc = subprocess.run(cmd, env=env).returncode
    finally:
        try:
            os.unlink(stage_file.name)
        except OSError:
            pass
    if rc != 0 and not args.ack:
        print(
            "\nbsq: commit blocked by the peer-activity pre-commit hook (this is "
            "expected on the first attempt). Review the report above, then re-run "
            "with --ack to acknowledge:\n"
            f"  bsq commit --ack -m {json.dumps(args.message)} {' '.join(args.files)}",
            file=sys.stderr,
        )
    sys.exit(rc)


# --------------------------------------------------------------------------
# guidance search (T-0151) — stakeholder guidance gets buried in suspended
# sessions' .jsonl logs and in ticket bodies; new sessions repeat questions
# 3-4× because they don't dig for it. This verb surfaces prior
# stakeholder-attributed comments matching a query across three corpora:
#   1. backlog T-*.md  "Verbatim request" sections (human source-of-truth)
#   2. data/<slug>/sessions/*.md bodies (close-hook appends stakeholder notes)
#   3. ~/.claude/projects/*/*.jsonl  human-typed (userType=external) messages
# T-0149's deterministic spawn prompt auto-runs this and folds in the hits.
# --------------------------------------------------------------------------
_CLAUDE_PROJECTS = os.path.expanduser("~/.claude/projects")
# jsonl user-string lines that are NOT stakeholder guidance (bus signals,
# injected briefs, dispatch envelopes, command/system wrappers).
_NON_STAKEHOLDER_PREFIXES = ("You are a bot-squad", ENVELOPE_MARKER)
_JSONL_PARSE_CAP = 400  # most-recently-modified candidate files to parse


def _snippet(text: str, kws: list[str], width: int = 220) -> str:
    """One-line snippet centred on the first matched keyword."""
    flat = re.sub(r"\s+", " ", text).strip()
    low = flat.lower()
    pos = min((low.find(k) for k in kws if low.find(k) >= 0), default=0)
    start = max(0, pos - 40)
    end = min(len(flat), start + width)
    s = flat[start:end]
    if start > 0:
        s = "…" + s
    if end < len(flat):
        s = s + "…"
    return s


def _score(text: str, kws: list[str]) -> int:
    low = text.lower()
    return sum(1 for k in kws if k in low)


def _jsonl_search_dirs(slug: str, all_projects: bool) -> list[str]:
    """Which ~/.claude/projects/* dirs to grep.

    Default: dirs whose name contains a slug token (the stakeholder discusses
    a project inside that project's own sessions — far smaller corpus, ~10×
    faster than the full tree). ``--all-projects`` greps everything.
    """
    if not os.path.isdir(_CLAUDE_PROJECTS):
        return []
    all_dirs = [os.path.join(_CLAUDE_PROJECTS, d) for d in os.listdir(_CLAUDE_PROJECTS)
                if os.path.isdir(os.path.join(_CLAUDE_PROJECTS, d))]
    if all_projects:
        return all_dirs
    # Match the full normalized slug ("bot-squad") in the dir basename — the
    # path-derived dir names use '-' as the separator, so the slug appears
    # literally. (Per-token matching is too loose: "bot" hits "watchrobot".)
    needle = re.sub(r"[^a-z0-9]+", "-", slug.lower()).strip("-")
    scoped = [d for d in all_dirs if needle in os.path.basename(d).lower()]
    return scoped or all_dirs  # fall back to all if no slug-matched dir


def _grep_candidate_jsonl(kws: list[str], dirs: list[str]) -> list[str]:
    """Fast prefilter: jsonl files containing ANY keyword (fixed-string)."""
    if not dirs:
        return []
    cmd = ["grep", "-rlFi", "--include=*.jsonl"]
    for k in kws:
        cmd += ["-e", k]
    cmd += dirs
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return []
    return [ln for ln in out.stdout.splitlines() if ln.strip()]


def _scan_jsonl(path: str, kws: list[str]) -> list[dict]:
    hits = []
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return hits
    with fh:
        for line in fh:
            if not line.strip():
                continue
            try:
                o = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                continue
            if o.get("type") != "user" or o.get("isSidechain"):
                continue
            msg = o.get("message") or {}
            content = msg.get("content")
            if not isinstance(content, str):
                continue
            if o.get("userType") != "external":
                continue
            c = content.strip()
            if not c or c.startswith("<") or c == MAIL_SIGNAL:
                continue
            if any(c.startswith(p) for p in _NON_STAKEHOLDER_PREFIXES):
                continue
            sc = _score(c, kws)
            if sc <= 0:
                continue
            proj = os.path.basename(os.path.dirname(path))
            hits.append({
                "ts": o.get("timestamp", ""),
                "source": f"jsonl:{proj}",
                "score": sc,
                "text": _snippet(c, kws),
            })
    return hits


def _scan_md_section(path: Path, kws: list[str], section: str | None) -> list[dict]:
    """Match keywords in a ticket Verbatim section / whole session body."""
    try:
        raw = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    fm = read_frontmatter(path)
    body = re.sub(r"\A---\n.*?\n---\n", "", raw, flags=re.DOTALL)
    body = _extract_md_section(body, section) if section else body.strip()
    if not body:
        return []
    sc = _score(body, kws)
    if sc <= 0:
        return []
    ts = fm.get("updated") or fm.get("created") or ""
    label = fm.get("id") or path.stem
    return [{"ts": ts, "source": f"{path.parent.name}:{label}",
             "score": sc, "text": _snippet(body, kws)}]


def _collect_guidance(slug: str, kws: list[str], limit: int,
                      all_projects: bool = False) -> tuple[list[dict], int, int]:
    """Core of guidance search — returns (top_hits, total_unique, truncated).

    Shared by `bsq guidance search` and T-0149 deterministic spawn assembly.
    """
    hits: list[dict] = []
    # 1. backlog Verbatim sections (stakeholder source-of-truth) + the
    #    close-hook harvest sections ("## Stakeholder comments", T-0151) —
    #    steering routed onto EXISTING tickets lands there, not in the
    #    verbatim section, and must stay findable (T-0590).
    for p in sorted(backlog_dir(slug).glob("T-*.md")):
        hits += _scan_md_section(p, kws, "Verbatim request")
        hits += _scan_md_section(p, kws, "Stakeholder comments")
    # 2. session bodies (close-hook-appended stakeholder notes; T-0151 area 4).
    sess_dir = Path(BOT_SQUAD) / "data" / slug / "sessions"
    if sess_dir.is_dir():
        for p in sorted(sess_dir.glob("*.md")):
            hits += _scan_md_section(p, kws, None)
    # 3. jsonl conversation logs (human-typed messages).
    dirs = _jsonl_search_dirs(slug, all_projects)
    candidates = _grep_candidate_jsonl(kws, dirs)
    truncated = 0
    if len(candidates) > _JSONL_PARSE_CAP:
        candidates.sort(key=lambda f: os.path.getmtime(f) if os.path.exists(f) else 0,
                        reverse=True)
        truncated = len(candidates) - _JSONL_PARSE_CAP
        candidates = candidates[:_JSONL_PARSE_CAP]
    for f in candidates:
        hits += _scan_jsonl(f, kws)

    # Dedupe identical snippets (jsonl retries/edits repeat verbatim).
    seen = set()
    uniq = []
    for h in hits:
        key = h["text"]
        if key in seen:
            continue
        seen.add(key)
        uniq.append(h)
    uniq.sort(key=lambda h: (h["score"], h.get("ts", "")), reverse=True)
    return uniq[:limit], len(uniq), truncated


def cmd_guidance_search(args) -> None:
    slug = resolve_slug()
    kws = [k.lower() for k in args.keywords if k.strip()]
    if not kws:
        die("guidance search needs at least one keyword")
    top, total, truncated = _collect_guidance(
        slug, kws, args.limit, getattr(args, "all_projects", False))

    if args.json:
        print(json.dumps({"query": kws, "hits": top, "truncated": truncated}))
        return
    if not top:
        print(f"(no prior stakeholder guidance found for: {' '.join(kws)})")
        return
    print(f"prior stakeholder guidance for [{' '.join(kws)}] — top {len(top)} "
          f"of {total} match(es):\n")
    for h in top:
        ts = (h.get("ts") or "")[:19] or "?"
        print(f"• [{h['source']} · {ts} · score {h['score']}]")
        print(f"  {h['text']}\n")
    if truncated:
        print(f"(note: {truncated} older jsonl file(s) beyond the {_JSONL_PARSE_CAP}-file "
              f"parse cap were skipped — narrow keywords to surface them)")


# --------------------------------------------------------------------------
# task search / similar (T-0486, Process Paradigm M4/F4.2) — surface backlog
# tickets similar to a free-text input or a seed ticket, so a task-ingest
# session can decide clarify-vs-create (append to an existing task vs mint a
# new one). The ranking lives in the pure ``task_search`` helper module (kept
# out of this co-edit hotspot + unit-testable); here we only read the backlog
# into Ticket records, call rank(), and render. Append-to-existing is the
# existing `bsq ticket note <id>`; create-new is `bsq task new` — the `dup`
# flag is the signal that says which branch the ingest session should take.
# --------------------------------------------------------------------------
# Max matched-tokens shown per candidate in the human render (JSON keeps all).
_MATCHED_SHOWN = 12


def _load_task_search():
    """Load the sibling ``task_search.py`` helper relative to this script
    (robust under the ~/.local/bin/bsq symlink — mirrors how the tests load
    bsq itself, no reliance on sys.path/cwd)."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    p = Path(__file__).resolve().parent / "task_search.py"
    if "bsq_task_search" in sys.modules:
        return sys.modules["bsq_task_search"]
    loader = SourceFileLoader("bsq_task_search", str(p))
    spec = importlib.util.spec_from_loader("bsq_task_search", loader)
    mod = importlib.util.module_from_spec(spec)
    # Register BEFORE exec: dataclass() under `from __future__ import annotations`
    # looks the module up in sys.modules to resolve string annotations.
    sys.modules["bsq_task_search"] = mod
    loader.exec_module(mod)
    return mod


def _load_backlog_tickets(slug: str) -> list:
    """Read every backlog ticket into ``task_search.Ticket`` records
    (id/title/status from frontmatter, body = md minus frontmatter)."""
    ts = _load_task_search()
    out = []
    for p in sorted(backlog_dir(slug).glob("T-*.md")):
        try:
            raw = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        fm = read_frontmatter(p)
        body = re.sub(r"\A---\n.*?\n---\n", "", raw, flags=re.DOTALL)
        tid = fm.get("id") or p.stem.split("-")[0] + "-" + p.stem.split("-")[1]
        out.append(ts.Ticket(
            id=str(tid).strip(),
            title=str(fm.get("title") or p.stem),
            body=body,
            status=str(fm.get("status") or ""),
        ))
    return out


def _render_candidates(slug: str, query: str, cands: list, as_json: bool) -> None:
    if as_json:
        print(json.dumps({
            "query": query,
            "candidates": [
                {"id": c.id, "title": c.title, "status": c.status,
                 "score": c.score, "matched": c.matched, "dup": c.dup}
                for c in cands
            ],
        }))
        return
    if not cands:
        print(f"(no similar backlog tasks for: {query!r} — looks like a NEW task)")
        return
    print(f"similar backlog tasks for [{query}] — top {len(cands)}:\n")
    for c in cands:
        flag = "  ⚠ likely duplicate" if c.dup else ""
        st = f" · {c.status}" if c.status else ""
        print(f"• {c.id}  (score {c.score}{st}){flag}")
        print(f"    {c.title}")
        # Cap the human-readable matched list: a ticket-seeded `similar --from
        # <id>` query carries the whole body, so an uncapped list dumps 80+
        # tokens of noise. JSON output (above) keeps the full set for machine
        # consumers; humans just need the gist of why it matched.
        shown = c.matched[:_MATCHED_SHOWN]
        more = len(c.matched) - len(shown)
        tail = f" (+{more} more)" if more > 0 else ""
        print(f"    matched: {', '.join(shown)}{tail}\n")
    if any(c.dup for c in cands):
        print("⚠ likely-duplicate hit(s) above — consider CLARIFYING the existing "
              "task (`bsq ticket note <id> ...`) instead of creating a new one.")


def cmd_task_search(args) -> None:
    slug = resolve_slug()
    query = " ".join(args.query).strip()
    if not query:
        die("task search needs a query, e.g. `bsq task search deploy precheck dirty`")
    ts = _load_task_search()
    cands = ts.rank(query, _load_backlog_tickets(slug), limit=args.limit)
    _render_candidates(slug, query, cands, args.json)


def cmd_task_similar(args) -> None:
    slug = resolve_slug()
    seed = (args.from_ or "").strip()
    if not seed:
        die("task similar needs --from <id-or-text>")
    ts = _load_task_search()
    tickets = _load_backlog_tickets(slug)
    exclude_id = None
    query = seed
    # If --from looks like a ticket id and resolves, seed from its title+body
    # (and exclude it from its own results).
    if re.fullmatch(r"[Tt]-\d+", seed):
        tid = seed.upper()
        match = next((t for t in tickets if t.id == tid), None)
        if match is None:
            die(f"task similar: ticket {tid} not found (use free text with --from "
                f"to search by description instead)")
        exclude_id = tid
        query = f"{match.title} {match.body}"
        label = f"{tid} ({match.title})"
    else:
        label = repr(seed)
    cands = ts.rank(query, tickets, exclude_id=exclude_id, limit=args.limit)
    _render_candidates(slug, label, cands, args.json)


# --------------------------------------------------------------------------
# cluster-launch (T-0487, Process Paradigm M4 / F4.3) — "I see this problem,
# find other similar problems in the same area, launch a session that fixes all
# of them" (voice-01). A THIN orchestration verb over two existing primitives:
#   1. B's similarity ranker (task_search.rank, T-0486) → the similar set
#   2. `bsq spawn --bundle` (T-0160) → ONE dev bound to the whole set
# No new ranking, no worker action (so it rides no deploy/worker-restart — the
# verb is instantly live via the bsq symlink). The only added logic is below:
# normalize the seed id + pick the default cluster, then an operator-confirm
# gate before launch. The cluster is a SUGGESTION the operator ratifies/prunes,
# never an auto-launch (M4 [OPEN] decision: session-driven, NOT a classifier).
# --------------------------------------------------------------------------
def _norm_task_id(tid: str) -> str:
    """Normalize a task id for matching/globbing. The .md-vs-stem ambiguity
    (recurring bot-squad bug class) bites here because ``find_ticket`` globs
    ``<id>-*.md`` — a passed-in ``T-0487.md`` would glob ``T-0487.md-*.md`` and
    miss. Strip a trailing ``.md`` and uppercase the ``T-`` prefix; leave the
    zero-padding intact (ids are ``T-NNNN``)."""
    tid = tid.strip()
    if tid.lower().endswith(".md"):
        tid = tid[:-3].strip()
    if tid[:2].lower() == "t-":
        tid = "T-" + tid[2:]
    return tid


def _filter_cluster(candidates, *, min_score=1, limit=5, include_closed=False):
    """From ranked ``task_search.Candidate`` records (already similarity-sorted),
    pick the DEFAULT cluster to bundle with the seed. Drops CLOSED tasks (you
    bundle fixable problems, not done ones) unless ``include_closed``, keeps
    ``score >= min_score``, caps at ``limit``. Preserves the input similarity
    order (never re-sorts). Returns the kept Candidate list."""
    out = []
    for c in candidates:
        if c.score < min_score:
            continue
        if not include_closed and (c.status or "").strip().lower() == "closed":
            continue
        out.append(c)
        if len(out) >= max(0, limit):
            break
    return out


def cmd_cluster_launch(args) -> None:
    slug = resolve_slug()
    seed = _norm_task_id(args.seed)
    if not re.fullmatch(r"T-\d+", seed):
        die("cluster-launch needs a seed TICKET id, e.g. `bsq cluster-launch T-0487`")
    find_ticket(slug, seed)  # existence check (dies w/ a clear msg if absent)

    ts = _load_task_search()
    tickets = _load_backlog_tickets(slug)
    seed_t = next((t for t in tickets if t.id == seed), None)
    if seed_t is None:
        die(f"cluster-launch: seed {seed} has no readable backlog md")

    # Reuse B's ranker with the SAME seed as `bsq task similar` (title+body),
    # over a generous candidate window; our selection then narrows it.
    query = f"{seed_t.title} {seed_t.body}"
    ranked = ts.rank(query, tickets, exclude_id=seed, limit=max(args.limit * 4, 40))
    by_id = {c.id: c for c in ranked}

    if args.pick:
        # Operator-curated cluster: take exactly these ids (each validated to
        # exist). A picked id that the ranker also surfaced keeps its score; a
        # picked id outside the similar set is still allowed (operator knows a
        # related task the lightweight ranker missed) — shown with score 0.
        cluster = []
        for raw in args.pick.split(","):
            pid = _norm_task_id(raw)
            if not pid or pid == seed:
                continue
            find_ticket(slug, pid)  # dies if a picked id doesn't exist
            c = by_id.get(pid)
            if c is None:
                pt = next((t for t in tickets if t.id == pid), None)
                c = ts.Candidate(id=pid, title=(pt.title if pt else pid),
                                 status=(pt.status if pt else ""),
                                 score=0, matched=[], dup=False)
            if pid not in {x.id for x in cluster}:
                cluster.append(c)
    else:
        cluster = _filter_cluster(
            ranked, min_score=args.min_score, limit=args.limit,
            include_closed=args.include_closed)

    # --- present the proposed cluster (seed -> cluster) ---
    print(f"Seed: {seed}  {seed_t.title}")
    if not cluster:
        print("\n(no similar OPEN tasks found in the same area — nothing to bundle."
              f"\n launch the seed alone with `bsq spawn {seed}`, or widen with"
              " `--include-closed` / lower `--min-score`.)")
        return
    print(f"\nProposed cluster — ONE session would be bound to these "
          f"{len(cluster) + 1} tasks (seed + {len(cluster)} similar):\n")
    print(f"  • {seed}   {seed_t.title}   [SEED]")
    for c in cluster:
        sc = f" score {c.score}" if c.score else ""
        st = f" · {c.status}" if c.status else ""
        meta = f"  ({sc.strip()}{st})" if (sc or st) else ""
        mt = f"\n      matched: {', '.join(c.matched[:8])}" if c.matched else ""
        print(f"  • {c.id}{meta}  {c.title}{mt}")

    bundle_ids = [seed] + [c.id for c in cluster]

    if args.dry_run:
        print("\n(dry-run — not launching. Re-run without --dry-run to launch.)")
        return

    # --- operator-confirm gate (cluster -> single bundled session) ---
    if not args.yes:
        if sys.stdin.isatty():
            try:
                resp = input(
                    f"\nLaunch ONE bundled session on these {len(bundle_ids)} "
                    f"tasks? [y/N] ").strip().lower()
            except EOFError:
                resp = ""
            if resp not in ("y", "yes"):
                print("aborted — no session launched.")
                return
        else:
            # Fail CLOSED on a non-TTY: never launch a session unratified.
            print(f"\nOperator confirmation required. Re-run with --yes to launch "
                  f"ONE session bound to: {', '.join(bundle_ids)}")
            return

    # --- launch via the existing spawn --bundle path (reuse, do NOT rebuild) ---
    spawn_args = argparse.Namespace(
        ticket=seed,
        bundle=",".join(bundle_ids),
        window=args.window,
        initiative=args.initiative,
        owner=args.owner,
        role=args.role,
        prompt=None,
        prompt_file=None,
        fresh=args.fresh,
        resume_sid=None,
        dry_run=args.spawn_dry_run,
    )
    print(f"\nLaunching ONE session bound to {len(bundle_ids)} tasks: "
          f"{', '.join(bundle_ids)}")
    cmd_spawn(spawn_args)


# --------------------------------------------------------------------------
# ticket verbs (T-0152) — make bot-squad-ticket-bound work feel native so
# sessions stop wandering into ~/.claude/superpowers/* docs to track work.
# --------------------------------------------------------------------------
# Canonical backlog statuses. Source of truth: api/app/routes_backlog.py
# ::_VALID_STATUSES (enforced on every PATCH). Mirrored here so `bsq ticket
# update` can validate offline without an API round-trip. Keep in sync.
TICKET_STATUSES = ("planned", "open", "in_progress", "totest", "reopened", "closed")


def _write_atomic(path: Path, content: str) -> None:
    tmp = path.parent / (path.name + ".tmp")
    tmp.write_text(content, encoding="utf-8")
    os.rename(tmp, path)


