def cmd_topic_bind(args) -> None:
    """Bind a Telegram (chat_id, thread_id) to a project (T-0639).

    The runtime, configurable surface the stakeholder explicitly asked for
    ("не HardCotion, настраиваемо через чат ID") — a topic->project binding
    is set here, at runtime, never hardcoded. A project may have MULTIPLE
    bound (chat_id, thread_id) entries; rebinding one rewrites it.

    T-0771: --ticket/--session write the per-task-topic fields (the ones
    `topic create` sets), and --clear-ticket/--clear-session empty them. A
    rebind that would implicitly DROP a ticket_id/session_id the key already
    carries is refused by the worker, naming the fields — so restoring or
    changing one field of a task topic no longer strips the rest.
    """
    thread_id = None if args.thread_id in (None, "", "none", "None") else args.thread_id
    params = {"chat_id": args.chat_id, "thread_id": thread_id, "slug": args.slug}
    if args.ticket:
        # T-0892: this verb never guessed the project — the slug is positional
        # — but `--ticket` rode through unchecked, so a topic could be hung off
        # an id this board does not have (and, with 54% of ids shared between
        # boards, off the same-numbered ticket of a different project). The
        # shared resolver checks it against the slug that was named here.
        _bind_slug, ticket_id, _p = resolve_ticket_ref(
            args.ticket, args.slug, verb="topic bind")
        params["ticket_id"] = ticket_id
    if args.session:
        params["session_id"] = args.session
    if args.clear_ticket:
        params["clear_ticket_id"] = True
    if args.clear_session:
        params["clear_session_id"] = True
    res = post("tg_topic_bind", params)
    b = res.get("binding", {})
    print(f"bound chat_id={args.chat_id} thread_id={thread_id} -> slug={b.get('slug')}")

    # Say what MOVED, not just what is stored: the T-0771 failure was that a
    # lossy write and a faithful one printed the same line.
    changes = res.get("changes") or {}
    for field, move in changes.items():
        before = move.get("from")
        after = move.get("to")
        print(f"  {field}: {before if before is not None else '(none)'} -> "
              f"{after if after is not None else '(cleared)'}")
    if not changes:
        print("  (no fields changed)")
    for field in res.get("cleared") or []:
        if field not in changes:
            print(f"  {field}: already empty, nothing to clear")
    pin = b.get("pinned_message_id")
    if pin and "session_id" in changes:
        print(f"  note: topic still carries the pinned direct-mode marker "
              f"message_id={pin} — `/pin-session off` in the topic unpins it")


