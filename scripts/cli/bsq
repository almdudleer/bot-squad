    # scenario (T-0158: manual-testing-first discipline)
    sc = sub.add_parser("scenario", help="manual test scenario templates (T-0158)")
    sc_sub = sc.add_subparsers(dest="sub", required=True)
    scn = sc_sub.add_parser("new", help="write a scenario template for a ticket")
    scn.add_argument("ticket", help="ticket id, e.g. T-0149")
    scn.add_argument("--force", action="store_true", help="overwrite an existing scenario file")
    scn.set_defaults(func=cmd_scenario_new)

    # feedback (T-0154: friction-submission channel for in-project agents)
    fb = sub.add_parser("feedback", help="submit process/product friction upstream (T-0154)")
    fb_sub = fb.add_subparsers(dest="sub", required=True)
    fbs = fb_sub.add_parser("submit", help="append a friction note to the project feedback queue")
    fbs.add_argument("message", nargs="+", help="what bit you + what would help")
    fbs.add_argument("--usecase", help="attach this feedback to a use case id (T-0159)")
    fbs.add_argument("--sid", help="override this session's SID")
    fbs.set_defaults(func=cmd_feedback_submit)

    # usecase (T-0159: use cases / user flows as first-class storage + tooling)
    uc = sub.add_parser("usecase", help="use cases / user flows: new / list / run (T-0159)")
    uc_sub = uc.add_subparsers(dest="sub", required=True)
    ucn = uc_sub.add_parser("new", help="scaffold a use-case md")
    ucn.add_argument("id", help="use-case id, e.g. UC-operator-dispatch-loop")
    ucn.add_argument("--title", help="human title (default: the id)")
    ucn.add_argument("--force", action="store_true", help="overwrite an existing use case")
    ucn.set_defaults(func=cmd_usecase_new)
    ucl = uc_sub.add_parser("list", help="list this project's use cases")
    ucl.add_argument("--json", action="store_true", help="raw JSON output")
    ucl.set_defaults(func=cmd_usecase_list)
    ucr = uc_sub.add_parser("run", help="spawn a testing-dev session to walk a use case")
    ucr.add_argument("id", help="use-case id to run")
    ucr.add_argument("--window", help="tmux window name (default: uctest-<id>)")
    ucr.add_argument("--owner", help="UI username to stamp on the session")
    ucr.add_argument("--report-to", dest="report_to", help="SID to report PASS/FAIL to (default: this session)")
    ucr.add_argument("--dry-run", action="store_true", help="print the testing brief without spawning")
    ucr.set_defaults(func=cmd_usecase_run)

    # ----------------------------------------------------------------------
    # entity creation verbs (T-0174): atomic, collision-free ids for every
    # entity type. `<noun> new` always allocates — no hand-picked ids.
    # ----------------------------------------------------------------------
    # task new — canonical atomic backlog-ticket creation (wraps task_new).
    tn = sub.add_parser("task", help="backlog tickets: new (atomic id, T-0174)")
    tn_sub = tn.add_subparsers(dest="sub", required=True)
    tnn = tn_sub.add_parser("new", help="allocate the next T-NNNN + write a stub ticket")
    tnn.add_argument("title", help="single-line ticket title")
    tnn.add_argument(
        "--provenance", "--source", dest="provenance", required=True,
        help="REQUIRED ticket source (next-wave #14): "
             "corpus:<token> | F-NNNN | T-NNNN | stakeholder:YYYY-MM-DD (comma-separated)",
    )
    tnn.add_argument("--initiative", help="initiative basename, e.g. operator-ux-and-session-mgmt.md")
    tnn.add_argument("--priority", help="priority value (frontmatter, verbatim)")
    tnn.add_argument("--owner", help="owner role/name (frontmatter)")
    tnn.add_argument(
        "--force", action="store_true",
        help="bypass the dedupe-vs-create similarity gate (T-0577) — mint even "
             "if this looks like a near-duplicate of an existing backlog task",
    )
    tnn.add_argument(
        "--verbatim",
        help="widen the dedupe-gate query with the caller's own words (T-0577) "
             "— signal only, never stored on the ticket body",
    )
    tnn.set_defaults(func=cmd_task_new)
    # task search / similar (T-0486) — dedupe / clarify-vs-create tooling.
    tns = tn_sub.add_parser(
        "search",
        help="surface backlog tasks similar to a free-text query (dedupe / clarify-vs-create)")
    tns.add_argument("query", nargs="+", help="free-text query, e.g. deploy precheck dirty")
    tns.add_argument("--limit", type=int, default=10, help="max candidates (default 10)")
    tns.add_argument("--json", action="store_true", help="raw JSON output (for ingest sessions)")
    tns.set_defaults(func=cmd_task_search)
    tnsi = tn_sub.add_parser(
        "similar",
        help="rank tasks similar to a seed ticket id or free text (--from)")
    tnsi.add_argument("--from", dest="from_", required=True,
                      help="seed: a ticket id (e.g. T-0225, excluded from results) or free text")
    tnsi.add_argument("--limit", type=int, default=10, help="max candidates (default 10)")
    tnsi.add_argument("--json", action="store_true", help="raw JSON output (for ingest sessions)")
    tnsi.set_defaults(func=cmd_task_similar)
    # task digest (T-0589) — short backlog digest for the TG conversation:
    # the attendant runs this on a "что по задачам" ask and pastes the text
    # into its thread reply.
    tnd = tn_sub.add_parser(
        "digest",
        help="short backlog digest (counts + P1/P2 headlines) for the TG chat")
    tnd.add_argument("--json", action="store_true", help="raw JSON output ({text, counts})")
    tnd.set_defaults(func=cmd_task_digest)

    # docs (T-0172 docs system): new / list / link / sync. `doc` + `docs` both work.
    dn = sub.add_parser("doc", aliases=["docs"], help="project docs (T-0172): new / list / link / sync")
    dn_sub = dn.add_subparsers(dest="sub", required=True)
    dnn = dn_sub.add_parser("new", help="allocate the next D-NNNN + write a stub doc")
    dnn.add_argument("category", help="doc category, e.g. architecture/design/support/runbook/product")
    dnn.add_argument("title", help="single-line doc title")
    dnn.set_defaults(func=cmd_doc_new)
    dnl = dn_sub.add_parser("list", help="list this project's docs (optionally by category)")
    dnl.add_argument("--category", help="filter to a single category")
    dnl.add_argument("--json", action="store_true", help="raw JSON output")
    dnl.set_defaults(func=cmd_doc_list)
    dnk = dn_sub.add_parser("link", help="bidirectionally link a doc <-> ticket")
    dnk.add_argument("doc_id", help="doc id, e.g. D-0001")
    dnk.add_argument("ticket", help="ticket id, e.g. T-0123")
    dnk.add_argument("--unlink", action="store_true", help="remove the link instead of adding it")
    dnk.set_defaults(func=cmd_doc_link)
    dns = dn_sub.add_parser("sync", help="symlink docs/ into the dev + master clones")
    dns.set_defaults(func=cmd_doc_sync)

    # uc new (atomic numeric UC ids; composes T-0159/T-0173)
    ucx = sub.add_parser("uc", help="use cases: new (atomic UC-NNNN id) / list / run (T-0174)")
    ucx_sub = ucx.add_subparsers(dest="sub", required=True)
    ucxn = ucx_sub.add_parser("new", help="allocate the next UC-NNNN + write a stub use case")
    ucxn.add_argument("title", help="single-line use-case title")
    ucxn.set_defaults(func=cmd_uc_new)
    ucxl = ucx_sub.add_parser("list", help="list this project's use cases")
    ucxl.add_argument("--json", action="store_true", help="raw JSON output")
    ucxl.set_defaults(func=cmd_usecase_list)
    ucxr = ucx_sub.add_parser("run", help="spawn a testing-dev session to walk a use case")
    ucxr.add_argument("id", help="use-case id to run")
    ucxr.add_argument("--window", help="tmux window name (default: uctest-<id>)")
    ucxr.add_argument("--owner", help="UI username to stamp on the session")
    ucxr.add_argument("--report-to", dest="report_to", help="SID to report PASS/FAIL to (default: this session)")
    ucxr.add_argument("--dry-run", action="store_true", help="print the testing brief without spawning")
    ucxr.set_defaults(func=cmd_usecase_run)

    # flow new (composes T-0173 user flows)
    fl = sub.add_parser("flow", help="user flows attached to a use case: new (atomic id, composes T-0173)")
    fl_sub = fl.add_subparsers(dest="sub", required=True)
    fln = fl_sub.add_parser("new", help="allocate the next UF-NNNN + write a stub flow under a UC")
    fln.add_argument("uc_id", help="parent use-case id, e.g. UC-0001")
    fln.add_argument("title", help="single-line flow title")
    fln.set_defaults(func=cmd_flow_new)

    # initiative new — an initiative IS a task now (T-0480): mints a
    # kind:initiative backlog task with an atomic T-NNNN id, not an INI-NN.
    ini = sub.add_parser("initiative", help="initiatives: new (kind:initiative task, atomic T-id, T-0480)")
    ini_sub = ini.add_subparsers(dest="sub", required=True)
    inin = ini_sub.add_parser("new", help="allocate the next T-NNNN + write a stub kind:initiative task")
    inin.add_argument("name", help="initiative name")
    inin.add_argument("--persistent", action="store_true",
                       help="T-0354: standing responsibility, never auto-closed "
                            "(sets initiative_kind: persistent; default is one-shot)")
    inin.set_defaults(func=cmd_initiative_new)

    # autopilot (T-0153: prompt-driven, time-boxed autonomous runs)
    ap = sub.add_parser("autopilot", help="prompt-driven, time-boxed autonomous runs (T-0153)")
    ap_sub = ap.add_subparsers(dest="sub", required=True)
    aps = ap_sub.add_parser("start", help="start an autopilot run for a team/session/project")
    aps.add_argument("kind", choices=["team", "session", "project"], help="target level")
    aps.add_argument("prompt", help="the autopilot task prompt the TL will drive")
    aps.add_argument("--ref", help="team name or session SID (omit for project-level)")
    aps.add_argument("--early-exit", dest="early_exit", help="early-exit condition (TL-evaluated)")
    aps.add_argument("--hours", type=float, help="duration in hours (default 8)")
    aps.add_argument("--stall", type=int, help="stall threshold in minutes (default 60)")
    aps.add_argument("--watchdog", type=int, help="watchdog cadence in minutes (default 5)")
    aps.set_defaults(func=cmd_autopilot_start)
    apx = ap_sub.add_parser("stop", help="end an autopilot early (TL early-exit, or operator cancel)")
    apx.add_argument("--key", help="autopilot key (default: the run targeting this session)")
    apx.add_argument("--reason", help="early-exit reason (set ⟹ exited; omit ⟹ stopped)")
    apx.add_argument("--sid", help="override this session's SID (target match)")
    apx.set_defaults(func=cmd_autopilot_stop)
    apl = ap_sub.add_parser("status", help="list autopilot runs for this project")
    apl.add_argument("--json", action="store_true", help="raw JSON output")
    apl.set_defaults(func=cmd_autopilot_status)

    # brief
    br = sub.add_parser("brief",
                        help="print full orientation on demand (product + protocol + role + bindings) — T-0203")
    br.set_defaults(func=cmd_brief)

    # compact
    cp = sub.add_parser("compact", help="send /compact to a session (self by default)")
    cp.add_argument("--sid", help="target SID (default: this session)")
    cp.set_defaults(func=cmd_compact)

    # compact-save (T-0467) — write this session's forward-state to its role artifact
    cs = sub.add_parser(
        "compact-save",
        help="write your full forward-state to your role artifact (compact handoff)")
    cs.add_argument("content", help="your complete forward-state markdown")
    cs.add_argument("--sid", help="session SID (default: derived from tmux)")
    cs.set_defaults(func=cmd_compact_save)

    # routine (T-0464/T-0604) — declare / list / mute Routines
    rt = sub.add_parser(
        "routine",
        help="routines: declare / list / mute (a rule + trigger that spawns a session)")
    rt_sub = rt.add_subparsers(dest="sub", required=True)
    rtd = rt_sub.add_parser(
        "declare",
        help="declare a routine: an instruction + a trigger (cron schedule, or a "
             "code-level metric monitor that attaches AI on threshold breach)")
    rtd.add_argument("instruction", help="what the spawned session should do")
    rtd.add_argument("--trigger", default="schedule",
                     choices=["schedule", "monitor"],
                     help="trigger type (default: schedule)")
    rtd.add_argument("--schedule",
                     help="[schedule] 5-field cron expr in UTC, e.g. '0 9 * * *' "
                          "(daily 09:00) or '*/15 * * * *' (every 15 min)")
    rtd.add_argument("--probe", choices=["shell", "http"],
                     help="[monitor] probe kind (default: shell)")
    rtd.add_argument("--cmd",
                     help="[monitor shell] probe command; stdout is the metric")
    rtd.add_argument("--url",
                     help="[monitor http] endpoint to GET (judges itself via "
                          "--expect-status/--latency-budget-ms)")
    rtd.add_argument("--expect-status", dest="expect_status", type=int,
                     help="[monitor http] expected HTTP status (default: 200)")
    rtd.add_argument("--latency-budget-ms", dest="latency_budget_ms", type=int,
                     help="[monitor http] max acceptable latency, ms")
    rtd.add_argument("--interval",
                     help="[monitor] probe cadence, e.g. 30s / 5m (default: 30s)")
    rtd.add_argument("--timeout",
                     help="[monitor] probe hard-kill timeout, e.g. 20s (mandatory)")
    rtd.add_argument("--judge",
                     choices=["numeric_gt", "numeric_lt", "numeric_ne",
                              "nonzero_exit", "regex_match"],
                     help="[monitor shell] breach test over probe output")
    rtd.add_argument("--threshold",
                     help="[monitor shell] judge threshold: a number, or the "
                          "regex for regex_match")
    rtd.add_argument("--persist",
                     help="[monitor] breach must HOLD this long before the first "
                          "fire (anti-flap), e.g. 60s; aim for >= 2x interval")
    rtd.add_argument("--cooldown",
                     help="[monitor] min gap between fires of one ongoing breach, "
                          "e.g. 30m")
    rtd.add_argument("--on-breach", dest="on_breach", choices=["spawn", "notify"],
                     help="[monitor] spawn = attach AI (default); notify = "
                          "code-only alert, no AI")
    rtd.add_argument("--on-recover", dest="on_recover", choices=["notify"],
                     help="[monitor] send a recovery message when the metric "
                          "returns within threshold (only if the breach fired)")
    rtd.add_argument("--title", help="short title (default: first line of instruction)")
    rtd.add_argument("--provenance", "--source", dest="provenance",
                     help="cite the source (stakeholder:DATE / feedback id / ...)")
    rtd.set_defaults(func=cmd_routine_declare)
    rtl = rt_sub.add_parser(
        "list",
        help="list declared routines (monitors: last value, breach, last fire, mute)")
    rtl.set_defaults(func=cmd_routine_list)
    rtm = rt_sub.add_parser(
        "mute",
        help="mute a monitor routine: probes continue, fires suppressed "
             "(duration 0 = unmute)")
    rtm.add_argument("rid", help="routine id, e.g. R-0007")
    rtm.add_argument("duration", help="mute duration, e.g. 45m / 2h / 1d (0 = unmute)")
    rtm.add_argument("reason", nargs="?",
                     help="why the breach is silenced (required unless unmuting)")
    rtm.set_defaults(func=cmd_routine_mute)

    # assignment-write-result (T-0463/T-0464) — write your result to your artifact
    awr = sub.add_parser(
        "assignment-write-result",
        help="write your session's RESULT into your assignment artifact "
             "(task or --kind routine)")
    awr.add_argument("content", help="your result markdown")
    awr.add_argument("--id", required=True, dest="id",
                     help="assignment id (T-NNNN task or R-NNNN routine)")
    awr.add_argument("--kind", choices=["task", "routine"], default="task",
                     help="assignment kind (default: task)")
    awr.add_argument("--sid", help="session SID (default: derived from tmux)")
    awr.set_defaults(func=cmd_assignment_write_result)

    # postpone (T-0466) — defer this session's next ~1h cache-window recycle
    pp = sub.add_parser(
        "postpone",
        help="defer your ~1h cache-window recycle one window (repeatable); "
             "--for <secs> for a bounded wait (e.g. a long build)")
    pp.add_argument("--for", dest="seconds", type=int,
                    help="deferral length in seconds (default: one idle window)")
    pp.add_argument("--reason", help="why you're postponing (optional note)")
    pp.add_argument("--sid", help="session SID (default: derived from tmux)")
    pp.set_defaults(func=cmd_postpone)

    # morph (T-0509, M11/F11.2) — morph THIS user session's role in place
    mo = sub.add_parser(
        "morph",
        help="morph THIS user session's role in place: --role dev (take a "
             "task) | tl (spawn teammates) | operator (iff none running)")
    mo.add_argument("--role", required=True,
                    help="target role: dev | tl | operator")
    mo.add_argument("--task", help="task id to take on (for --role dev)")
    mo.add_argument("--initiative", help="initiative to bind (for --role tl/dev)")
    mo.add_argument("--sid", help="session SID (default: derived from tmux)")
    mo.set_defaults(func=cmd_morph)

    # write (T-0508, M11/F11.1 AP#2) — attach-and-write to ANY session
    wr = sub.add_parser(
        "write",
        help="attach-and-write to any session: inject TEXT into SID's composer "
             "(most often the operator dropping a line into a running session)")
    wr.add_argument("sid", help="target session SID to write into")
    wr.add_argument("text", help="text to inject into the target composer")
    wr.set_defaults(func=cmd_write)

    # send-input (T-0469, M1/F1.6) — multiplexed, queue-backed input channel
    si = sub.add_parser(
        "send-input",
        help="multiplexed write to a session: QUEUE the input (never rejected), "
             "coalesce concurrent writes into one captioned batch, and defer "
             "while the user is live-typing — agents use this, not raw send-keys")
    si.add_argument("sid", help="target session SID to send input to")
    si.add_argument("text", help="text to enqueue for the target's composer")
    si.add_argument("--author", default=None,
                    help="caption for who wrote this (default: this session's SID)")
    si.set_defaults(func=cmd_send_input)

    # user-session (T-0508, M11/F11.1 AP#3) — launch/reuse a dedicated user session
    us = sub.add_parser(
        "user-session",
        help="launch (or reuse) a dedicated user-conversation session for a "
             "global user; idempotent per (slug,global_user_id) — no fan-out")
    us.add_argument("slug", nargs="?", default=None,
                    help="project slug (default: derived from cwd)")
    us.add_argument("global_user_id", help="global user id (gu_...)")
    us.add_argument("--message",
                    help="inbound message reference/snippet for the boot prompt")
    us.set_defaults(func=cmd_user_session)

    # operator-state (T-0473) — read the operator's future-focused state-doc
    os_ = sub.add_parser(
        "operator-state",
        help="read the operator's state-doc (transparency); --template prints the scaffold")
    os_.add_argument("--template", action="store_true",
                     help="print the fillable schema scaffold instead of the current doc")
    os_.set_defaults(func=cmd_operator_state)

    # operator (T-0522) — user-facing toggle for the operator re-drive (T-0474):
    # pause / resume / status (paused-vs-driving).
    op = sub.add_parser(
        "operator",
        help="operator re-drive control: pause / resume / status (T-0474 toggle)")
    op_sub = op.add_subparsers(dest="sub", required=True)
    opp = op_sub.add_parser("pause", help="stop re-driving the operator until resumed")
    opp.add_argument("--reason", help="why you're pausing (recorded on the flag)")
    opp.set_defaults(func=cmd_operator_pause)
    opr = op_sub.add_parser("resume", help="resume the operator re-drive")
    opr.set_defaults(func=cmd_operator_resume)
    ops = op_sub.add_parser("status", help="show whether re-drive is paused vs driving")
    ops.set_defaults(func=cmd_operator_status)

    # edit-begin (T-0215) — snapshot a baseline for a later `commit --hunks`
    eb = sub.add_parser(
        "edit-begin",
        help="snapshot files' baseline BEFORE editing, for a later `commit --hunks`")
    eb.add_argument("--sid", help="session SID (default: derived from tmux)")
    eb.add_argument("files", nargs="+", help="files to baseline before editing")
    eb.set_defaults(func=cmd_edit_begin)

    # commit
    # T-0482: user-controlled execution pace (Process Paradigm M3 / F3.4).
    pace = sub.add_parser(
        "pace",
        help="user-controlled execution pace: show / set / initiative / pause / resume")
    pace_sub = pace.add_subparsers(dest="sub", required=True)
    pcs = pace_sub.add_parser("show", help="print this project's pace-control config")
    pcs.set_defaults(func=cmd_pace_show)
    pcset = pace_sub.add_parser("set", help="set the global max-in-progress ceiling (0=unlimited)")
    pcset.add_argument("--max-in-progress", type=int, default=None,
                       help="max tasks kept in the in_progress board state (0 = unlimited)")
    pcset.set_defaults(func=cmd_pace_set)
    pci = pace_sub.add_parser("initiative", help="steer one initiative's weight / priority / pause")
    pci.add_argument("name", help="initiative basename (e.g. process-paradigm or process-paradigm.md)")
    pci.add_argument("--weight", type=float, default=None, help="relative drain weight (default 1.0)")
    pci.add_argument("--priority", type=int, default=None, help="order rank, higher = sooner (default 0)")
    pci.add_argument("--pause", action="store_true", help="pause just this initiative's tasks")
    pci.add_argument("--resume", action="store_true", help="resume this initiative's tasks")
    pci.set_defaults(func=cmd_pace_initiative)
    pcc = pace_sub.add_parser("clear", help="drop one initiative's pace entry (revert to defaults)")
    pcc.add_argument("name", help="initiative basename")
    pcc.set_defaults(func=cmd_pace_clear)
    pcp = pace_sub.add_parser("pause", help="GLOBAL pause — stop the operator re-drive starting new work")
    pcp.add_argument("--reason", default="", help="optional note recorded with the pause")
    pcp.add_argument("--sid", help="attributing SID (default: derived from tmux)")
    pcp.set_defaults(func=cmd_pace_pause)
    pcr = pace_sub.add_parser("resume", help="clear the GLOBAL operator pause")
    pcr.set_defaults(func=cmd_pace_resume)

    cm = sub.add_parser("commit", help="stage explicit paths + safe-commit")
    cm.add_argument("-m", "--message", required=True, help="commit message")
    cm.add_argument("--ack", action="store_true",
                    help="acknowledge the peer-activity report (BOT_SQUAD_ACK_PEERS=1)")
    cm.add_argument(
        "--hunks", action="store_true",
        help="T-0215: commit ONLY this session's hunks (the diff since "
             "`bsq edit-begin`) in <files>, isolating a peer's edits in the same file")
    cm.add_argument("--sid", help="session SID for --hunks (default: derived from tmux)")
    cm.add_argument("files", nargs="*", help="explicit file paths to stage + commit")
    cm.set_defaults(func=cmd_commit)

    return p


def main(argv: list[str]) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main(sys.argv[1:])
