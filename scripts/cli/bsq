   Don't spam it. If you forget and stay blocked on him with your tmux window
   unwatched for ~15+ min, the worker auto-escalates for you — but the explicit
   ping is faster and clearer. Route routine questions to your TL via
   `bsq peer send` first.
7. REPORT FRICTION UPSTREAM (T-0154). When the process itself fights you —
   you hit the SAME workaround twice, the ticket scope conflicts with reality,
   a tool/recipe is broken or missing, or guidance is contradictory — submit it:
   `bsq feedback submit '<what bit you + what would help>'`. It lands in the
   project feedback queue for the operator to triage; don't silently absorb it.
   This is how the process improves. (Tag a use case with `--usecase <id>`.)

Run `bsq --help` for the full verb reference."""


def _role_from_sid(sid: str | None) -> str:
    """Mirror of scripts/hooks/derive_role.sh / sessions._derive_role: map a
    session's window name → role enum. Window is the SID's middle segment
    (S-<user>-<window>-p<pane>)."""
    if not sid:
        return "dev"
    m = re.match(r"^S-[^-]+-(.*)-p\d+$", sid)
    window = (m.group(1) if m else sid).lower()
    if window == "operator" or re.search(r"[-_]operator$", window):
        return "operator"
    # T-0478: system-spawned user-conversation intake session. Its window is
    # `<gu_id>-user-conversation`, so match the suffix (gid prefix is ignored).
    if window == "user-conversation" or re.search(r"[-_]user[-_]conversation$", window):
        return "user-conversation"
    if window in ("tl", "teamlead") or re.search(r"[-_](tl|teamlead)$", window):
        return "teamlead"
    return "dev"


def _fm_list(raw) -> list[str]:
    """Parse an inline-list frontmatter value ('[a, b]') from read_frontmatter
    into clean ids — read_frontmatter returns lists as raw strings."""
    if isinstance(raw, list):
        items = raw
    else:
        s = (raw or "").strip()
        if s.startswith("[") and s.endswith("]"):
            s = s[1:-1]
        items = s.split(",")
    return [x.strip() for x in items if x and x.strip() not in ("", "~")]


