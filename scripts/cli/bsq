#!/usr/bin/env python3
"""bsq — slim bot-squad CLI for agents (T-0146).

One binary, kubectl-style verbs, that wrap the bot-squad worker-socket
actions so agents stop hand-rolling curl + tmux send-keys. `bsq --help`
is the canonical reference — AGENT_INSTRUCTIONS.md points here.

Verbs:
  bsq inbox check [--since TS]      drain this session's peer inbox
  bsq inbox wait  [--timeout N]     opt-in long-poll (the bg-watcher mode)
  bsq peer send <to> <text>         peer_send + nudge the recipient pane
  bsq tg ping <message>             explicitly DM the stakeholder (T-0155)
  bsq spawn <ticket> [--bundle ids] spawn a dev session for a backlog ticket
  bsq team status                   list this project's sessions
  bsq team list                     list persisted Team rosters (T-0142)
  bsq team archive <sid>            true-archive a session (suspend + archive)
  bsq team resurrect <sid>          bring a session back (unarchive + resume)
  bsq team rename <sid> <name>      rename a session (tmux + UI + registry sync)
  bsq compact [--sid SID]           send /compact to a session (self by default)
  bsq commit -m MSG <files..>       stage explicit paths + safe-commit

Conventions shared with the other ops shims:
  - $BOT_SQUAD       install root (default /home/www/bot-squad)
  - $WORKER_SOCK     worker unix socket
  - slug is resolved from $PWD against config/projects.toml
  - this session's SID is read from tmux (override with --sid / --from)
"""
from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path


def _utc_now() -> str:
    """ISO-8601 UTC timestamp (``...Z``), matching the worker's note format."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

BOT_SQUAD = os.environ.get("BOT_SQUAD", "/home/www/bot-squad")
WORKER_SOCK = os.environ.get("WORKER_SOCK", f"{BOT_SQUAD}/data/_sock/worker.sock")
PROJECTS_TOML = f"{BOT_SQUAD}/config/projects.toml"

# The "check mail" payload bsq injects into a recipient pane. Seeing this
# in its composer is an agent's cue to run `bsq inbox check`. This is the
# PRIMARY cross-session signal (T-0146); the long-poll bg-watcher
# (`bsq inbox wait`) is opt-in only.
MAIL_SIGNAL = "check mail"


# --------------------------------------------------------------------------
# worker socket transport
# --------------------------------------------------------------------------
class _UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, sock_path: str, timeout: float):
        super().__init__("localhost", timeout=timeout)
        self._sock_path = sock_path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self._sock_path)
        self.sock = s


class WorkerError(Exception):
    """A worker action failed (transport or 4xx). Caught by best-effort callers."""


def post(action: str, params: dict, timeout: float = 35.0, fatal: bool = True) -> dict:
    """POST params to /actions/<action> over the worker unix socket.

    On failure: exit with a message when ``fatal`` (the default), else raise
    ``WorkerError`` so best-effort callers (e.g. the peer-send nudge) can
    swallow it quietly.
    """
    def fail(msg: str) -> None:
        if fatal:
            die(msg)
        raise WorkerError(msg)

    if not os.path.exists(WORKER_SOCK):
        fail(f"worker socket not found: {WORKER_SOCK} (is the worker running?)")
    conn = _UnixHTTPConnection(WORKER_SOCK, timeout=timeout)
    raw, status = "", 0
    try:
        conn.request(
            "POST",
            f"/actions/{action}",
            body=json.dumps(params),
            headers={"Content-Type": "application/json"},
        )
        resp = conn.getresponse()
        raw = resp.read().decode("utf-8", errors="replace")
        status = resp.status
    except OSError as e:
        fail(f"worker call failed ({action}): {e}")
    finally:
        conn.close()

    try:
        data = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        fail(f"worker returned non-JSON for {action} (HTTP {status}): {raw[:200]}")
        data = {}
    if status != 200:
        detail = data.get("detail", raw) if isinstance(data, dict) else raw
        fail(f"worker rejected {action}: {detail}")
    return data


# --------------------------------------------------------------------------
# context resolution: slug + own SID
# --------------------------------------------------------------------------
def resolve_slug(cwd: str | None = None) -> str:
    cwd = cwd or os.getcwd()
    real_cwd = os.path.realpath(cwd)
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
    except OSError as e:
        die(f"cannot read {PROJECTS_TOML}: {e}")

    def _match(target: str) -> bool:
        if not target:
            return False
        rt = os.path.realpath(target)
        t = target.rstrip("/")
        return (
            cwd == target
            or cwd.startswith(t + "/")
            or real_cwd == rt
            or real_cwd.startswith(rt + "/")
        )

    for slug, p in cfg.get("projects", {}).items():
        for key in ("repo_path", "repo_master", "repo_workspace"):
            if _match(p.get(key, "")):
                return slug
    die(f"CWD {cwd} is not inside any registered project (see {PROJECTS_TOML})")


def my_sid() -> str | None:
    """Compute this session's SID from tmux (mirrors hook_my_sid.sh)."""
    hook = f"{BOT_SQUAD}/scripts/hooks/hook_my_sid.sh"
    if os.path.exists(hook):
        try:
            out = subprocess.run([hook], capture_output=True, text=True, timeout=5)
            if out.returncode == 0 and out.stdout.strip():
                return out.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    # Inline fallback.
    if not os.environ.get("TMUX"):
        return None
    try:
        user = subprocess.run(["id", "-un"], capture_output=True, text=True).stdout.strip() or "u"
        user = re.sub(r"[^A-Za-z0-9_]", "_", user)
        target = ["-t", os.environ["TMUX_PANE"]] if os.environ.get("TMUX_PANE") else []
        window = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#W"],
            capture_output=True, text=True,
        ).stdout.strip()
        window = re.sub(r"[^A-Za-z0-9_-]", "_", window)
        pane = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#{pane_id}"],
            capture_output=True, text=True,
        ).stdout.strip().lstrip("%")
        if window and pane:
            return f"S-{user}-{window}-p{pane}"
    except (OSError, KeyError):
        pass
    return None


def require_sid(explicit: str | None) -> str:
    sid = explicit or my_sid()
    if not sid:
        die("could not determine SID from tmux — pass --sid <SID> explicitly")
    return sid


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------
def die(msg: str, code: int = 2) -> None:
    print(f"bsq: {msg}", file=sys.stderr)
    sys.exit(code)


def backlog_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "backlog"


def find_ticket(slug: str, ticket: str) -> Path:
    matches = sorted(backlog_dir(slug).glob(f"{ticket}-*.md"))
    if not matches:
        die(f"ticket not found: {ticket} (looked in {backlog_dir(slug)})")
    return matches[0]


def read_frontmatter(path: Path) -> dict:
    """Tiny flat-YAML frontmatter reader (key: value lines only)."""
    text = path.read_text()
    m = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        return {}
    fm: dict = {}
    for line in m.group(1).splitlines():
        mm = re.match(r"^([A-Za-z0-9_]+):\s*(.*)$", line)
        if mm:
            fm[mm.group(1)] = mm.group(2).strip()
    return fm


# --------------------------------------------------------------------------
# verbs
# --------------------------------------------------------------------------
def cmd_inbox_check(args) -> None:
    slug = resolve_slug()
    sid = require_sid(args.sid)
    res = post("peer_inbox_read", {"slug": slug, "sid": sid})
    messages = res.get("messages", [])
    if args.since:
        messages = [m for m in messages if m.split("\t", 1)[0] >= args.since]
    if args.json:
        print(json.dumps({"sid": sid, "messages": messages, "count": len(messages)}))
        return
    if not messages:
        print("(no new mail)")
        return
    for m in messages:
        env = _extract_envelope(m)
        if env and getattr(args, "envelopes", False):
            # Envelope-only view: print the typed action + payload compactly.
            print(f"[dispatch:{env.get('action')}] {json.dumps(env.get('payload', {}))}"
                  + (f"  note={env.get('note')}" if env.get("note") else ""))
            continue
        print(m)
        if env:
            print(f"    ⤷ dispatch action={env.get('action')} "
                  f"payload={json.dumps(env.get('payload', {}))}"
                  + (f" note={env.get('note')}" if env.get("note") else ""))


def cmd_inbox_wait(args) -> None:
    slug = resolve_slug()
    sid = require_sid(args.sid)
    timeout = float(args.timeout)
    res = post(
        "peer_inbox_wait",
        {"slug": slug, "sid": sid, "timeout": timeout},
        timeout=timeout + 15,
    )
    if res.get("ready"):
        print("mail ready — run `bsq inbox check`")
    else:
        reason = res.get("reason", "timeout")
        print(f"(no mail; {reason} after {res.get('elapsed_sec', 0):.0f}s)")


# --------------------------------------------------------------------------
# Structured dispatch envelope (T-0144)
# --------------------------------------------------------------------------
# Operator → TL hand-offs used to be free text the TL had to parse by eye,
# which was unreliable. A dispatch is now a typed envelope: a one-line marker
# + single-line JSON `{action, payload, note}`, embedded in the peer message so
# it still rides the normal inbox/`check mail` bus. The marker is greppable and
# the JSON parses with a plain split — see vision/roles/teamlead.md for the
# action vocabulary (assign / archive_team / status / message).
ENVELOPE_MARKER = "[[bsq-dispatch v1]]"


def _format_envelope(action: str, payload: dict, note: str | None) -> str:
    body = {"action": action, "payload": payload or {}}
    if note:
        body["note"] = note
    return ENVELOPE_MARKER + json.dumps(body, separators=(",", ":"))


def _extract_envelope(text: str) -> dict | None:
    idx = text.find(ENVELOPE_MARKER)
    if idx < 0:
        return None
    raw = text[idx + len(ENVELOPE_MARKER):].strip()
    try:
        obj = json.loads(raw)
        return obj if isinstance(obj, dict) and "action" in obj else None
    except (json.JSONDecodeError, ValueError):
        return None


def cmd_dispatch(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    payload: dict = {}
    if args.json:
        try:
            payload = json.loads(args.json)
        except json.JSONDecodeError as e:
            die(f"--json is not valid JSON: {e}")
        if not isinstance(payload, dict):
            die("--json payload must be a JSON object")
    for kv in (args.field or []):
        if "=" not in kv:
            die(f"--field expects key=value, got {kv!r}")
        k, _, v = kv.partition("=")
        payload[k.strip()] = v
    text = _format_envelope(args.action, payload, args.note)
    res = post(
        "peer_send",
        {"slug": slug, "from_sid": from_sid, "to": args.to, "text": text},
    )
    delivered = res.get("delivered_to", [])
    print(f"dispatched [{args.action}] to {len(delivered)} inbox(es): "
          f"{', '.join(delivered) or '(none)'}")
    if args.no_signal or not delivered:
        return
    for rsid in delivered:
        if rsid == from_sid:
            continue
        try:
            post("inject_input", {"sid": rsid, "text": MAIL_SIGNAL}, fatal=False)
        except WorkerError:
            pass


def cmd_tg_ping(args) -> None:
    """Explicitly DM the stakeholder on Telegram (T-0155).

    This is the ONLY agent-initiated TG path — there is no implicit per-idle
    flood any more. Use it when you genuinely need the stakeholder's input and
    don't want to wait for the 15-min stall watchdog to escalate for you.

    The message is prefixed with this session's SID, so the stakeholder can
    reply to the TG message and have his answer land back in this tmux pane.
    """
    slug = resolve_slug()
    sid = require_sid(args.sid)
    message = " ".join(args.message).strip()
    if not message:
        die("tg ping: empty message")
    res = post("tg_notify", {"slug": slug, "message": message, "sid": sid,
                             "urgent": bool(args.urgent)})
    if res.get("sent"):
        print(f"tg ping sent (slug={slug}, sid={sid})")
    else:
        print("tg ping suppressed (no bot token, debounce, or quiet hours) — "
              "not sent. Reply will still route if a prior message went out.")


def cmd_peer_send(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    res = post(
        "peer_send",
        {"slug": slug, "from_sid": from_sid, "to": args.to, "text": args.text},
    )
    delivered = res.get("delivered_to", [])
    print(f"sent to {len(delivered)} inbox(es): {', '.join(delivered) or '(none)'}")

    if args.no_signal or not delivered:
        return
    # Primary cross-session signal: nudge each live recipient pane with the
    # "check mail" payload so the peer drains its inbox without an armed
    # long-poll. Best-effort — recipients without a live pane (suspended /
    # non-tmux) just pick the message up on their next `bsq inbox check`.
    nudged, skipped = [], []
    for rsid in delivered:
        if rsid == from_sid:
            continue
        try:
            post("inject_input", {"sid": rsid, "text": MAIL_SIGNAL}, fatal=False)
            nudged.append(rsid)
        except WorkerError:
            skipped.append(rsid)
    if nudged:
        print(f"signalled: {', '.join(nudged)}")
    if skipped:
        print(f"no live pane (will read on next check): {', '.join(skipped)}")


def cmd_spawn(args) -> None:
    slug = resolve_slug()
    ticket = args.ticket.strip()
    path = find_ticket(slug, ticket)
    fm = read_frontmatter(path)

    # window: feature slug after the ticket id, overridable.
    stem = path.stem  # e.g. T-0146-slim-cli-for-agents
    feature = stem.split("-", 2)[2] if stem.count("-") >= 2 else stem
    window = args.window or feature[:40]

    initiative = args.initiative or fm.get("initiative") or None
    bundle = [b.strip() for b in args.bundle.split(",") if b.strip()] if args.bundle else []

    if args.prompt_file:
        initial_prompt = Path(args.prompt_file).read_text().strip()
    elif args.prompt:
        initial_prompt = args.prompt
    else:
        # T-0149: deterministic assembly from ticket(s) + role + guidance + rules.
        all_tickets = [ticket] + [b for b in bundle if b != ticket]
        paths = {ticket: path}
        fms = {ticket: fm}
        for b in bundle:
            if b in paths:
                continue
            bp = find_ticket(slug, b)
            paths[b] = bp
            fms[b] = read_frontmatter(bp)
        report_to = my_sid() or "<your TL SID>"
        initial_prompt = _assemble_prompt(
            slug, all_tickets, paths, fms, args.role, report_to)

    params = {"slug": slug, "window": window, "initial_prompt": initial_prompt, "task_id": ticket}
    if initiative:
        params["initiative"] = initiative
    if args.owner:
        params["owner"] = args.owner

    if args.dry_run:
        print(json.dumps({**params, "initial_prompt": initial_prompt}, indent=2))
        return

    res = post("spawn_session", params, timeout=90)
    print(f"spawned {res.get('sid')} (window={window}, task={ticket}"
          + (f", bundle={','.join(bundle)}" if bundle else "") + ")")


_ROLE_FILES = {"dev": "dev.md", "tl": "teamlead.md", "teamlead": "teamlead.md",
               "operator": "operator.md"}
_KW_STOP = {"the", "and", "for", "with", "from", "into", "via", "not", "per",
            "fix", "add", "new", "use", "all", "any", "out", "off", "more"}


def _ticket_keywords(fms: dict[str, dict]) -> list[str]:
    """Derive guidance-search keywords from assigned tickets (ids + title words)."""
    kws: list[str] = list(fms.keys())  # ticket ids
    for fm in fms.values():
        for w in re.split(r"[^A-Za-z0-9]+", fm.get("title", "").lower()):
            if len(w) >= 4 and w not in _KW_STOP and w not in kws:
                kws.append(w)
    return kws[:8]


def _body_after_frontmatter(path: Path) -> str:
    raw = path.read_text(encoding="utf-8", errors="replace")
    return re.sub(r"\A---\n.*?\n---\n", "", raw, flags=re.DOTALL).strip()


def _cross_refs(bodies: list[str], own: set[str]) -> list[str]:
    """`Related: [[T-xxxx]]` ids referenced by the assigned tickets (minus own)."""
    refs: list[str] = []
    for b in bodies:
        for m in re.findall(r"\[\[(T-\d+)\]\]", b):
            if m not in own and m not in refs:
                refs.append(m)
    return refs


def _assemble_prompt(slug: str, tickets: list[str], paths: dict[str, Path],
                     fms: dict[str, dict], role: str, report_to: str) -> str:
    """T-0149: deterministic per-task/role initial-prompt assembly.

    Composes the brief from the ticket bodies + role contract + initiative +
    cross-refs + prior stakeholder guidance (T-0151) + the hard process rules
    (no-superpowers-drift T-0152, manual-first verification T-0158, git/commit
    discipline, report-READY protocol). Replaces the hand-pasted brief so every
    spawn gets the same complete context regardless of who spawns it.
    """
    primary = tickets[0]
    role = role if role in _ROLE_FILES else "dev"
    roles_dir = Path(BOT_SQUAD) / "data" / slug / "vision" / "roles"
    role_path = roles_dir / _ROLE_FILES[role]
    role_text = role_path.read_text(encoding="utf-8", errors="replace").strip() \
        if role_path.exists() else "(role file missing)"

    bodies = {t: _body_after_frontmatter(paths[t]) for t in tickets}
    initiative = fms[primary].get("initiative") or ""
    ai_path = Path(BOT_SQUAD) / "data" / slug / "AGENT_INSTRUCTIONS.md"
    init_path = (Path(BOT_SQUAD) / "data" / slug / "vision" / "initiatives" / initiative
                 if initiative else None)

    # Prior stakeholder guidance (T-0151) folded in deterministically.
    kws = _ticket_keywords(fms)
    hits, total, _ = _collect_guidance(slug, kws, 5)
    if hits:
        guidance = "\n".join(
            f"  • [{h['source']} · {(h.get('ts') or '')[:10]}] {h['text']}" for h in hits)
        guidance = (f"Prior stakeholder guidance found for this work "
                    f"(via `bsq guidance search`, {total} hit(s); re-run for more):\n{guidance}")
    else:
        guidance = ("No prior stakeholder guidance matched. Before designing your "
                    "approach, run `bsq guidance search <keywords>` yourself with "
                    "other terms — buried guidance saves repeating questions (T-0151).")

    refs = _cross_refs(list(bodies.values()), set(tickets))
    refs_line = (f"Cross-referenced tickets (consult via `bsq ticket status <id>`): "
                 f"{', '.join(refs)}.\n\n" if refs else "")

    ticket_blocks = "\n\n".join(
        f"### {t}: {fms[t].get('title', t)}\n{bodies[t]}" for t in tickets)
    bundle_note = (f" You are bundled {len(tickets)} tickets: {', '.join(tickets)} — "
                   f"handle them together in this one session."
                   if len(tickets) > 1 else "")

    return f"""\
You are a bot-squad {role} session assigned {primary}{bundle_note}

The full scope+DoD of each assigned ticket is INLINED below — this brief is
self-contained, but FIRST also read AGENT_INSTRUCTIONS.md ({ai_path}) for
paths/git-rules and your initiative file{f' ({init_path})' if init_path else ''}.
The 'Verbatim request — source of truth' section of any ticket is HUMAN-ONLY —
never edit it.

== ASSIGNED TICKET(S) ==
{ticket_blocks}

{refs_line}== YOUR ROLE CONTRACT ({_ROLE_FILES[role]}) ==
{role_text}

== PRIOR STAKEHOLDER GUIDANCE (T-0151) ==
{guidance}

== HARD PROCESS RULES (enforced — not suggestions) ==
1. TASK MANAGEMENT VIA BOT-SQUAD TICKETS ONLY (T-0152). Do NOT write planning
   artifacts, notes, or task lists into ~/.claude/superpowers/* or other doc
   folders — that's where sessions get lost. Track all multi-step work on the
   ticket: `bsq ticket note <id> <text>` for progress, `bsq ticket update <id>
   <status>` for status. In-session TodoWrite/TaskCreate is ONLY for sub-steps
   within one ticket.
2. MANUAL-TESTING-FIRST (T-0158). For any verification DoD item: (a) write the
   user scenario in plain English (`bsq scenario new <id>` opens a template),
   (b) walk it through MANUALLY (playwright MCP or narrated scripted
   walkthrough) observing the REAL result, (c) automate ONLY after the manual
   pass. A test .mjs written before the manual walkthrough is a process
   violation.
3. GIT DISCIPLINE. Edit the shared tree directly on branch bot_squad/dev — no
   worktree, no branch switch, no git stash. Commit ONLY with `bsq commit -m
   <msg> --ack <explicit files>` (review the peer report first). Never wide-add,
   never rewrite pushed history (revert to undo), never push or merge — your
   {('TL' if role == 'dev' else 'reviewer')} reviews and deploys.
4. STAY ON TASK (T-0149). A drift-check tick monitors time-since-commit and
   time-since-progress-note. Come back to the DoD regularly; if you defer or
   descope anything, record WHY via `bsq ticket note` — don't silently drift.
5. REPORT READY. When a ticket's DoD (incl. manual walkthrough) is green:
   `bsq ticket update <id> totest`, `bsq ticket note <id> '<summary>'`, then
   `bsq peer send {report_to} 'READY <id> — <summary>'`.
6. REACHING THE STAKEHOLDER (T-0155). Bot-squad NO LONGER DMs the stakeholder on
   every idle turn. If you are genuinely blocked on HIM (not your TL) and need a
   decision, send ONE explicit `bsq tg ping '<what you need>'` — he can reply
   straight to that Telegram message and his answer lands back in this pane.
   Don't spam it. If you forget and stay blocked on him with your tmux window
   unwatched for ~15+ min, the worker auto-escalates for you — but the explicit
   ping is faster and clearer. Route routine questions to your TL via
   `bsq peer send` first.
7. REPORT FRICTION UPSTREAM (T-0154). When the process itself fights you —
   you hit the SAME workaround twice, the ticket scope conflicts with reality,
   a tool/recipe is broken or missing, or guidance is contradictory — submit it:
   `bsq feedback submit '<what bit you + what would help>'`. It lands in the
   project feedback queue for the operator to triage; don't silently absorb it.
   This is how the process improves. (Tag a use case with `--usecase <id>`.)

Run `bsq --help` for the full verb reference."""


def _default_brief(slug: str, ticket: str, path: Path, fm: dict, bundle: list[str]) -> str:
    tl = my_sid() or "<your TL SID>"
    title = fm.get("title", ticket)
    bundle_line = ""
    if bundle:
        bundle_line = (
            f" You are ALSO bound to {', '.join(bundle)} — read each "
            f"{backlog_dir(slug)}/<id>-*.md and handle them in the same session."
        )
    return (
        f"You are a bot-squad dev assigned ticket {ticket} ({title}). "
        f"FIRST read {path} for full scope+DoD and AGENT_INSTRUCTIONS.md for "
        f"paths/git-rules.{bundle_line} The 'Verbatim request' section is "
        f"HUMAN-ONLY — never edit it. Edit the shared tree directly on branch "
        f"bot_squad/dev — no worktree, no branch switch, no git stash. Commit "
        f"ONLY with `bsq commit -m <msg> --ack <files..>` (review the printed "
        f"peer report first); never wide-add, never rewrite pushed history "
        f"(revert to undo). Do NOT push or merge — your TL reviews and deploys. "
        f"Smoke-test before declaring done. When DoD is green: set the ticket "
        f"status frontmatter to totest, add a task_progress_add note, then "
        f"report READY to your TL at {tl} via `bsq peer send {tl} '<summary>'`. "
        f"Run `bsq --help` for the full verb reference."
    )


def cmd_team_status(args) -> None:
    slug = resolve_slug()
    res = post("list_sessions", {"slug": slug})
    sessions = res.get("sessions", [])
    if not args.all:
        # Default to the working roster: active + paused. Suspended sessions
        # are resting roster members (often dozens); --all surfaces them.
        sessions = [s for s in sessions if s.get("status") in ("active", "paused")]
    if args.json:
        print(json.dumps(sessions, indent=2))
        return
    if not sessions:
        print("(no active/paused sessions — use --all to include suspended)")
        return
    rows = [("SID", "STATUS", "ACT", "WINDOW", "TASK", "INITIATIVE")]
    for s in sessions:
        rows.append((
            s.get("sid", ""),
            s.get("status", ""),
            s.get("activity", "") or "-",
            s.get("window", ""),
            s.get("task_id") or "-",
            s.get("initiative") or "-",
        ))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)))


