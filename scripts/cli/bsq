def _docs_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "docs"


def _doc_id_from_stem(stem: str) -> str:
    """`D-NNNN-<slug>` → `D-NNNN`; bare `D-NNNN` passes through."""
    parts = stem.split("-", 2)
    return "-".join(parts[:2]) if len(parts) >= 2 else stem


def _find_doc_file(slug: str, doc_id: str) -> Path | None:
    root = _docs_dir(slug)
    if not root.exists():
        return None
    for f in root.glob(f"*/{doc_id}-*.md"):
        return f
    for f in root.glob(f"*/{doc_id}.md"):
        return f
    return None


def _mutate_fm_list(path: Path, field: str, value: str, *, add: bool) -> None:
    """Add/remove ``value`` from a YAML-frontmatter list field, idempotently."""
    import yaml
    text = path.read_text()
    m = re.match(r"\A---\n(.*?)\n---\n(.*)\Z", text, re.DOTALL)
    if not m:
        die(f"no frontmatter in {path}")
    meta = yaml.safe_load(m.group(1)) or {}
    if not isinstance(meta, dict):
        meta = {}
    body = m.group(2)
    cur = meta.get(field) or []
    if not isinstance(cur, list):
        cur = [cur]
    cur = [str(x) for x in cur]
    if add and value not in cur:
        cur.append(value)
    elif not add and value in cur:
        cur = [x for x in cur if x != value]
    meta[field] = cur
    fm = yaml.safe_dump(meta, allow_unicode=True, sort_keys=False)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(f"---\n{fm}---\n\n{body.lstrip(chr(10))}")
    os.replace(tmp, path)


