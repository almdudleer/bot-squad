#!/usr/bin/env python3
"""bsq — slim bot-squad CLI for agents (T-0146).

One binary, kubectl-style verbs, that wrap the bot-squad worker-socket
actions so agents stop hand-rolling curl + tmux send-keys. `bsq --help`
is the canonical reference — AGENT_INSTRUCTIONS.md points here.

Verbs:
  bsq inbox check [--since TS]      drain this session's peer inbox
  bsq inbox wait  [--timeout N]     opt-in long-poll (the bg-watcher mode)
  bsq peer send <to> <text>         peer_send + nudge the recipient pane
  bsq tg ping <message>             explicitly DM the stakeholder (T-0155)
  bsq task new <title>             allocate next T-NNNN + stub (atomic — T-0174)
  bsq doc new <category> <title>   allocate next D-NNNN + stub doc (T-0172)
  bsq uc new <title>               allocate next UC-NNNN + stub use case
  bsq flow new <uc-id> <title>     allocate next F-NNNN + stub flow (T-0173)
  bsq initiative new <name>        allocate next INI-NN + stub initiative
  bsq spawn <ticket> [--bundle ids] spawn a dev session (auto-resumes an expert)
  bsq expert find <ticket>          rank resumable 'pro' sessions for a ticket
  bsq team status                   list this project's sessions
  bsq team list                     list persisted Team rosters (T-0142)
  bsq team archive <sid>            true-archive a session (suspend + archive)
  bsq team resurrect <sid>          bring a session back (unarchive + resume)
  bsq team rename <sid> <name>      rename a session (tmux + UI + registry sync)
  bsq compact [--sid SID]           send /compact to a session (self by default)
  bsq commit -m MSG <files..>       stage explicit paths + safe-commit

Conventions shared with the other ops shims:
  - $BOT_SQUAD       install root (default /home/www/bot-squad)
  - $WORKER_SOCK     worker unix socket
  - slug is resolved from $PWD against config/projects.toml
  - this session's SID is read from tmux (override with --sid / --from)
"""
from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import time
import tomllib
from datetime import datetime, timezone
from pathlib import Path


def _utc_now() -> str:
    """ISO-8601 UTC timestamp (``...Z``), matching the worker's note format."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

BOT_SQUAD = os.environ.get("BOT_SQUAD", "/home/www/bot-squad")
WORKER_SOCK = os.environ.get("WORKER_SOCK", f"{BOT_SQUAD}/data/_sock/worker.sock")
PROJECTS_TOML = f"{BOT_SQUAD}/config/projects.toml"

# The "check mail" payload bsq injects into a recipient pane. Seeing this
# in its composer is an agent's cue to run `bsq inbox check`. This is the
# PRIMARY cross-session signal (T-0146); the long-poll bg-watcher
# (`bsq inbox wait`) is opt-in only.
MAIL_SIGNAL = "check mail"


# --------------------------------------------------------------------------
# worker socket transport
# --------------------------------------------------------------------------
class _UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, sock_path: str, timeout: float):
        super().__init__("localhost", timeout=timeout)
        self._sock_path = sock_path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self._sock_path)
        self.sock = s


class WorkerError(Exception):
    """A worker action failed (transport or 4xx). Caught by best-effort callers."""


def post(action: str, params: dict, timeout: float = 35.0, fatal: bool = True) -> dict:
    """POST params to /actions/<action> over the worker unix socket.

    On failure: exit with a message when ``fatal`` (the default), else raise
    ``WorkerError`` so best-effort callers (e.g. the peer-send nudge) can
    swallow it quietly.
    """
    def fail(msg: str) -> None:
        if fatal:
            die(msg)
        raise WorkerError(msg)

    if not os.path.exists(WORKER_SOCK):
        fail(f"worker socket not found: {WORKER_SOCK} (is the worker running?)")
    conn = _UnixHTTPConnection(WORKER_SOCK, timeout=timeout)
    raw, status = "", 0
    try:
        conn.request(
            "POST",
            f"/actions/{action}",
            body=json.dumps(params),
            headers={"Content-Type": "application/json"},
        )
        resp = conn.getresponse()
        raw = resp.read().decode("utf-8", errors="replace")
        status = resp.status
    except OSError as e:
        fail(f"worker call failed ({action}): {e}")
    finally:
        conn.close()

    try:
        data = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        fail(f"worker returned non-JSON for {action} (HTTP {status}): {raw[:200]}")
        data = {}
    if status != 200:
        detail = data.get("detail", raw) if isinstance(data, dict) else raw
        fail(f"worker rejected {action}: {detail}")
    return data


# --------------------------------------------------------------------------
# context resolution: slug + own SID
# --------------------------------------------------------------------------
def resolve_slug(cwd: str | None = None) -> str:
    cwd = cwd or os.getcwd()
    real_cwd = os.path.realpath(cwd)
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
    except OSError as e:
        die(f"cannot read {PROJECTS_TOML}: {e}")

    def _match(target: str) -> bool:
        if not target:
            return False
        rt = os.path.realpath(target)
        t = target.rstrip("/")
        return (
            cwd == target
            or cwd.startswith(t + "/")
            or real_cwd == rt
            or real_cwd.startswith(rt + "/")
        )

    for slug, p in cfg.get("projects", {}).items():
        for key in ("repo_path", "repo_master", "repo_workspace"):
            if _match(p.get(key, "")):
                return slug
    die(f"CWD {cwd} is not inside any registered project (see {PROJECTS_TOML})")


def my_sid() -> str | None:
    """Compute this session's SID from tmux (mirrors hook_my_sid.sh)."""
    hook = f"{BOT_SQUAD}/scripts/hooks/hook_my_sid.sh"
    if os.path.exists(hook):
        try:
            out = subprocess.run([hook], capture_output=True, text=True, timeout=5)
            if out.returncode == 0 and out.stdout.strip():
                return out.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    # Inline fallback.
    if not os.environ.get("TMUX"):
        return None
    try:
        user = subprocess.run(["id", "-un"], capture_output=True, text=True).stdout.strip() or "u"
        user = re.sub(r"[^A-Za-z0-9_]", "_", user)
        target = ["-t", os.environ["TMUX_PANE"]] if os.environ.get("TMUX_PANE") else []
        window = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#W"],
            capture_output=True, text=True,
        ).stdout.strip()
        window = re.sub(r"[^A-Za-z0-9_-]", "_", window)
        pane = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#{pane_id}"],
            capture_output=True, text=True,
        ).stdout.strip().lstrip("%")
        if window and pane:
            return f"S-{user}-{window}-p{pane}"
    except (OSError, KeyError):
        pass
    return None


def require_sid(explicit: str | None) -> str:
    sid = explicit or my_sid()
    if not sid:
        die("could not determine SID from tmux — pass --sid <SID> explicitly")
    return sid


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------
def die(msg: str, code: int = 2) -> None:
    print(f"bsq: {msg}", file=sys.stderr)
    sys.exit(code)


def backlog_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "backlog"


def find_ticket(slug: str, ticket: str) -> Path:
    matches = sorted(backlog_dir(slug).glob(f"{ticket}-*.md"))
    if not matches:
        die(f"ticket not found: {ticket} (looked in {backlog_dir(slug)})")
    return matches[0]


def read_frontmatter(path: Path) -> dict:
    """Tiny flat-YAML frontmatter reader (key: value lines only)."""
    text = path.read_text()
    m = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        return {}
    fm: dict = {}
    for line in m.group(1).splitlines():
        mm = re.match(r"^([A-Za-z0-9_]+):\s*(.*)$", line)
        if mm:
            fm[mm.group(1)] = mm.group(2).strip()
    return fm


# --------------------------------------------------------------------------
# verbs
# --------------------------------------------------------------------------
def cmd_inbox_check(args) -> None:
    slug = resolve_slug()
    sid = require_sid(args.sid)
    res = post("peer_inbox_read", {"slug": slug, "sid": sid})
    messages = res.get("messages", [])
    if args.since:
        messages = [m for m in messages if m.split("\t", 1)[0] >= args.since]
    if args.json:
        print(json.dumps({"sid": sid, "messages": messages, "count": len(messages)}))
        return
    if not messages:
        print("(no new mail)")
        return
    for m in messages:
        env = _extract_envelope(m)
        if env and getattr(args, "envelopes", False):
            # Envelope-only view: print the typed action + payload compactly.
            print(f"[dispatch:{env.get('action')}] {json.dumps(env.get('payload', {}))}"
                  + (f"  note={env.get('note')}" if env.get("note") else ""))
            continue
        print(m)
        if env:
            print(f"    ⤷ dispatch action={env.get('action')} "
                  f"payload={json.dumps(env.get('payload', {}))}"
                  + (f" note={env.get('note')}" if env.get("note") else ""))


def cmd_inbox_wait(args) -> None:
    slug = resolve_slug()
    sid = require_sid(args.sid)
    timeout = float(args.timeout)
    res = post(
        "peer_inbox_wait",
        {"slug": slug, "sid": sid, "timeout": timeout},
        timeout=timeout + 15,
    )
    if res.get("ready"):
        print("mail ready — run `bsq inbox check`")
    else:
        reason = res.get("reason", "timeout")
        print(f"(no mail; {reason} after {res.get('elapsed_sec', 0):.0f}s)")


# --------------------------------------------------------------------------
# Structured dispatch envelope (T-0144)
# --------------------------------------------------------------------------
# Operator → TL hand-offs used to be free text the TL had to parse by eye,
# which was unreliable. A dispatch is now a typed envelope: a one-line marker
# + single-line JSON `{action, payload, note}`, embedded in the peer message so
# it still rides the normal inbox/`check mail` bus. The marker is greppable and
# the JSON parses with a plain split — see vision/roles/teamlead.md for the
# action vocabulary (assign / archive_team / status / message).
ENVELOPE_MARKER = "[[bsq-dispatch v1]]"


def _format_envelope(action: str, payload: dict, note: str | None) -> str:
    body = {"action": action, "payload": payload or {}}
    if note:
        body["note"] = note
    return ENVELOPE_MARKER + json.dumps(body, separators=(",", ":"))


def _extract_envelope(text: str) -> dict | None:
    idx = text.find(ENVELOPE_MARKER)
    if idx < 0:
        return None
    raw = text[idx + len(ENVELOPE_MARKER):].strip()
    try:
        obj = json.loads(raw)
        return obj if isinstance(obj, dict) and "action" in obj else None
    except (json.JSONDecodeError, ValueError):
        return None


def cmd_dispatch(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    payload: dict = {}
    if args.json:
        try:
            payload = json.loads(args.json)
        except json.JSONDecodeError as e:
            die(f"--json is not valid JSON: {e}")
        if not isinstance(payload, dict):
            die("--json payload must be a JSON object")
    for kv in (args.field or []):
        if "=" not in kv:
            die(f"--field expects key=value, got {kv!r}")
        k, _, v = kv.partition("=")
        payload[k.strip()] = v
    text = _format_envelope(args.action, payload, args.note)
    res = post(
        "peer_send",
        {"slug": slug, "from_sid": from_sid, "to": args.to, "text": text},
    )
    delivered = res.get("delivered_to", [])
    print(f"dispatched [{args.action}] to {len(delivered)} inbox(es): "
          f"{', '.join(delivered) or '(none)'}")
    if args.no_signal or not delivered:
        return
    for rsid in delivered:
        if rsid == from_sid:
            continue
        try:
            post("inject_input", {"sid": rsid, "text": MAIL_SIGNAL}, fatal=False)
        except WorkerError:
            pass


def cmd_tg_ping(args) -> None:
    """Explicitly DM the stakeholder on Telegram (T-0155).

    This is the ONLY agent-initiated TG path — there is no implicit per-idle
    flood any more. Use it when you genuinely need the stakeholder's input and
    don't want to wait for the 15-min stall watchdog to escalate for you.

    The message is prefixed with this session's SID, so the stakeholder can
    reply to the TG message and have his answer land back in this tmux pane.
    """
    slug = resolve_slug()
    sid = require_sid(args.sid)
    message = " ".join(args.message).strip()
    if not message:
        die("tg ping: empty message")
    res = post("tg_notify", {"slug": slug, "message": message, "sid": sid,
                             "urgent": bool(args.urgent)})
    if res.get("sent"):
        print(f"tg ping sent (slug={slug}, sid={sid})")
    else:
        print("tg ping suppressed (no bot token, debounce, or quiet hours) — "
              "not sent. Reply will still route if a prior message went out.")


def cmd_peer_send(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    params = {"slug": slug, "from_sid": from_sid, "to": args.to, "text": args.text}
    # T-0157: --user widens role-keyword fan-out (teamlead/dev/all) to another
    # linux user's sessions. Without it, role keywords stay scoped to the
    # sender's own user. Ignored for a literal-SID target (always explicit).
    if getattr(args, "user", None):
        params["user"] = args.user
    res = post("peer_send", params)
    delivered = res.get("delivered_to", [])
    print(f"sent to {len(delivered)} inbox(es): {', '.join(delivered) or '(none)'}")

    if args.no_signal or not delivered:
        return
    # Primary cross-session signal: nudge each live recipient pane with the
    # "check mail" payload so the peer drains its inbox without an armed
    # long-poll. Best-effort — recipients without a live pane (suspended /
    # non-tmux) just pick the message up on their next `bsq inbox check`.
    nudged, skipped = [], []
    for rsid in delivered:
        if rsid == from_sid:
            continue
        try:
            post("inject_input", {"sid": rsid, "text": MAIL_SIGNAL}, fatal=False)
            nudged.append(rsid)
        except WorkerError:
            skipped.append(rsid)
    if nudged:
        print(f"signalled: {', '.join(nudged)}")
    if skipped:
        print(f"no live pane (will read on next check): {', '.join(skipped)}")


def cmd_spawn(args) -> None:
    slug = resolve_slug()
    ticket = args.ticket.strip()
    path = find_ticket(slug, ticket)
    fm = read_frontmatter(path)

    # window: feature slug after the ticket id, overridable.
    stem = path.stem  # e.g. T-0146-slim-cli-for-agents
    feature = stem.split("-", 2)[2] if stem.count("-") >= 2 else stem
    window = args.window or feature[:40]

    initiative = args.initiative or fm.get("initiative") or None
    bundle = [b.strip() for b in args.bundle.split(",") if b.strip()] if args.bundle else []
    # T-0160: the extra (bundled) tickets to BIND after the session comes up.
    # The primary rides in via task_id; extras must be bind_task'd explicitly.
    extras = [b for b in bundle if b != ticket]

    # All tickets are loaded up front: both the prompt assembler (T-0149) and
    # the expert scan (T-0150) need the bundle's frontmatter + bodies.
    all_tickets = [ticket] + extras
    paths = {ticket: path}
    fms = {ticket: fm}
    for b in extras:
        if b in paths:
            continue
        bp = find_ticket(slug, b)
        paths[b] = bp
        fms[b] = read_frontmatter(bp)

    report_to = my_sid() or "<your TL SID>"
    custom_prompt = bool(args.prompt or args.prompt_file)
    if args.prompt_file:
        initial_prompt = Path(args.prompt_file).read_text().strip()
    elif args.prompt:
        initial_prompt = args.prompt
    else:
        # T-0149: deterministic assembly from ticket(s) + role + guidance + rules.
        initial_prompt = _assemble_prompt(
            slug, all_tickets, paths, fms, args.role, report_to)

    # === T-0150: prefer RESUMING an existing expert over a fresh spawn ===
    # Oftentimes a (suspended/archived) session already "pro'd" a related task.
    # Resuming it and handing it a delta brief beats spawning a fresh dev that
    # re-researches from scratch (often with gaps). Fresh spawn is the fallback.
    expert = None
    if not args.fresh:
        try:
            sessions = post("list_sessions", {"slug": slug}).get("sessions", [])
        except WorkerError:
            sessions = []
        ranked = _find_expert(slug, sessions, all_tickets, fms, paths, my_sid())
        if args.resume_sid:
            # Explicit override: resume this SID even if not auto-pickable.
            expert = next((c for c in ranked if c["sid"] == args.resume_sid), None)
            if expert is None:
                die(f"--resume {args.resume_sid}: not a viable expert candidate. "
                    f"Candidates: {', '.join(c['sid'] for c in ranked) or '(none)'}")
        elif custom_prompt:
            # A hand-written --prompt is an explicit fresh-intent; don't
            # auto-resume over it (use --resume <sid> to force it).
            pass
        elif ranked and ranked[0]["confidence"] == "high":
            expert = ranked[0]
        elif ranked:
            # Medium/low match: don't auto-resume, but tell the operator it exists.
            top = ranked[0]
            print(f"note: possible expert {top['sid']} ({top['confidence']}, "
                  f"score {top['score']}: {'; '.join(top['reasons'])}). Not "
                  f"auto-resuming — re-run with `--resume {top['sid']}` to use it, "
                  f"or `--fresh` to silence.", file=sys.stderr)

    if expert is not None:
        brief = initial_prompt if custom_prompt else _assemble_delta_brief(
            slug, all_tickets, fms, paths, expert, report_to)
        _resume_expert(slug, expert, all_tickets, brief, args.dry_run)
        return

    params = {"slug": slug, "window": window, "initial_prompt": initial_prompt, "task_id": ticket}
    if initiative:
        params["initiative"] = initiative
    if args.owner:
        params["owner"] = args.owner

    if args.dry_run:
        print(json.dumps({"decision": "fresh-spawn", "bind_after": extras,
                          **params}, indent=2))
        return

    res = post("spawn_session", params, timeout=90)
    sid = res.get("sid")
    print(f"spawned {sid} (window={window}, task={ticket}"
          + (f", bundle={','.join(bundle)}" if bundle else "") + ")")
    # T-0160: persist the bundle bindings. spawn_session only binds the primary
    # (via the .claude/task_id marker); each extra needs an explicit bind_task
    # so extra_task_ids / session_history / gc reconcilers stay honest. Wait for
    # the SessionStart hook to stamp the primary first so our extras land after
    # the hook's md write (else it clobbers them).
    _bind_extras(slug, sid, extras, wait_primary=ticket)


def _session_record(slug: str, sid: str) -> dict | None:
    """Look up one session's live record from list_sessions (None if gone)."""
    try:
        sessions = post("list_sessions", {"slug": slug}, fatal=False).get("sessions", [])
    except WorkerError:
        return None
    for s in sessions:
        if s.get("sid") == sid:
            return s
    return None


def _wait_for_session_primary(slug: str, sid: str, primary: str,
                              timeout: float = 45.0, interval: float = 2.0) -> bool:
    """Block until the SessionStart hook has stamped `primary` as the session's
    task_id (its md write is then complete). Binding extras only AFTER this
    avoids the hook's read-modify-write clobbering them (T-0160 root cause: the
    hook preserves *existing* extra_task_ids, so our write must land after it).
    """
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        rec = _session_record(slug, sid)
        if rec and rec.get("task_id") == primary:
            return True
        time.sleep(interval)
    return False


def _bind_extras(slug: str, sid: str | None, extras: list[str],
                 wait_primary: str | None = None) -> None:
    """T-0160: bind each extra ticket to a freshly-spawned/resumed session.

    Calls the worker ``bind_task`` action per extra (idempotent for already-bound
    ids), then verifies the bindings stuck and re-binds any the SessionStart hook
    raced away. A single bind failure is surfaced but does not abort the rest —
    the session is up and the operator can re-bind.
    """
    if not sid or not extras:
        return
    if wait_primary and not _wait_for_session_primary(slug, sid, wait_primary):
        print(f"  note: session {sid} primary task_id not visible yet — binding "
              f"anyway (will verify + retry)", file=sys.stderr)
    for tid in extras:
        try:
            res = post("bind_task", {"slug": slug, "sid": sid, "task_id": tid},
                       fatal=False)
            if res.get("already_bound"):
                print(f"  bound {tid} -> {sid} (already bound)")
            else:
                print(f"  bound {tid} -> {sid} (extras now: "
                      f"{', '.join(res.get('extras', [])) or '-'})")
        except WorkerError as e:
            print(f"  WARNING: failed to bind {tid} -> {sid}: {e}\n"
                  f"    re-bind manually: bsq spawn ... or worker bind_task "
                  f"slug={slug} sid={sid} task_id={tid}", file=sys.stderr)
    # Verify + self-heal: the SessionStart hook (fresh spawn) or resume hook can
    # rewrite the md from a pre-bind read and drop our extras. Re-check over a
    # short window and re-bind anything missing.
    for _ in range(3):
        rec = _session_record(slug, sid)
        if rec is None:
            return
        have = set(_clean_id_list(rec.get("extra_task_ids")))
        missing = [t for t in extras if t not in have]
        if not missing:
            return
        time.sleep(4)
        for tid in missing:
            try:
                post("bind_task", {"slug": slug, "sid": sid, "task_id": tid},
                     fatal=False)
                print(f"  re-bound {tid} -> {sid} (raced by a session-md rewrite)")
            except WorkerError:
                pass
    rec = _session_record(slug, sid)
    have = set(_clean_id_list(rec.get("extra_task_ids"))) if rec else set()
    still = [t for t in extras if t not in have]
    if still:
        print(f"  WARNING: bindings not confirmed for {', '.join(still)} on {sid} "
              f"— verify with `bsq team status --all --json`", file=sys.stderr)


# --------------------------------------------------------------------------
# Expert resumption (T-0150) — oftentimes a (suspended/archived) session has
# already become a "pro" at a related task. Resuming it + a delta brief beats
# spawning a fresh dev that re-researches from scratch (research with holes).
# `_find_expert` scores candidate sessions by ticket-graph overlap (shared /
# cross-referenced tickets), initiative, title-keyword, files-touched, and
# recency; `bsq spawn` auto-resumes a high-confidence top match.
# --------------------------------------------------------------------------
_EXPERT_W_SHARED = 6        # candidate already worked one of the new tickets
_EXPERT_W_XREF = 5          # explicit `[[T-x]]` ticket-graph link (high signal)
_EXPERT_W_MENTION = 3       # plain `T-x` mentioned in the new ticket's scope (medium)
_EXPERT_W_INITIATIVE = 3    # same initiative
_EXPERT_W_KEYWORD = 1       # per overlapping title keyword (capped)
_EXPERT_W_TOUCHED = 2       # per overlapping touched-file basename (capped)
_EXPERT_KEYWORD_CAP = 3
_EXPERT_TOUCHED_CAP = 3
_EXPERT_FILESCAN_TOPN = 6   # only jsonl-scan the top-N cheap-scored candidates
_EXPERT_JSONL_TAIL = 400    # last N jsonl records to scan for touched files
_CONFIDENCE_RANK = {"high": 2, "medium": 1, "low": 0}


def _clean_id_list(v) -> list[str]:
    """Normalise a list/scalar frontmatter value to non-nil string ids."""
    if isinstance(v, list):
        items = v
    elif v in (None, "", "~"):
        items = []
    else:
        items = [v]
    return [str(x).strip() for x in items if x and str(x).strip() not in ("", "~")]


def _session_tickets(s: dict) -> set[str]:
    out = set(_clean_id_list(s.get("task_id")))
    out |= set(_clean_id_list(s.get("extra_task_ids")))
    return out


def _session_initiatives(s: dict) -> set[str]:
    out = set(_clean_id_list(s.get("initiative")))
    out |= set(_clean_id_list(s.get("extra_initiatives")))
    return out


def _ticket_md(slug: str, tid: str) -> tuple[dict, str] | None:
    """Non-fatal ticket lookup → (frontmatter, body) or None if not found."""
    matches = sorted(backlog_dir(slug).glob(f"{tid}-*.md"))
    if not matches:
        return None
    return read_frontmatter(matches[0]), _body_after_frontmatter(matches[0])


def _ticket_session_history(slug: str, tid: str) -> set[str]:
    """SIDs the ticket's `session_history` frontmatter records (T-0105).

    This is the load-bearing bridge for expert discovery: a session's *live*
    task binding is released when it's archived/GC'd (task_id → None), but the
    ticket keeps a forensic list of every SID that ever worked it — and the
    session's current SID is the last one appended (on spawn/bind/resume), so a
    still-resumable 'pro' session is findable here long after its binding lapsed.
    """
    md = _ticket_md(slug, tid)
    if not md:
        return set()
    return set(re.findall(r"S-[A-Za-z0-9_.-]+", str(md[0].get("session_history", "") or "")))


def _title_keywords(title: str) -> set[str]:
    return {w for w in re.split(r"[^A-Za-z0-9]+", (title or "").lower())
            if len(w) >= 4 and w not in _KW_STOP}


def _ticket_path_tokens(bodies: list[str]) -> set[str]:
    """File-path-ish tokens mentioned in ticket bodies, keyed by basename.

    A ticket like T-0160 names `scripts/cli/bsq`; matching that against a
    candidate session's touched files is a strong "this is the expert" signal.
    """
    tokens: set[str] = set()
    for b in bodies:
        for m in re.findall(r"[A-Za-z0-9_][A-Za-z0-9_./-]*\.[A-Za-z0-9_]+", b):
            if "/" in m:
                tokens.add(os.path.basename(m))
        # path-with-slash but no extension (e.g. scripts/cli/bsq)
        for m in re.findall(r"[A-Za-z0-9_./-]+/[A-Za-z0-9_-]+", b):
            tokens.add(os.path.basename(m))
    return {t for t in tokens if len(t) >= 3}


def _jsonl_for_uuid(uuid: str) -> str | None:
    if not uuid or uuid == "~":
        return None
    hits = []
    if os.path.isdir(_CLAUDE_PROJECTS):
        for d in os.listdir(_CLAUDE_PROJECTS):
            p = os.path.join(_CLAUDE_PROJECTS, d, f"{uuid}.jsonl")
            if os.path.exists(p):
                hits.append(p)
    if not hits:
        return None
    return max(hits, key=lambda p: os.path.getmtime(p))


def _touched_file_basenames(jsonl_path: str) -> set[str]:
    """Basenames of files a session wrote (Edit/Write/MultiEdit/NotebookEdit).

    Tails the transcript (last `_EXPERT_JSONL_TAIL` records) — same shape the
    worker's drift scan reads (T-0149).
    """
    try:
        with open(jsonl_path, encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return set()
    out: set[str] = set()
    _write_tools = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
    for line in lines[-_EXPERT_JSONL_TAIL:]:
        line = line.strip()
        if not line or '"tool_use"' not in line:
            continue
        try:
            o = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            continue
        content = (o.get("message") or {}).get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict) or block.get("type") != "tool_use":
                continue
            if block.get("name") not in _write_tools:
                continue
            inp = block.get("input") or {}
            fp = inp.get("file_path") or inp.get("notebook_path")
            if isinstance(fp, str) and fp.strip():
                out.add(os.path.basename(fp.strip()))
    return out


def _recency_key(s: dict):
    """Sort-friendly recency value (higher = more recent). Best-effort parse."""
    for k in ("suspended_at", "paused_at", "started_at"):
        v = s.get(k)
        if isinstance(v, str) and v and v != "~":
            try:
                return datetime.strptime(v[:19], "%Y-%m-%dT%H:%M:%S").replace(
                    tzinfo=timezone.utc).timestamp()
            except ValueError:
                continue
    v = s.get("activity_at")
    if isinstance(v, (int, float)):
        return float(v)
    return 0.0


def _related_tickets(slug: str, own: set[str], xrefs: set[str],
                     new_bodies: list[str]) -> dict[str, tuple[int, str, bool]]:
    """Ticket-graph universe related to the new task → {tid: (weight, reason, high)}.

    High signals (a session that worked the ticket is a HIGH-confidence expert,
    eligible for auto-resume):
    - own tickets themselves (a session that already worked THIS ticket),
    - tickets the new task links to via `Related: [[T-x]]`,
    - reverse links: any backlog ticket whose body links to one of the new tickets.
    Medium signal (surfaced, but never auto-resumed):
    - tickets the new task mentions in prose as plain `T-x` (no `[[ ]]`) — e.g.
      'Bug is in the bsq spawn path (..., T-0149 assembly)'.
    """
    related: dict[str, tuple[int, str, bool]] = {}
    for t in sorted(own):
        related[t] = (_EXPERT_W_SHARED, f"already worked {t}", True)
    for t in sorted(xrefs):
        related.setdefault(t, (_EXPERT_W_XREF, f"this task links to {t} (which it worked)", True))
    # Reverse-xref sweep: tickets whose body links back to one of the new tickets.
    for p in sorted(backlog_dir(slug).glob("T-*.md")):
        fm = read_frontmatter(p)
        tid = fm.get("id") or "-".join(p.stem.split("-")[:2])
        if tid in own or tid in related:
            continue
        body = _body_after_frontmatter(p)
        if any(m in own for m in re.findall(r"\[\[(T-\d+)\]\]", body)):
            related[tid] = (_EXPERT_W_XREF, f"its {tid} links to this task", True)
    # Plain prose mentions of other tickets in the new task's scope (medium).
    mentions = set()
    for b in new_bodies:
        mentions |= set(re.findall(r"\bT-\d{3,}\b", b))
    for t in sorted(mentions - own):
        related.setdefault(t, (_EXPERT_W_MENTION,
                               f"new task mentions {t} in scope (which it worked)", False))
    return related


def _find_expert(slug: str, sessions: list[dict], tickets: list[str],
                 fms: dict[str, dict], paths: dict[str, "Path"],
                 my_sid_value: str | None) -> list[dict]:
    """Rank suspended/archived sessions by how 'pro' they are at this task.

    Returns a confidence-then-score-sorted list of candidate dicts
    ``{sid, uuid, status, archived, tickets, worked, score, confidence, reasons}``.
    Candidates with no overlap (score 0) are dropped.

    Expert discovery is primarily via the ticket-graph ∩ each related ticket's
    `session_history` (a session's live binding is released on archive, but the
    ticket remembers who worked it). Initiative / title-keyword / files-touched /
    recency refine the ranking. Pure over `sessions` (no worker calls) so it's
    unit-testable + dry-runnable.
    """
    own = set(tickets)
    new_bodies = [_body_after_frontmatter(paths[t]) for t in tickets]
    xrefs = set(_cross_refs(new_bodies, own))           # tickets the NEW task links to
    new_inits: set[str] = set()
    for t in tickets:
        new_inits |= set(_clean_id_list(fms[t].get("initiative")))
    new_kw: set[str] = set()
    for t in tickets:
        new_kw |= _title_keywords(fms[t].get("title", ""))
    new_path_tokens = _ticket_path_tokens(new_bodies)

    related = _related_tickets(slug, own, xrefs, new_bodies)
    # SIDs that worked each related ticket (forensic, survives binding release).
    sh_by_ticket = {t: _ticket_session_history(slug, t) for t in related}
    # Titles of related tickets, for the keyword signal on sessions that worked them.
    title_cache: dict[str, str] = {}

    def _title(tid: str) -> str:
        if tid not in title_cache:
            md = _ticket_md(slug, tid)
            title_cache[tid] = (md[0].get("title", "") if md else "")
        return title_cache[tid]

    cands: list[dict] = []
    for s in sessions:
        sid = s.get("sid")
        if not sid or sid == my_sid_value:
            continue
        if not (s.get("status") == "suspended" or bool(s.get("archived"))):
            continue
        uuid = s.get("claude_uuid")
        if not uuid or uuid == "~":
            continue
        cand_tickets = _session_tickets(s)

        # Which related tickets did THIS session work? Either it still carries
        # the binding, or its SID is in that ticket's session_history.
        worked = {t: rel for t, rel in related.items()
                  if sid in sh_by_ticket.get(t, set()) or t in cand_tickets}

        score = 0
        reasons: list[str] = []
        high = False
        medium = False
        for t in sorted(worked):
            w, rsn, is_high = worked[t]
            score += w
            if is_high:
                high = True
            else:
                medium = True
            reasons.append(rsn)

        shared_init = _session_initiatives(s) & new_inits
        if shared_init:
            score += _EXPERT_W_INITIATIVE
            medium = True
            reasons.append(f"same initiative {sorted(shared_init)[0]}")

        # Keyword signal: candidate's worked-ticket titles + its window name.
        cand_kw = _title_keywords(s.get("window", "").replace("-", " ").replace("_", " "))
        for t in set(worked) | cand_tickets:
            cand_kw |= _title_keywords(_title(t))
        kw_hit = cand_kw & new_kw
        if kw_hit:
            score += min(len(kw_hit), _EXPERT_KEYWORD_CAP) * _EXPERT_W_KEYWORD
            if len(kw_hit) >= 2:
                medium = True
            reasons.append(f"keyword overlap: {', '.join(sorted(kw_hit)[:3])}")

        cands.append({
            "sid": sid, "uuid": uuid, "status": s.get("status", ""),
            "archived": bool(s.get("archived")), "window": s.get("window", ""),
            "tickets": sorted(set(worked) | cand_tickets),
            "worked": sorted(worked), "score": score, "reasons": reasons,
            "_high": high, "_medium": medium, "_recency": _recency_key(s),
        })

    # Files-touched pass: only for the top-N cheap-scored candidates, and only
    # if the new tickets actually name files (else nothing to match against).
    if new_path_tokens:
        for c in sorted(cands, key=lambda c: c["score"], reverse=True)[:_EXPERT_FILESCAN_TOPN]:
            jp = _jsonl_for_uuid(c["uuid"])
            if not jp:
                continue
            overlap = _touched_file_basenames(jp) & new_path_tokens
            if overlap:
                c["score"] += min(len(overlap), _EXPERT_TOUCHED_CAP) * _EXPERT_W_TOUCHED
                c["_medium"] = True
                c["reasons"].append(f"touched {', '.join(sorted(overlap)[:3])}")

    out = []
    for c in cands:
        # Drop no-overlap candidates and lone-keyword noise (a single shared
        # title word is too weak to surface; keep high/medium + multi-signal lows).
        if c["score"] <= 0 or (not c["_high"] and not c["_medium"] and c["score"] < 2):
            continue
        c["confidence"] = "high" if c["_high"] else ("medium" if c["_medium"] else "low")
        out.append(c)
    out.sort(key=lambda c: (_CONFIDENCE_RANK[c["confidence"]], c["score"], c["_recency"]),
             reverse=True)
    # Strip private keys from the returned view.
    for c in out:
        for k in ("_high", "_medium", "_recency"):
            c.pop(k, None)
    return out


def _assemble_delta_brief(slug: str, tickets: list[str], fms: dict[str, dict],
                          paths: dict[str, "Path"], expert: dict,
                          report_to: str) -> str:
    """T-0150: the brief handed to a RESUMED expert — a delta on its prior work.

    Unlike the fresh-spawn assembly (full role contract + guidance + rules), this
    leans on the session's existing context: it states what it already did, the
    new related task, and *why* it's the right session, then inlines the new
    ticket(s) + the load-bearing process reminders.
    """
    bodies = {t: _body_after_frontmatter(paths[t]) for t in tickets}
    ticket_blocks = "\n\n".join(
        f"### {t}: {fms[t].get('title', t)}\n{bodies[t]}" for t in tickets)
    prior = ", ".join(expert.get("tickets", [])) or "(your prior work in this session)"
    overlap = "; ".join(expert.get("reasons", [])) or "related prior work"
    bundle_note = (f" Handle all of {', '.join(tickets)} together in this session."
                   if len(tickets) > 1 else "")
    ai_path = Path(BOT_SQUAD) / "data" / slug / "AGENT_INSTRUCTIONS.md"
    return f"""\
You are being RESUMED as the resident expert — NOT spawned fresh. You previously
worked: {prior}. A new, RELATED task now builds on that work. Apply what you
already know; do NOT re-research from scratch (that's the whole point of resuming
you).{bundle_note}

Why you (overlap with your prior work): {overlap}

== NEW ASSIGNED TICKET(S) ==
{ticket_blocks}

== REMINDERS (you know these; quick refresh) ==
- This is a delta on your existing context — reuse it. If your memory of the
  paths/rules is stale, re-read AGENT_INSTRUCTIONS.md ({ai_path}).
- Track ALL work on the ticket: `bsq ticket note <id> <text>` / `bsq ticket
  update <id> <status>`. Never plan into superpowers/* docs (T-0152).
- Verify MANUAL-FIRST (T-0158): write the user scenario, walk it through, then
  automate. The 'Verbatim request' section of a ticket is HUMAN-ONLY.
- Git: edit the shared tree on bot_squad/dev (no worktree/stash). Commit ONLY
  with `bsq commit -m <msg> --ack <explicit files>`; never wide-add, never push
  or merge — your TL reviews + deploys.
- When DoD is green: `bsq ticket update <id> totest`, `bsq ticket note <id>
  '<summary>'`, then `bsq peer send {report_to} 'READY <id> — <summary>'`.

Run `bsq --help` for the full verb reference."""


def _resume_expert(slug: str, expert: dict, all_tickets: list[str],
                   brief: str, dry_run: bool) -> None:
    """Resume a matched expert session and hand it the delta brief + bindings."""
    sid = expert["sid"]
    if dry_run:
        print(json.dumps({
            "decision": "resume-expert", "sid": sid, "uuid": expert.get("uuid"),
            "confidence": expert["confidence"], "score": expert["score"],
            "reasons": expert["reasons"],
            "prior_tickets": expert.get("tickets", []),
            "bind": all_tickets, "delta_brief": brief,
        }, indent=2))
        return
    print(f"resuming expert {sid} (score {expert['score']}, {expert['confidence']}): "
          f"{'; '.join(expert['reasons'])}")
    if expert.get("archived"):
        # Clear the archive flag first (operator-retired sessions are exactly the
        # 'old pro' we want back). Best-effort — resume still works if it no-ops.
        try:
            post("unarchive_session", {"slug": slug, "sid": sid}, fatal=False)
        except WorkerError:
            pass
    # Preferred: hand the delta brief straight to the resumed composer
    # (worker resume_session learned `initial_prompt` in T-0150). Param
    # validation runs before any resume work, so a rejection from a pre-T0150
    # worker leaves no partial state — fall back to a plain resume + bus delivery.
    delivered = "prompt"
    try:
        res = post("resume_session",
                   {"slug": slug, "sid": sid, "initial_prompt": brief},
                   timeout=120, fatal=False)
    except WorkerError as e:
        if "initial_prompt" in str(e) and "unexpected" in str(e):
            res = post("resume_session", {"slug": slug, "sid": sid}, timeout=120)
            delivered = "bus"
        else:
            die(f"resume_session failed for {sid}: {e}")
    new_sid = res.get("sid", sid)
    if delivered == "bus":
        _deliver_brief_via_bus(slug, new_sid, brief)
        print(f"resumed -> {new_sid}; delta brief delivered via peer inbox "
              f"(pre-T0150 worker — direct prompt delivery lands after the worker deploy)")
    else:
        print(f"resumed -> {new_sid}; delivered delta brief for {', '.join(all_tickets)}")
    # Bind every assigned ticket to the resumed expert. Its primary task stays
    # its original; the new ones land in extra_task_ids (idempotent).
    _bind_extras(slug, new_sid, all_tickets)


def _deliver_brief_via_bus(slug: str, sid: str, brief: str) -> None:
    """Fallback brief delivery for pre-T0150 workers: drop the delta brief into
    the resumed session's peer inbox (newlines are flattened to spaces by the
    bus) and nudge its pane to drain. The session reads it on `bsq inbox check`.
    """
    sender = my_sid() or "stakeholder"
    header = "[RESUME DELTA BRIEF — you were resumed as the expert; full brief follows] || "
    post("peer_send", {"slug": slug, "from_sid": sender, "to": sid,
                       "text": header + brief}, fatal=False)
    try:
        post("inject_input", {"sid": sid, "text": MAIL_SIGNAL}, fatal=False)
    except WorkerError:
        pass


def cmd_expert_find(args) -> None:
    slug = resolve_slug()
    ticket = args.ticket.strip()
    path = find_ticket(slug, ticket)
    fm = read_frontmatter(path)
    bundle = [b.strip() for b in args.bundle.split(",") if b.strip()] if args.bundle else []
    extras = [b for b in bundle if b != ticket]
    all_tickets = [ticket] + extras
    paths = {ticket: path}
    fms = {ticket: fm}
    for b in extras:
        if b in paths:
            continue
        bp = find_ticket(slug, b)
        paths[b] = bp
        fms[b] = read_frontmatter(bp)
    sessions = post("list_sessions", {"slug": slug}).get("sessions", [])
    ranked = _find_expert(slug, sessions, all_tickets, fms, paths, my_sid())
    if args.json:
        print(json.dumps(ranked, indent=2))
        return
    if not ranked:
        print(f"(no expert candidates for {', '.join(all_tickets)} — a fresh "
              f"spawn is the right call)")
        return
    print(f"expert candidates for {', '.join(all_tickets)} (best first):\n")
    for c in ranked:
        print(f"• {c['sid']}  [{c['confidence']}, score {c['score']}]  "
              f"uuid={c.get('uuid', '?')}")
        print(f"  prior tickets: {', '.join(c.get('tickets', [])) or '-'}")
        print(f"  why: {'; '.join(c['reasons'])}\n")
    print("`bsq spawn <ticket>` auto-resumes a HIGH-confidence top match; for a "
          "medium/low one use `bsq spawn <ticket> --resume <sid>`.")


_ROLE_FILES = {"dev": "dev.md", "tl": "teamlead.md", "teamlead": "teamlead.md",
               "operator": "operator.md"}
_KW_STOP = {"the", "and", "for", "with", "from", "into", "via", "not", "per",
            "fix", "add", "new", "use", "all", "any", "out", "off", "more"}


def _ticket_keywords(fms: dict[str, dict]) -> list[str]:
    """Derive guidance-search keywords from assigned tickets (ids + title words)."""
    kws: list[str] = list(fms.keys())  # ticket ids
    for fm in fms.values():
        for w in re.split(r"[^A-Za-z0-9]+", fm.get("title", "").lower()):
            if len(w) >= 4 and w not in _KW_STOP and w not in kws:
                kws.append(w)
    return kws[:8]


def _body_after_frontmatter(path: Path) -> str:
    raw = path.read_text(encoding="utf-8", errors="replace")
    return re.sub(r"\A---\n.*?\n---\n", "", raw, flags=re.DOTALL).strip()


def _cross_refs(bodies: list[str], own: set[str]) -> list[str]:
    """`Related: [[T-xxxx]]` ids referenced by the assigned tickets (minus own)."""
    refs: list[str] = []
    for b in bodies:
        for m in re.findall(r"\[\[(T-\d+)\]\]", b):
            if m not in own and m not in refs:
                refs.append(m)
    return refs


def _assemble_prompt(slug: str, tickets: list[str], paths: dict[str, Path],
                     fms: dict[str, dict], role: str, report_to: str) -> str:
    """T-0149: deterministic per-task/role initial-prompt assembly.

    Composes the brief from the ticket bodies + role contract + initiative +
    cross-refs + prior stakeholder guidance (T-0151) + the hard process rules
    (no-superpowers-drift T-0152, manual-first verification T-0158, git/commit
    discipline, report-READY protocol). Replaces the hand-pasted brief so every
    spawn gets the same complete context regardless of who spawns it.
    """
    primary = tickets[0]
    role = role if role in _ROLE_FILES else "dev"
    roles_dir = Path(BOT_SQUAD) / "data" / slug / "vision" / "roles"
    role_path = roles_dir / _ROLE_FILES[role]
    role_text = role_path.read_text(encoding="utf-8", errors="replace").strip() \
        if role_path.exists() else "(role file missing)"

    bodies = {t: _body_after_frontmatter(paths[t]) for t in tickets}
    initiative = fms[primary].get("initiative") or ""
    ai_path = Path(BOT_SQUAD) / "data" / slug / "AGENT_INSTRUCTIONS.md"
    init_path = (Path(BOT_SQUAD) / "data" / slug / "vision" / "initiatives" / initiative
                 if initiative else None)

    # Prior stakeholder guidance (T-0151) folded in deterministically.
    kws = _ticket_keywords(fms)
    hits, total, _ = _collect_guidance(slug, kws, 5)
    if hits:
        guidance = "\n".join(
            f"  • [{h['source']} · {(h.get('ts') or '')[:10]}] {h['text']}" for h in hits)
        guidance = (f"Prior stakeholder guidance found for this work "
                    f"(via `bsq guidance search`, {total} hit(s); re-run for more):\n{guidance}")
    else:
        guidance = ("No prior stakeholder guidance matched. Before designing your "
                    "approach, run `bsq guidance search <keywords>` yourself with "
                    "other terms — buried guidance saves repeating questions (T-0151).")

    refs = _cross_refs(list(bodies.values()), set(tickets))
    refs_line = (f"Cross-referenced tickets (consult via `bsq ticket status <id>`): "
                 f"{', '.join(refs)}.\n\n" if refs else "")

    ticket_blocks = "\n\n".join(
        f"### {t}: {fms[t].get('title', t)}\n{bodies[t]}" for t in tickets)
    bundle_note = (f" You are bundled {len(tickets)} tickets: {', '.join(tickets)} — "
                   f"handle them together in this one session."
                   if len(tickets) > 1 else "")

    return f"""\
You are a bot-squad {role} session assigned {primary}{bundle_note}

The full scope+DoD of each assigned ticket is INLINED below — this brief is
self-contained, but FIRST also read AGENT_INSTRUCTIONS.md ({ai_path}) for
paths/git-rules and your initiative file{f' ({init_path})' if init_path else ''}.
The 'Verbatim request — source of truth' section of any ticket is HUMAN-ONLY —
never edit it.

== ASSIGNED TICKET(S) ==
{ticket_blocks}

{refs_line}== YOUR ROLE CONTRACT ({_ROLE_FILES[role]}) ==
{role_text}

== PRIOR STAKEHOLDER GUIDANCE (T-0151) ==
{guidance}

== HARD PROCESS RULES (enforced — not suggestions) ==
1. TASK MANAGEMENT VIA BOT-SQUAD TICKETS ONLY (T-0152). Do NOT write planning
   artifacts, notes, or task lists into ~/.claude/superpowers/* or other doc
   folders — that's where sessions get lost. Track all multi-step work on the
   ticket: `bsq ticket note <id> <text>` for progress, `bsq ticket update <id>
   <status>` for status. In-session TodoWrite/TaskCreate is ONLY for sub-steps
   within one ticket.
2. MANUAL-TESTING-FIRST (T-0158). For any verification DoD item: (a) write the
   user scenario in plain English (`bsq scenario new <id>` opens a template),
   (b) walk it through MANUALLY (playwright MCP or narrated scripted
   walkthrough) observing the REAL result, (c) automate ONLY after the manual
   pass. A test .mjs written before the manual walkthrough is a process
   violation.
3. GIT DISCIPLINE. Edit the shared tree directly on branch bot_squad/dev — no
   worktree, no branch switch, no git stash. Commit ONLY with `bsq commit -m
   <msg> --ack <explicit files>` (review the peer report first). Never wide-add,
   never rewrite pushed history (revert to undo), never push or merge — your
   {('TL' if role == 'dev' else 'reviewer')} reviews and deploys.
4. STAY ON TASK (T-0149). A drift-check tick monitors time-since-commit and
   time-since-progress-note. Come back to the DoD regularly; if you defer or
   descope anything, record WHY via `bsq ticket note` — don't silently drift.
5. REPORT READY. When a ticket's DoD (incl. manual walkthrough) is green:
   `bsq ticket update <id> totest`, `bsq ticket note <id> '<summary>'`, then
   `bsq peer send {report_to} 'READY <id> — <summary>'`.
6. REACHING THE STAKEHOLDER (T-0155). Bot-squad NO LONGER DMs the stakeholder on
   every idle turn. If you are genuinely blocked on HIM (not your TL) and need a
   decision, send ONE explicit `bsq tg ping '<what you need>'` — he can reply
   straight to that Telegram message and his answer lands back in this pane.
   Don't spam it. If you forget and stay blocked on him with your tmux window
   unwatched for ~15+ min, the worker auto-escalates for you — but the explicit
   ping is faster and clearer. Route routine questions to your TL via
   `bsq peer send` first.
7. REPORT FRICTION UPSTREAM (T-0154). When the process itself fights you —
   you hit the SAME workaround twice, the ticket scope conflicts with reality,
   a tool/recipe is broken or missing, or guidance is contradictory — submit it:
   `bsq feedback submit '<what bit you + what would help>'`. It lands in the
   project feedback queue for the operator to triage; don't silently absorb it.
   This is how the process improves. (Tag a use case with `--usecase <id>`.)

Run `bsq --help` for the full verb reference."""


