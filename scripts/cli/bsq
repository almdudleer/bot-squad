# user-conversation session spawn/steer a dev session DIRECTLY, or must the
# request go through the operator? The thresholds and the verdict come from the
# worker (`dispatch.decide_topology`), the SAME read the operator re-drive gate
# makes, so what a session is told here and what the scheduler does cannot
# diverge. Read-only: this verb spawns nothing.
# --------------------------------------------------------------------------

def cmd_route(args) -> None:
    slug = resolve_slug()
    res = post("topology_decision", {"slug": slug})
    if getattr(args, "json", False):
        print(json.dumps(res, indent=2, sort_keys=True))
        return
    c = res.get("counts") or {}
    t = res.get("thresholds") or {}
    ops = res.get("live_operator_sids") or []
    ucs = res.get("attending_user_session_sids") or []
    print(f"dispatch topology for {slug}:")
    print(f"  tasks in flight   : {c.get('tasks_in_flight')}  "
          f"(direct while < {t.get('max_tasks')})"
          + (f"  {', '.join(res.get('tasks_in_flight') or [])}"
             if res.get("tasks_in_flight") else ""))
    print(f"  live dev sessions : {c.get('live_devs')}  "
          f"(direct while < {t.get('max_devs')})")
    print(f"  live operator     : {ops[0] if ops else '(none)'}")
    # T-0937: the seat is the reason `tier: operator` can coexist with
    # `route: direct` — the load justifies an operator, and the board already
    # has a driver. Showing only the verdict would hide the first half.
    print(f"  operator seat     : {_seat_line(res.get('operator_seat'))}")
    print(f"  attending user s. : {ucs[0] if ucs else '(none)'}")
    # Reported because it drifts (a dev that died leaves the label behind) and
    # is the number a reader would otherwise assume this decision used.
    print(f"  board in_progress : {c.get('board_in_progress')}  "
          f"(observed only — does NOT gate)")
    if not t.get("enabled"):
        print("  direct dispatch   : DISABLED (BOT_SQUAD_DIRECT_DISPATCH)")
    print(f"  tier              : {res.get('tier')}")
    print(f"  route             : {res.get('route')}")
    print(f"  → {res.get('reason')}")


# --------------------------------------------------------------------------
# T-0932: GRADUAL BUDDING — the write side of the same scaling ladder `route`
# reads. «когда у нас одна сессия на всё, потом она может отпочковать дева а
# сама дифференцироваться чисто в юзер-сессию ... и может отпочковать оператора
# если сильно много отдельных девов и их оркестрации.»
#
# `bsq bud` (no subcommand) is the READ — which rung the project is on and
# whether this session should move. The subcommands are the deliberate moves;
# nothing here ever fires on its own (T-0929: parallelism is decided by the
# sessions themselves), the worker only ever SUGGESTS.
# --------------------------------------------------------------------------

def _bud_decision(slug: str, sid: str | None = None) -> dict:
    params = {"slug": slug}
    if sid:
        params["sid"] = sid
    return post("budding_decision", params)


def cmd_bud_status(args) -> None:
    slug = resolve_slug()
    res = _bud_decision(slug, my_sid())
    if getattr(args, "json", False):
        print(json.dumps(res, indent=2, sort_keys=True))
        return
    obs = res.get("observation") or {}
    c = obs.get("counts") or {}
    t = obs.get("thresholds") or {}
    print(f"budding ladder for {slug}:")
    print(f"  level             : {res.get('level')}")
    print(f"  bud devs          : {c.get('bud_devs')}"
          + (f"   {', '.join(obs.get('bud_dev_sids') or [])}"
             if obs.get("bud_dev_sids") else ""))
    print(f"  live operator     : {(obs.get('operator_sids') or ['(none)'])[0]}")
    # T-0937: the L2 rung has two shapes — a separate operator process, or the
    # root wearing the hat. Showing only the first would keep the ladder
    # reading as "no dispatcher" on a board that has one.
    print(f"  operator seat     : {_seat_line(obs.get('operator_seat'))}")
    print(f"  root session(s)   : {', '.join(obs.get('root_sids') or []) or '(none)'}")
    print(f"  queued requests   : {c.get('queued_requests')}  "
          f"(bud a dev at >= {t.get('request_pressure')} while you hold a task)"
          + (f"   {', '.join(obs.get('queued_requests') or [])}"
             if obs.get("queued_requests") else ""))
    print(f"  you hold          : {', '.join(obs.get('held_task_ids') or []) or '(nothing)'}")
    print(f"  verdict           : {res.get('verdict')}")
    print(f"  → {res.get('reason')}")
    if res.get("command"):
        print(f"\n  run: {res['command']}")


def _bud_morph(slug: str, sid: str, role: str, task_id: str | None = None) -> dict:
    """morph_session with this pane's identity seeded (an unregistered,
    hand-launched session has no md until the worker upserts one)."""
    params = {"slug": slug, "sid": sid, "role": role}
    if task_id:
        params["task_id"] = task_id
    win, cwd = _my_pane_fields()
    if win:
        params["window"] = win
    if cwd:
        params["cwd"] = cwd
    return post("morph_session", params)


def cmd_bud_dev(args) -> None:
    """L0 -> L1: hand the task you are holding to a DEV bud, then narrow back
    to the conversation.

    ORDER MATTERS, and not in the direction that reads safest. The shed runs
    FIRST, because `sessions.spawn` claims the task under `.task-claim.lock`
    and REFUSES a task a live session already owns — and while you still hold
    it, that live session is YOU: spawn-then-shed cannot bud at all, it dies on
    `already bound to live session <you>`.

    So this is a compensating transaction, not a two-step: shed, spawn, and on
    ANY spawn failure re-bind the task to yourself before the error propagates,
    so a failed bud never leaves work with no owner.
    """
    slug = resolve_slug()
    sid = require_sid(getattr(args, "sid", None))

    task = args.task
    if not task:
        res = _bud_decision(slug, sid)
        held = ((res.get("observation") or {}).get("held_task_ids") or [])
        if len(held) != 1:
            die(f"bud dev: name the task to hand over — this session holds "
                f"{', '.join(held) or 'nothing'}")
        task = held[0]

    # The role to restore if the spawn fails. Derived, not assumed: a session
    # that morphed to `teamlead` and took a ticket must not come back as `dev`.
    prev_role = "dev"
    try:
        for row in post("list_sessions", {"slug": slug}).get("sessions", []):
            if row.get("sid") == sid and row.get("role"):
                prev_role = row["role"]
                break
    except WorkerError:
        pass

    print(f"budding off a dev for {task} …")
    _bud_morph(slug, sid, "user-conversation")

    spawn_args = argparse.Namespace(
        ticket=task, slug=slug, bundle=None, window=args.window,
        initiative=None, owner="budding", role="dev",
        prompt=None, prompt_file=None, fresh=args.fresh, resume_sid=None,
        dry_run=False,
        # `cmd_spawn` reads these unguarded — same contract as cluster-launch.
        model=getattr(args, "model", None), why=getattr(args, "why", None),
        provider=None, effort=None,
    )
    try:
        cmd_spawn(spawn_args)
    except BaseException:
        # Roll the shed back. `die()` raises SystemExit, so this catches the
        # ordinary failure path too — a bare `except Exception` would let the
        # commonest failure strand the task with no owner.
        try:
            _bud_morph(slug, sid, prev_role, task)
            print(f"\nbud FAILED — {task} is bound back to you (role="
                  f"{prev_role}); nothing was handed over.", file=sys.stderr)
        except WorkerError as exc:
            print(f"\nbud FAILED and the re-bind of {task} ALSO failed ({exc}) "
                  f"— run `bsq morph --role {prev_role} --task {task}` yourself, "
                  f"or check who claimed it with `bsq ticket status {task}`.",
                  file=sys.stderr)
        raise

    print(f"\nyou are now role=user-conversation (task shed — the bud owns "
          f"{task} and exits when it closes; you never exit).")
    print("Go back to the user: record requests, dispatch, review. "
          "`bsq bud` to re-read the ladder.")


def cmd_bud_operator(args) -> None:
    """L1 -> L2: bud an OPERATOR off to run the devs; you stay user-facing.

    «выделение оператора (превращение себя в юзер-сессию оператора)» — after
    this you talk to the operator, not to the devs. Same spawn the 60s
    re-drive performs, under the same one-operator-per-project guard.
    """
    slug = resolve_slug()
    sid = my_sid()
    res = post("bud_operator", {"slug": slug, **({"sid": sid} if sid else {})})
    if not res.get("spawned"):
        print(f"no operator budded — {res.get('reason')}")
        return
    print(f"✔ {res.get('reason')}")

    # The parent narrows to the conversation only if it is still carrying a
    # dev task; an operator bud does not take that task, so this is a no-op for
    # a session that already sheds one (and a refusal if it does hold one —
    # hand the task to a dev bud first, that is a different rung).
    dec = _bud_decision(slug, sid) if sid else {}
    held = ((dec.get("observation") or {}).get("held_task_ids") or [])
    if held:
        print(f"note: you still hold {', '.join(held)} — an operator bud does "
              f"not take it. `bsq bud dev {held[0]}` if you want that off your "
              f"hands too.")


def cmd_bud_absorb(args) -> None:
    """L1 -> L0 deflation: take the last queued task yourself instead of
    paying for a second process. The ladder sliding back down."""
    slug = resolve_slug()
    sid = require_sid(getattr(args, "sid", None))
    task = args.task
    if not task:
        res = _bud_decision(slug, sid)
        queued = ((res.get("observation") or {}).get("queued_requests") or [])
        if len(queued) != 1:
            die(f"bud absorb: name the task to take — {len(queued)} queued "
                f"request(s) ({', '.join(queued) or 'none'})")
        task = queued[0]
    # Resolve it against THIS board before binding (T-0892), so an absorb can
    # never bind a same-numbered ticket from another project.
    _slug, tid, _path = resolve_ticket_ref(task, slug, verb="bud absorb")
    res = _bud_morph(slug, sid, "dev", tid)
    print(f"absorbed {tid}: you are now role={res.get('role')} holding it. "
          f"Read the ticket and build — `bsq bud dev {tid}` hands it off again "
          f"if the user starts queueing requests.")


def _pickup_scope_lines(ds: dict) -> list:
    """The drive-scope header of the `bsq pickup` table (T-0829).

    Renders from the `drive_scope` block the action already returns, and prints
    NOTHING when no scope is configured — see `cmd_pickup`. Deliberately terser
    than the operator brief's version: a human reading a table needs to know that
    a filter ran, which one, and what it is not showing him; the operator needs
    to be told what it may not conclude from an empty queue.
    """
    if not ds or not (ds.get("configured") or ds.get("problem")):
        return []
    statuses = ", ".join(ds.get("statuses") or ())
    words = ds.get("source_text")
    head = f"drive scope: {ds.get('scope')} ({statuses})"
    if words:
        head += f" — set from «{words}»"
    elif ds.get("set_at"):
        head += f" — set {ds['set_at']}"
    lines = [head]
    if ds.get("problem"):
        # The stored value did not take effect. Never report the fallback as if
        # it were the setting — show the raw value so he can see the typo.
        lines.append(f"  ! the configured scope DID NOT take effect: {ds['problem']}"
                     f" — showing the widest scope instead")
    withheld, residue = ds.get("out_of_scope") or 0, ds.get("triage_in_scope") or 0
    if withheld or residue:
        lines.append(f"  {withheld} ticket(s) outside this scope are not listed · "
                     f"{residue} in scope need triage (an empty queue here does "
                     f"NOT mean the scope is done)")
    return lines


def cmd_pickup(args) -> None:
    """T-0783a: show which board tickets are takeable, and which need triage.

    `--brief` prints the exact block the operator re-drive injects, so what a
    human reads here and what a re-driven operator is told can never drift apart.

    T-0829: the DEFAULT table names the active drive scope too. `--brief` got it
    for free (the server renders it), but this renderer is the one a human types,
    and under a narrowed scope it otherwise printed "1 takeable · 4 need triage ·
    782 excluded" with nothing saying a filter had run — «нужно более чёткое
    понимание для меня, какой режим драйва щас стоит» reproduced on the surface
    he actually uses. An UNSET scope prints nothing: `configured` exists to tell
    "never set" from "deliberately widest", and a default view that announces a
    mode he never chose invents a setting instead of reporting one.
    """
    slug = resolve_slug()
    band = "triage" if args.triage else ("pickup" if not args.all else None)
    params = {"slug": slug}
    if band:
        params["band"] = band
    res = post("pickup_queue", params)

    if args.brief:
        print(res.get("brief") or "")
        return

    counts = res.get("counts") or {}
    for line in _pickup_scope_lines(res.get("drive_scope") or {}):
        print(line)
    print(f"board {slug}: {counts.get('pickup', 0)} takeable · "
          f"{counts.get('triage', 0)} need triage · "
          f"{counts.get('excluded', 0)} excluded · {counts.get('board', 0)} total")
    for name, header in (("pickup", "TAKEABLE (most urgent first)"),
                         ("triage", "NEEDS TRIAGE — look before dispatching"),
                         ("excluded", "EXCLUDED")):
        rows = res.get(name)
        if rows is None:
            continue
        print(f"\n{header}: {len(rows)}")
        for r in rows:
            idle = "idle?" if r.get("idle_days") is None else f"{r['idle_days']}d"
            why = r.get("reject") or ", ".join(r.get("sanity") or []) or ""
            print(f"  {r['id']:9} {r['status']:12} P{r['effective_priority']} "
                  f"{idle:>7}  {r['title'][:58]}" + (f"\n{'':13}→ {why}" if why else ""))


#: (CLI flag attr, monitor-spec key, is-duration) — the monitor flags on
#: `routine declare` (T-0604, D-0048 §5.2). Only flags the user actually set
#: enter the spec; engine defaults apply to the rest.
_MONITOR_FLAG_SPECS = [
    ("probe", "probe", False),
    ("cmd", "cmd", False),
    ("url", "url", False),
    ("expect_status", "expect_status", False),
    ("latency_budget_ms", "latency_budget_ms", False),
    ("interval", "interval_s", True),
    ("timeout", "timeout_s", True),
    ("judge", "judge", False),
    ("threshold", "threshold", False),
    ("persist", "persist_s", True),
    ("cooldown", "cooldown_s", True),
    ("on_breach", "on_breach", False),
    ("on_recover", "on_recover", False),
]


def cmd_routine_declare(args) -> None:
    """T-0464/T-0604: declare a Routine — an instruction + a trigger that
    spawns a session to work per the instruction each time the trigger fires.

    Trigger ``schedule`` (default): a standard 5-field cron expression (UTC)
    via ``--schedule``, e.g. ``"0 9 * * *"`` (daily 09:00) — one session per
    due tick. Trigger ``monitor`` (D-0048): a code-only probe watched by the
    worker's 5s monitor tick; AI attaches only on a persist-confirmed
    threshold breach. Zero tokens while healthy."""
    slug = resolve_slug()
    trigger = (args.trigger or "schedule").strip().lower()
    params = {"slug": slug, "instruction": args.instruction, "trigger": trigger}

    monitor: dict = {}
    for attr, key, is_duration in _MONITOR_FLAG_SPECS:
        val = getattr(args, attr, None)
        if val is None:
            continue
        monitor[key] = parse_duration_s(val) if is_duration else val

    if trigger == "monitor":
        if args.schedule:
            die("--trigger monitor takes probe/judge flags, not --schedule")
        if "threshold" in monitor:
            # numeric judges want a number; regex_match keeps the string
            try:
                as_num = float(monitor["threshold"])
                monitor["threshold"] = (int(as_num) if as_num == int(as_num)
                                        else as_num)
            except ValueError:
                pass
        params["monitor"] = monitor
    else:
        if monitor:
            die(f"monitor flags ({', '.join(sorted(monitor))}) need "
                "--trigger monitor")
        if not args.schedule:
            die(f"--trigger {trigger} requires --schedule "
                "(5-field cron expression, UTC)")
        params["schedule"] = args.schedule
    if getattr(args, "title", None):
        params["title"] = args.title
    if getattr(args, "provenance", None):
        params["provenance"] = args.provenance
    res = post("routine_declare", params)
    print(f"{res['id']}  ->  {res['file_path']}  (next run: {res.get('next_run_at')})")


def _routine_print_row(r: dict, automation_paused: bool = False) -> None:
    """Render one `bsq routine list` row. Pulled out of ``cmd_routine_list``
    so a test can pin the render against a fabricated dict without hitting
    the live worker socket (T-0899; same shape as ``_pace_print_drive``).

    T-1023: ``automation_paused`` is the project's LIVE T-0929 drive-pause
    state, passed in from the caller (never inferred from a routine's own
    staleness here — a wedged sweep goes stale exactly the same way). An
    ACTIVE routine under a paused drive gets a STOOD DOWN marker carrying its
    own last reading's timestamp, so "not firing because the drive is off" and
    "not firing because it's dead" stop rendering as the same blank/errors=0
    row. A per-routine ``paused`` status already renders via ``[paused]`` and
    is deliberately left unmarked here — that is a different, already-visible
    fact, not the one this ticket is about."""
    stood_down = automation_paused and r.get("status") == "active"
    muted = ""
    if r.get("muted_until"):
        reason = f" ({r['mute_reason']})" if r.get("mute_reason") else ""
        muted = f"  MUTED until {r['muted_until']}{reason}"
    mon = r.get("monitor")
    if mon:
        spec = f"{mon.get('probe')} {mon.get('interval_s')}s"
        if mon.get("judge") and mon.get("judge") != "http":
            spec += f" {mon.get('judge')}/{mon.get('threshold')}"
        last = mon.get("last_value")
        # T-0899: a healthy routine renders exactly as before (no
        # marking — the pass leg). A probe in error gets a visible
        # marker so `last=` can't be mistaken for a fresh reading, and
        # once errors cross MONITOR_ERROR_BOUND it reads BROKEN — which
        # stays shown for as long as it's true, unlike the one-time
        # alert message, so it can't go silently blind forever.
        errors = mon.get("consecutive_errors") or 0
        # T-0999: the REASON, from the first error. The count told you a probe
        # was blind; it never told you why, and the value that says why was
        # discarded on every tick except the one-shot monitor_broken at the
        # bound — fifty minutes on a 300s interval. Truncated because a probe
        # error carries up to 200 chars of stderr and this is one line in a
        # list; the full string is in the sidecar and in the alert.
        why = mon.get("last_error")
        why = f" — {str(why)[:120]}" if why else ""
        if mon.get("broken"):
            health = (f"  BROKEN ({errors} consecutive probe errors, "
                      f"last ok value stale since "
                      f"{mon.get('last_value_at') or '—'}{why})")
        elif errors:
            health = (f"  error×{errors} (stale since "
                      f"{mon.get('last_value_at') or '—'}{why})")
        else:
            health = ""
        # T-1023: BROKEN is a fact about past probes (still true while the
        # drive happens to be paused too); STOOD DOWN is a fact about right
        # now (no probe is running, PERIOD, so `errors` is frozen rather than
        # resolved). They are independent and both render when both hold —
        # merging them into one word is the exact defect this ticket reports.
        stand = (f"  STOOD DOWN (drive paused; last probed "
                 f"{mon.get('last_probe_at') or '—'})") if stood_down else ""
        print(f"{r['id']}  [{r.get('status')}]  monitor({spec})  "
              f"last={'—' if last is None else last}{health}{stand}  "
              f"breach={'YES' if mon.get('breach') else 'no'}  "
              f"last_fire={mon.get('last_fired_at') or '—'}"
              f"{muted}  {r.get('title', '')}")
    else:
        stand = (f"  STOOD DOWN (drive paused; last run "
                 f"{r.get('last_run_at') or '—'})") if stood_down else ""
        print(f"{r['id']}  [{r.get('status')}]  "
              f"{r.get('trigger')}:{r.get('schedule')}  "
              f"next={r.get('next_run_at')}{stand}{muted}  {r.get('title', '')}")


def cmd_routine_list(args) -> None:
    """T-0464/T-0604: list declared Routines for this project.

    Monitor routines render live columns from the worker's sidecar state:
    last probed value, breach state, last fire — plus any standing mute.
    T-0899: a probe in error (or blind past MONITOR_ERROR_BOUND, BROKEN)
    is marked and its `last=` reading flagged stale — a healthy routine
    renders unmarked.

    T-1023: a project-wide T-0929 drive-pause used to leave every routine
    reading exactly where it stopped, with no marker distinguishing "the
    drive is deliberately off" from "this mechanism is dead" — the fact
    existed only in the worker's log. ``automation_paused`` is a LIVE read of
    that same pause flag; a leading banner names it once, and each ACTIVE
    routine's row gets its own STOOD DOWN marker (see ``_routine_print_row``)."""
    slug = resolve_slug()
    res = post("routine_list", {"slug": slug})
    routines = res.get("routines", [])
    if not routines:
        print("no routines declared. `bsq routine declare --help` to add one.")
        return
    automation_paused = bool(res.get("automation_paused"))
    if automation_paused:
        print("⏸ DRIVE PAUSED for this project (T-0929) — schedules don't fire "
              "and monitors aren't probed. Readings below are FROZEN where "
              "they stood, not broken; see STOOD DOWN on each active routine.")
    for r in routines:
        _routine_print_row(r, automation_paused=automation_paused)


def cmd_routine_mute(args) -> None:
    """T-0604 (linza mute semantics): silence a KNOWN breach for a duration.

    The monitor keeps probing and tracking state, but never fires — no AI
    spawn, no breach alert — until the mute expires. Duration ``0`` clears a
    standing mute; a breach still standing at expiry fires on the next tick."""
    slug = resolve_slug()
    duration_s = parse_duration_s(args.duration)
    if duration_s > 0 and not (args.reason or "").strip():
        die("mute needs a reason: bsq routine mute R-NNNN 45m 'why it is silenced'")
    params = {"slug": slug, "rid": args.rid, "duration_s": duration_s}
    if (args.reason or "").strip():
        params["reason"] = args.reason.strip()
    res = post("routine_mute", params)
    if res.get("muted_until"):
        print(f"muted {res['id']} until {res['muted_until']} — "
              "probes continue, fires suppressed")
    else:
        print(f"unmuted {res['id']} — a standing breach fires on the next tick")


def cmd_assignment_write_result(args) -> None:
    """T-0463/T-0464: write your session's RESULT back into your assignment's
    artifact so the work-product survives this disposable session.

    Works for both assignment kinds: a TASK (default) and a ROUTINE
    (``--kind routine``). The artifact is the ONE reusable seam at
    ``artifacts/<assignment-id>.md``.

    T-0892: for ``kind=task`` the assignment id IS a backlog ticket id, so it
    gets the same resolution as every other ticket-id verb — a cwd-picked slug
    files this session's work product under another project's `artifacts/`.
    ``kind=routine`` keeps `resolve_slug`: an ``R-NNNN`` is not on any backlog,
    so there is nothing for the shared resolver to look up.

    (This verb was NOT in T-0892's list of seven — that enumeration keyed on the
    argument being named `ticket`, and this one is named `--id`. Found by
    re-deriving the list from what each verb DOES.)
    """
    kind = (getattr(args, "kind", None) or "task").strip().lower()
    if kind == "task":
        slug, assignment_id, _path = resolve_ticket_ref(
            args.id, getattr(args, "slug", None), verb="assignment write-result")
    else:
        slug, assignment_id = resolve_slug(), args.id
    sid = require_sid(getattr(args, "sid", None))
    params = {"slug": slug, "assignment_id": assignment_id,
