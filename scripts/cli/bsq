def cmd_ticket_context(args) -> None:
    """T-0767: REPLACE a ticket's `## Context` — the shared working area.

    The verb whose absence caused the bloat. `bsq ticket note` was one command
    and editing the working area was a whole-body PATCH, so every session
    appended narration instead of maintaining state. This makes the right thing
    the easy thing.

    Text comes from `--file` or stdin rather than argv on purpose: a working
    area is paragraphs, and shell-quoting a multi-paragraph argument is exactly
    the friction that pushes people back to one-line notes.
    """
    slug, tid, _path = resolve_ticket_ref(
        args.id, getattr(args, "slug", None), verb="ticket context")
    if args.file:
        text = Path(args.file).read_text(encoding="utf-8")
    elif not sys.stdin.isatty():
        text = sys.stdin.read()
    else:
        die("no text: pass --file <path> or pipe the new Context on stdin "
            "(use --clear to empty the section)")
    if args.clear:
        text = ""
    # T-0938: pass the SID so the ticket-update fan-out knows who wrote this and
    # doesn't nudge you about your own Context write. `require_sid` is
    # non-fatal here on purpose — a write from outside tmux still lands, it is
    # just unattributed (and its author gets one redundant nudge).
    res = post("task_context_set", {"slug": slug, "task_id": tid, "text": text,
                                    "sid": _sid_or_blank(args.sid)})
    print(f"context set on {slug}/{tid} ({res.get('bytes_written', 0)} bytes of body)")
    _print_fanout(res, tid)
    _print_rollback(res)


def cmd_ticket_summary(args) -> None:
    """T-0863: REPLACE a ticket's `## Executive summary` — the status paragraph.

    The section written for the STAKEHOLDER, not for your successor: «жестко
    один параграф, который в задаче буду читать я, и там именно не в чем суть
    задачи, а какой прогресс по ней уже сделан, и что осталось». So say where
    the work STANDS — done, in flight, what remains — and do not restate the
    ask; he reads that in `## Stakeholder notes` and opens `## Context` when he
    wants the detail.

    Text comes from argv here, unlike `bsq ticket context`, and the asymmetry
    is the point: one paragraph is quotable on a command line, and needing a
    file for it would push people back to a progress note. `--file` and stdin
    still work for the awkward-quoting cases.
    """
    slug, tid, _path = resolve_ticket_ref(
        args.id, getattr(args, "slug", None), verb="ticket summary")
    if args.clear:
        text = ""
    elif args.file:
        text = Path(args.file).read_text(encoding="utf-8")
    elif (args.text or "").strip():
        text = args.text
    elif not sys.stdin.isatty():
        text = sys.stdin.read()
    else:
        die("no text: pass the paragraph as an argument, use --file <path>, "
            "pipe it on stdin, or --clear to empty the section")
    res = post("task_summary_set", {"slug": slug, "task_id": tid, "text": text,
                                    "sid": _sid_or_blank(args.sid)})  # T-0938
    print(f"executive summary set on {slug}/{tid} "
          f"({res.get('bytes_written', 0)} bytes of body)")
    _print_fanout(res, tid)
    _print_rollback(res)


