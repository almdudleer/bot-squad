def cmd_topic_say(args) -> None:
    """Post directly into a forum topic (T-0660 Phase 2, direct-write).

    Two ways to name the destination:

    * `bsq topic say <TICKET> "<msg>"` — resolved from the ticket id (the topic
      must already exist, `bsq topic create ... --ticket <id>`). The original
      form: a dev/TL/orchestrator session posting into ITS OWN task's topic.
    * `bsq topic say --chat <id> --topic <n> "<msg>"` — the destination SPELLED
      OUT (T-0770). This is what answers a stakeholder message that arrived in
      a session-bound topic, and it is why the flags exist: every resolving form
      (`--ticket`, and `bsq tg ping`'s rung-3 lookup) picks the FIRST binding
      that names the session, so a session holding two direct-mode topics
      answers in the wrong one — measured on the live bindings of the very
      incident T-0770 was filed for. A direct-mode topic also frequently has no
      ticket_id at all (`/pin-session` sets only the session), so there is
      nothing for the resolving form to key on.

    Either way the send is tagged with this session's SID, so he sees who is
    writing and a reply to it routes straight back to this pane.
    """
    sid = require_sid(args.sid)
    words = list(args.words)
    explicit = bool(args.chat) or args.topic is not None
    if explicit:
        if not args.chat or args.topic is None:
            die("topic say: --chat and --topic go together (a thread id is only "
                "meaningful inside its own chat)")
        ticket = ""
        message = " ".join(words).strip()
    else:
        ticket = words[0]
        message = " ".join(words[1:]).strip()
    if not message:
        die("topic say: empty message")
    params = {"message": message, "sid": sid, "urgent": bool(args.urgent)}
    if explicit:
        params["chat_id"] = str(args.chat)
        params["topic_id"] = int(args.topic)
        where = f"chat={args.chat} topic={args.topic}"
    else:
        params["ticket_id"] = ticket
        where = f"topic for ticket={ticket}"
    res = post("tg_notify", params)
    if res.get("sent"):
        print(f"posted to {where} (sid={sid})")
    else:
        print("post suppressed (no bot token, debounce, or quiet hours) — not sent. "
              "Reply will still route back to this session if it lands.")


def _print_recycle_redirect(res: dict) -> None:
    """T-0790: surface a peer_send that was routed past a RECYCLED target.

    The SID you addressed no longer holds a session; the message went to the
    live holder of its window instead. Printed because a silent redirect is the
    same class of problem as the silent loss it replaces — the sender has to
    learn that the SID it is carrying is stale.
    """
    redirected = res.get("redirected") or {}
    if not redirected.get("to"):
        return
    print(f"⚠ {redirected.get('from')} was RECYCLED "
          f"({redirected.get('reason', 'stale')}) — routed to its live successor "
          f"{redirected['to']}; update the SID you're using")


def cmd_peer_send(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    params = {"slug": slug, "from_sid": from_sid, "to": args.to, "text": args.text}
    # T-0157: --user widens role-keyword fan-out (teamlead/dev/all) to another
    # linux user's sessions. Without it, role keywords stay scoped to the
    # sender's own user. Ignored for a literal-SID target (always explicit).
    if getattr(args, "user", None):
        params["user"] = args.user
    # T-0977: --blocked is THE stall-watchdog trigger. Until that ticket the
    # watchdog guessed from the recipient's role, so every report filed to the
    # operator armed a page about a lane that was not blocked on anything.
    if getattr(args, "blocked", False):
        params["blocked"] = True
    res = post("peer_send", params)
    delivered = res.get("delivered_to", [])
    _print_recycle_redirect(res)
    print(f"sent to {len(delivered)} inbox(es): {', '.join(delivered) or '(none)'}")
    if getattr(args, "blocked", False) and delivered:
        print("marked BLOCKED: you are recorded as stopped until one of the above "
              "replies. Escalates upstream if nobody does; clears when they reply "
              "or when your pane resumes work.")

    if args.no_signal or not delivered:
        return
    # Primary cross-session signal: nudge each live recipient pane with the
    # "check mail" payload so the peer drains its inbox without an armed
    # long-poll. Best-effort — recipients without a live pane (suspended /
    # non-tmux) just pick the message up on their next `bsq inbox check`.
    nudged, skipped = [], []
    for rsid in delivered:
        if rsid == from_sid:
            continue
        try:
            post("inject_input", {"sid": rsid, "text": MAIL_SIGNAL}, fatal=False)
            nudged.append(rsid)
        except WorkerError:
            skipped.append(rsid)
    if nudged:
        print(f"signalled: {', '.join(nudged)}")
    if skipped:
        print(f"no live pane (will read on next check): {', '.join(skipped)}")


# --------------------------------------------------------------------------
# sync — synchronous inter-session channel (T-0498, M6/F6.2)
# --------------------------------------------------------------------------
# request -> ack -> both enter -> live 2-way `send`, closing on exit/timeout.
# Built on the async substrate (D-0037): the handshake notices + messages ride
# the durable inbox bus, and `bsq` additionally injects them straight into the
# peer's terminal (the "talking directly without interruptions" delivery).
def _sync_deliver(notify: dict | None) -> None:
    """Best-effort: drop a sync notify line into the peer's terminal pane.

    The durable copy already landed in the peer's inbox (the worker action used
    intersession.send); this is the live terminal delivery. A peer with no live
    pane (suspended / non-tmux) just reads it on its next `bsq inbox check`.
    """
    if not notify or not notify.get("sid"):
        return
    rsid = notify["sid"]
    try:
        post("inject_input", {"sid": rsid, "text": notify["text"]}, fatal=False)
        print(f"delivered to {rsid}'s terminal")
    except WorkerError:
        print(f"no live pane for {rsid} (will read on next inbox check)")


