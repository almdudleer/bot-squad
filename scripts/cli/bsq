#: How many stated reasons the compliance view lists. The number itself is the
#: signal; the reasons are a sample for judging whether they are real.
_MODEL_COMPLIANCE_REASONS_SHOWN = 5


def cmd_model_compliance(args) -> None:
    """T-0909: what the last N dispatches actually ran, off the shared ledger.

    This is the DoD's verification instrument and the operator's drift signal.
    It reads `data/_worker/model_dispatch.ndjson` (written by every spawn and
    resume) rather than `data/*/sessions/*.md` — session mds are DELETED when a
    session is reaped, which is exactly how this ticket's first pass measured
    "zero explicit model choices, ever" against a journal that said 104.
    """
    res = post("model_compliance", {
        "limit": args.limit,
        "role": args.role,
        "kinds": args.kinds,
        **({"slug": args.slug} if getattr(args, "slug", None) else {}),
    })
    n = res.get("n") or 0
    print(res.get("summary") or "")
    if not n:
        return
    by_source = res.get("by_source") or {}
    if by_source:
        print("  by source:   " + ", ".join(
            f"{k}={v}" for k, v in sorted(by_source.items(), key=lambda kv: -kv[1])))
    # T-0909 follow-up: WHO dispatched. `source` says chosen-vs-defaulted; this
    # says which surface asked, and it is the line that explains a stubborn
    # default — the measurement behind it found 87 of 123 role-default dev
    # spawns were autocompact RELAUNCHES rather than anybody's dispatch.
    by_producer = res.get("by_producer") or {}
    if by_producer:
        print("  by producer: " + ", ".join(
            f"{k}={v}" for k, v in sorted(by_producer.items(), key=lambda kv: -kv[1])))
    window = f"{res.get('oldest_ts', '')[:16]} .. {res.get('newest_ts', '')[:16]}"
    print(f"  window:      {window}")
    reasons = res.get("premium_reasons") or []
    if reasons:
        # Only dispatches that STATED a reason are listed, newest last, capped.
        # The rest are counted on one line. Measured while walking this through:
        # printing every premium dispatch put 20 lines of "(none recorded)" into
        # the operator's session-start banner — the pre-gate and automated
        # dispatches are the majority, and they have nothing to read.
        stated = [r for r in reasons if (r.get("reason") or "").strip()]
        silent = len(reasons) - len(stated)
        if stated:
            shown = stated[-_MODEL_COMPLIANCE_REASONS_SHOWN:]
            print(f"  premium dispatches with a stated reason "
                  f"({len(stated)}, showing {len(shown)}):")
            for r in shown:
                label = r.get("task_id") or r.get("window") or "?"
                print(f"    - {r.get('ts','')[:16]} {label} "
                      f"[{r.get('model','?')}]: {r.get('reason').strip()}")
        if silent:
            print(f"  premium with NO stated reason: {silent} "
                  f"(a config default, an automated dispatch, or pre-T-0909)")


