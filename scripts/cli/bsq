def cmd_scenario_new(args) -> None:
    slug = resolve_slug()
    ticket = args.ticket.strip()
    path = find_ticket(slug, ticket)  # validates the ticket exists
    fm = read_frontmatter(path)
    stem = path.stem
    feature = stem.split("-", 2)[2] if stem.count("-") >= 2 else stem
    scen_dir = Path(BOT_SQUAD) / "data" / slug / "scenarios"
    scen_dir.mkdir(parents=True, exist_ok=True)
    out = scen_dir / f"{ticket}-{feature}.md"
    if out.exists() and not args.force:
        print(f"scenario already exists: {out}\n(edit it, or pass --force to overwrite)")
        return
    out.write_text(_SCENARIO_TEMPLATE.format(
        ticket=ticket, title=fm.get("title", ticket), sid=my_sid() or "?"))
    print(f"scenario template written: {out}\nfill it in, then walk it through MANUALLY before automating.")


