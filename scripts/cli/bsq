# --------------------------------------------------------------------------
# worker socket transport
# --------------------------------------------------------------------------
class _UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, sock_path: str, timeout: float):
        super().__init__("localhost", timeout=timeout)
        self._sock_path = sock_path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self._sock_path)
        self.sock = s


class WorkerError(Exception):
    """A worker action failed (transport or 4xx). Caught by best-effort callers."""


def post(action: str, params: dict, timeout: float = 35.0, fatal: bool = True) -> dict:
    """POST params to /actions/<action> over the worker unix socket.

    On failure: exit with a message when ``fatal`` (the default), else raise
    ``WorkerError`` so best-effort callers (e.g. the peer-send nudge) can
    swallow it quietly.
    """
    def fail(msg: str) -> None:
        if fatal:
            die(msg)
        raise WorkerError(msg)

    if not os.path.exists(WORKER_SOCK):
        fail(f"worker socket not found: {WORKER_SOCK} (is the worker running?)")
    conn = _UnixHTTPConnection(WORKER_SOCK, timeout=timeout)
    raw, status = "", 0
    try:
        conn.request(
            "POST",
            f"/actions/{action}",
            body=json.dumps(params),
            headers={"Content-Type": "application/json"},
        )
        resp = conn.getresponse()
        raw = resp.read().decode("utf-8", errors="replace")
        status = resp.status
    except OSError as e:
        fail(f"worker call failed ({action}): {e}")
    finally:
        conn.close()

    try:
        data = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        fail(f"worker returned non-JSON for {action} (HTTP {status}): {raw[:200]}")
        data = {}
    if status != 200:
        detail = data.get("detail", raw) if isinstance(data, dict) else raw
        fail(f"worker rejected {action}: {detail}")
    return data


# --------------------------------------------------------------------------
# context resolution: slug + own SID
# --------------------------------------------------------------------------
def resolve_slug(cwd: str | None = None) -> str:
    cwd = cwd or os.getcwd()
    real_cwd = os.path.realpath(cwd)
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
    except OSError as e:
        die(f"cannot read {PROJECTS_TOML}: {e}")

    def _match(target: str) -> bool:
        if not target:
            return False
        rt = os.path.realpath(target)
        t = target.rstrip("/")
        return (
            cwd == target
            or cwd.startswith(t + "/")
            or real_cwd == rt
            or real_cwd.startswith(rt + "/")
        )

    for slug, p in cfg.get("projects", {}).items():
        for key in ("repo_path", "repo_master", "repo_workspace"):
            if _match(p.get(key, "")):
                return slug
    die(f"CWD {cwd} is not inside any registered project (see {PROJECTS_TOML})")


def my_sid() -> str | None:
    """Compute this session's SID from tmux (mirrors hook_my_sid.sh).

    ``BSQ_SID`` overrides, for callers that have no tmux to be asked — the
    T-0891 project-resolution tests drive the real CLI as a subprocess, and a
    guard whose decisive signal cannot be set in a test is a guard nobody has
    watched fail.
    """
    env_sid = os.environ.get("BSQ_SID", "").strip()
    if env_sid:
        return env_sid
    hook = f"{BOT_SQUAD}/scripts/hooks/hook_my_sid.sh"
    if os.path.exists(hook):
        try:
            out = subprocess.run([hook], capture_output=True, text=True, timeout=5)
            if out.returncode == 0 and out.stdout.strip():
                return out.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    # Inline fallback.
    if not os.environ.get("TMUX"):
        return None
    try:
        user = subprocess.run(["id", "-un"], capture_output=True, text=True).stdout.strip() or "u"
        user = re.sub(r"[^A-Za-z0-9_]", "_", user)
        target = ["-t", os.environ["TMUX_PANE"]] if os.environ.get("TMUX_PANE") else []
        window = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#W"],
            capture_output=True, text=True,
        ).stdout.strip()
        window = re.sub(r"[^A-Za-z0-9_-]", "_", window)
        pane = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#{pane_id}"],
            capture_output=True, text=True,
        ).stdout.strip().lstrip("%")
        if window and pane:
            return f"S-{user}-{window}-p{pane}"
    except (OSError, KeyError):
        pass
    return None


def require_sid(explicit: str | None) -> str:
    sid = explicit or my_sid()
    if not sid:
        die("could not determine SID from tmux — pass --sid <SID> explicitly")
    return sid


def _sid_or_blank(explicit: str | None = None) -> str:
    """This session's SID, or "" when it can't be resolved (T-0938).

    The soft sibling of `require_sid`. Used where the SID is ATTRIBUTION rather
    than identity — the ticket writers pass it so the ticket-update fan-out
    doesn't nudge you about your own write. A write from outside tmux must still
    land; it is simply unattributed, and its author gets one redundant nudge.
    """
    return explicit or my_sid() or ""


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------
def die(msg: str, code: int = 2) -> None:
    print(f"bsq: {msg}", file=sys.stderr)
    sys.exit(code)


def parse_duration_s(text: str) -> int:
    """'30s' / '15m' / '2h' / '1d' (or bare seconds) -> whole seconds."""
    m = re.fullmatch(r"(\d+)([smhd]?)", str(text or "").strip().lower())
    if not m:
        die(f"bad duration {text!r} — use e.g. 30s / 15m / 2h / 1d")
    return int(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def backlog_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "backlog"


def find_ticket(slug: str, ticket: str) -> Path:
    """Resolve a ticket id to its backlog md (T-0231).

    Multiple files can share a numeric filename prefix — a genuine id
    collision, or a tombstone left behind after a renumber. Plain
    ``sorted(glob(...))​[0]`` silently resolves to whichever sorts first,
    which caused two real incidents (T-0030, T-0222) where `bsq ticket
    status/update/note` silently landed on the WRONG ticket. Disambiguate by
    re-reading each candidate's own ``id:`` frontmatter: the tombstone
    convention stamps a deliberately non-matching id (e.g.
    ``T-0030-DUPLICATE-DO-NOT-USE``) precisely so it's skipped here,
    regardless of alphabetical sort order.
    """
    matches = sorted(backlog_dir(slug).glob(f"{ticket}-*.md"))
    if not matches:
        die(f"ticket not found: {ticket} (looked in {backlog_dir(slug)})")
    if len(matches) == 1:
        return matches[0]
    exact = [p for p in matches if read_frontmatter(p).get("id") == ticket]
    if len(exact) == 1:
        return exact[0]
    die(
        f"ticket id collision: {ticket} matches {len(matches)} files and "
        f"{len(exact)} declare id: {ticket} in frontmatter (need exactly 1) — "
        f"{', '.join(str(p) for p in matches)} (see T-0231)"
    )


# --------------------------------------------------------------------------
# WHICH PROJECT does a ticket id belong to (T-0891)
# --------------------------------------------------------------------------
# T-0231 made `find_ticket` strict about picking the right file WITHIN one
# project. It cannot see the other half of the problem: the same `T-NNNN`
# exists in several projects (measured 2026-08-15 on this install: 480 of 883
# distinct ids live in more than one slug), the slug was picked from `$PWD`
# alone, and nothing in the output named it. So a session working a watchrobot
# ticket that `cd`s into the bot-squad repo — which it MUST, to commit code
# that lives there — silently addressed bot-squad's same-numbered ticket. That
# happened for real on 2026-08-14: `## Executive summary` and `## Context` of a
# closed foreign ticket were REPLACED and the originals are gone, because
# `data/` is outside git.
#
# The fix is a second, cd-immune signal. A session is REGISTERED under the slug
# it was spawned for (`data/<slug>/sessions/<SID>.md`); that binding does not
# move when the session changes directory, so it is the one signal that
# disagrees with `$PWD` exactly in the situation that goes wrong. Rules below
# in `resolve_ticket_ref`.

def registered_slugs() -> list[str]:
    """Every project slug in the registry, in file order."""
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
    except OSError as e:
        die(f"cannot read {PROJECTS_TOML}: {e}")
    return list(cfg.get("projects", {}))


def resolve_slug_soft(cwd: str | None = None) -> str | None:
    """`resolve_slug` that returns None instead of exiting.

    A cwd outside every registered project is a normal state here (a session
    running from its scratchpad) — it means "no signal", not "fatal".
    """
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
    except OSError:
        return None
    cwd = cwd or os.getcwd()
    real_cwd = os.path.realpath(cwd)

    def _match(target: str) -> bool:
        if not target:
            return False
        rt = os.path.realpath(target)
        t = target.rstrip("/")
        return (
            cwd == target
            or cwd.startswith(t + "/")
            or real_cwd == rt
            or real_cwd.startswith(rt + "/")
        )

    for slug, p in cfg.get("projects", {}).items():
        for key in ("repo_path", "repo_master", "repo_workspace"):
            if _match(p.get(key, "")):
                return slug
    return None


def session_slug(sid: str | None = None) -> str | None:
    """The slug THIS SESSION was spawned under, from its registry md.

    Immune to `cd` — which is the entire point: it is the only signal that
    still says "watchrobot" while `$PWD` says "bot-squad".
    """
    sid = sid or my_sid()
    if not sid:
        return None
    for slug in registered_slugs():
        if (Path(BOT_SQUAD) / "data" / slug / "sessions" / f"{sid}.md").exists():
            return slug
    return None


def split_ticket_ref(ref: str) -> tuple[str, str | None]:
    """``T-0655@watchrobot`` -> ``('T-0655', 'watchrobot')``; plain id -> slug None."""
    ref = (ref or "").strip()
    tid, sep, slug = ref.partition("@")
    return tid.strip(), (slug.strip() or None) if sep else None


def _ticket_file_in(slug: str, ticket: str) -> Path | None:
    """The ticket's file inside `slug`, or None. Never exits (unlike find_ticket)."""
    d = backlog_dir(slug)
    if not d.is_dir():
        return None
    matches = sorted(d.glob(f"{ticket}-*.md"))
    if not matches:
        return None
    if len(matches) == 1:
        return matches[0]
    exact = [p for p in matches if read_frontmatter(p).get("id") == ticket]
    return exact[0] if len(exact) == 1 else matches[0]


def _ticket_title(path: Path) -> str:
    return str(read_frontmatter(path).get("title", "") or "").strip()


def _candidate_projects(ticket: str) -> list[tuple[str, Path]]:
    """(slug, path) for every registered project holding this id."""
    out = []
    for slug in registered_slugs():
        p = _ticket_file_in(slug, ticket)
        if p is not None:
            out.append((slug, p))
    return out


def _refuse_ambiguous(ticket: str, candidates: list[tuple[str, Path]],
                      why: str, verb: str = "ticket <verb>") -> None:
    """Refuse, and hand back the command that would have worked (T-0892).

    The escape hatch is printed as the verb the caller actually typed. It used
    to be hardcoded `bsq ticket <verb>`, which was right while only `bsq ticket`
    resolved ids and became a wrong instruction the moment `spawn`,
    `scenario new`, `docs link` and `cluster-launch` started refusing too — a
    refusal that names the wrong verb costs the reader another round trip,
    which is the tax that gets guards removed.
    """
    lines = [
        f"refusing to guess which project {ticket} means — {why}.",
        "",
        f"{ticket} exists in {len(candidates)} projects:",
    ]
    for slug, path in candidates:
        title = _ticket_title(path)
        lines.append(f"  {slug:14s} {title[:72]}")
        lines.append(f"  {'':14s} {path}")
    lines += [
        "",
        f"Name the project explicitly and re-run `bsq {verb}` with either:",
        f"  the ticket id suffixed:  {ticket}@{candidates[0][0]}",
        f"  or the flag:             --slug {candidates[0][0]}",
    ]
    die("\n".join(lines), code=3)


def resolve_ticket_ref(ref: str, explicit_slug: str | None = None,
                       *, verb: str = "ticket", announce: bool = True
                       ) -> tuple[str, str, Path]:
    """Resolve a ticket reference to (slug, ticket_id, path) — or refuse.

    Order of authority:

    1. **Explicit** — ``T-0655@watchrobot`` or ``--slug/--project``. Always
       obeyed; the caller has said which board they mean.
    2. **The session's own project**, from the session registry. Wins over
       ``$PWD``, because ``$PWD`` is what moves when you go and commit code in
       another repo. If the cwd names a DIFFERENT project that also holds this
       id, the two signals conflict and we refuse — that conflict is precisely
       the 2026-08-14 incident.
    3. **`$PWD`**, and only when the id is unique across projects. A colliding
       id backed by nothing but the cwd is refused (this ticket's DoD 3).

    Nothing here is silent: the resolved slug and file are announced on stderr
    BEFORE the caller writes, so a wrong target is visible in the transcript
    even on the paths that legitimately pass. stderr rather than stdout so
    `--json` output stays machine-parseable and the announcement survives a
    pipe that swallows stdout.
    """
    tid, ref_slug = split_ticket_ref(ref)
    if not tid:
        die(f"empty ticket id in {ref!r}")
    if ref_slug and explicit_slug and ref_slug != explicit_slug:
        die(f"conflicting project: {ref!r} says {ref_slug!r} but "
            f"--slug says {explicit_slug!r} — pass one of them")
    chosen = ref_slug or explicit_slug

    if chosen:
        known = registered_slugs()
        if chosen not in known:
            die(f"unknown project slug {chosen!r} — registered: {', '.join(known)}")
        path = find_ticket(chosen, tid)
        if announce:
            _announce_target(verb, chosen, tid, path, "explicit")
        return chosen, tid, path

    candidates = _candidate_projects(tid)
    if not candidates:
        die(f"ticket not found in any registered project: {tid} "
            f"(looked in {', '.join(registered_slugs())})")
    cand_slugs = {s for s, _ in candidates}
    by_slug = dict(candidates)

    sess = session_slug()
    cwd = resolve_slug_soft()

    if sess and sess in cand_slugs:
        if cwd and cwd != sess and cwd in cand_slugs:
            _refuse_ambiguous(
                tid, candidates,
                f"your session belongs to {sess!r} but your cwd is in {cwd!r}, "
                f"and both hold this id", verb)
        if announce:
            _announce_target(verb, sess, tid, by_slug[sess], "your session's project")
        return sess, tid, by_slug[sess]

    if sess and sess not in cand_slugs:
        _refuse_ambiguous(
            tid, candidates,
            f"your session belongs to {sess!r}, which has no {tid} — so this "
            f"would write to another project's board", verb)

    if cwd and cwd in cand_slugs:
        if len(candidates) > 1:
            _refuse_ambiguous(
                tid, candidates,
                "the only signal is your cwd, and this id is not unique", verb)
        if announce:
            _announce_target(verb, cwd, tid, by_slug[cwd], "cwd (id is unique)")
        return cwd, tid, by_slug[cwd]

    if len(candidates) == 1 and not sess and not cwd:
        slug, path = candidates[0]
        if announce:
            _announce_target(verb, slug, tid, path, "only project holding this id")
        return slug, tid, path

    _refuse_ambiguous(
        tid, candidates,
        "no session binding and no cwd inside a registered project", verb)


def _announce_target(verb: str, slug: str, ticket: str, path: Path,
                     basis: str) -> None:
    """DoD 1: name the slug and the FILE before the write, never after.

    «context set on T-0655» is what the incident printed, and it is true of
    both tickets. Print what distinguishes them.
    """
    title = _ticket_title(path)
    head = f"bsq {verb}: {ticket} -> project {slug} ({basis})"
    print(head, file=sys.stderr)
    if title:
        print(f"  title: {title[:96]}", file=sys.stderr)
    print(f"  file:  {path}", file=sys.stderr)


def _project_flag(p) -> None:
    """T-0891/T-0892: say WHICH project's board, when the id is not unique.

    Equivalent to the ``T-0655@watchrobot`` suffix every ticket-id argument
    accepts; both exist because the incident this guards against was a session
    typing a bare id while standing in another project's repo.
    """
    p.add_argument(
        "--slug", "--project", dest="slug",
        help="project slug this ticket id belongs to (same as T-NNNN@<slug>)")


def resolve_bundle_ids(slug: str, raw: str | None, primary: str,
                       *, verb: str) -> list[str]:
    """The EXTRA ids of a ``--bundle``, all checked against ONE board (T-0892).

    A session is bound to one project, so a bundle spanning two boards has no
    correct reading: half its ids would bind to tickets that do not exist under
    the slug the session actually runs in. An explicit ``@other`` inside a
    bundle entry is therefore refused rather than honoured — the alternative is
    a paid session bound to a ticket nobody meant.

    The primary id is dropped if it is repeated in the bundle (callers pass the
    seed in both places), and each remaining id is resolved with `find_ticket`,
    which dies naming the board it looked in.
    """
    out: list[str] = []
    for entry in (raw or "").split(","):
        entry = entry.strip()
        if not entry:
            continue
        bid, bslug = split_ticket_ref(entry)
        if bslug and bslug != slug:
            die(f"bsq {verb}: --bundle names {entry!r}, but this session binds to "
                f"project {slug!r} — one session, one board. Spawn a separate "
                f"session for {bslug}'s tickets.")
        if bid == primary or bid in out:
            continue
        find_ticket(slug, bid)  # dies with a clear message if this board lacks it
        out.append(bid)
    return out


def _load_frontmatter():
    """Load the sibling ``frontmatter.py`` helper (T-1047) — the ONE md
    frontmatter parser/writer (T-0075), byte-identical to
    ``worker/bot_squad_worker/frontmatter.py`` and pinned against it by the
    module-mirror gate.

    Loaded the same way as ``task_search.py``/``priority.py`` (see
    ``_load_task_search`` below): the worker package is not importable from
    here, and a hand-rolled second parser is exactly the drift this ticket
    exists to end — bsq's own "key: value lines only" reader mis-parsed
    folded scalars, quoted-scalar escapes and block-style lists on 458 of 950
    live ticket titles."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    p = Path(__file__).resolve().parent / "frontmatter.py"
    if "bsq_frontmatter" in sys.modules:
        return sys.modules["bsq_frontmatter"]
    loader = SourceFileLoader("bsq_frontmatter", str(p))
    spec = importlib.util.spec_from_loader("bsq_frontmatter", loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["bsq_frontmatter"] = mod
    loader.exec_module(mod)
    return mod


def read_frontmatter(path: Path) -> dict:
    """A ticket/session md's frontmatter, via the shared pyyaml parser (T-1047).

    Used to be a "key: value lines only" flat reader that mis-parsed pyyaml's
    own output on four independent axes: a scalar folded past 80 columns read
    truncated (title 458/950 live tickets, gate_reason 3/3); a quoted scalar's
    internal escapes came back mangled instead of unescaped (T-0013); a
    block-style list read as completely empty (30 tickets); and a nested
    mapping (``session_history_ts``) couldn't be represented at all. Real
    pyyaml — the same parser the writers use — has none of those failure
    modes by construction, so this now delegates to it instead of patching
    each one.
    """
    text = path.read_text()
    parsed = _load_frontmatter().parse_or_none(text)
    return parsed[0] if parsed else {}


# T-0591 (F3.3): non-placeholder Verbatim discipline on stakeholder-sourced
# tasks. `_action_task_new`'s stub body always seeds `## Verbatim request`
# with a literal "(filed via task_new)" placeholder — the caller is expected
# to come back and paste the real words (D-0047 F3.3: "population is
# per-caller, not enforced"). This regex catches that seed plus the sibling
# entity_new placeholders (doc_new/uc_new/flow_new/initiative_new) in case one
# ever lands on a task body by mistake.
_VERBATIM_PLACEHOLDER_RE = re.compile(
    r"^\(filed via [a-z_]+(?: — [^)]*)?\)$", re.IGNORECASE
)


def _extract_md_section(body: str, heading: str) -> str:
    """Text of a `## <heading>` section — from the matching heading line up to
    the next heading (or EOF). Case-insensitive substring match on the
    heading text. Empty string if the heading isn't present. Shared by
    `_scan_md_section` (keyword search), the F3.3 verbatim gate, and the
    session-history Progress-line index (T-0591)."""
    lines = body.splitlines()
    out, collecting = [], False
    for ln in lines:
        is_heading = bool(re.match(r"^#+\s", ln))
        if is_heading and heading.lower() in ln.lower():
            collecting = True
            continue
        if collecting and is_heading:
            break
        if collecting:
            out.append(ln)
    return "\n".join(out).strip()


def _md_body(path: Path) -> str:
    """A backlog/session md's body text, frontmatter stripped."""
    raw = path.read_text(encoding="utf-8", errors="replace")
    return re.sub(r"\A---\n.*?\n---\n", "", raw, flags=re.DOTALL)


def _extract_verbatim_section(path: Path) -> str:
    """Raw text of a ticket's `## Verbatim request` section. Empty string if
    the section is missing or blank."""
    return _extract_md_section(_md_body(path), "verbatim request")


def _verbatim_is_placeholder(text: str) -> bool:
    """True for an empty Verbatim section or a known `(filed via ...)` stub —
    i.e. text that is NOT the stakeholder's actual words."""
    t = text.strip()
    return not t or bool(_VERBATIM_PLACEHOLDER_RE.match(t))


def _is_stakeholder_provenance(provenance: str) -> bool:
    return any(
        tok.strip().lower().startswith("stakeholder:")
        for tok in (provenance or "").split(",")
    )


