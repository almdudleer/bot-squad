def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="bsq",
        description="Slim bot-squad CLI for agents — wraps worker-socket actions "
                    "as kubectl-style verbs. Canonical agent reference.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  bsq inbox check                  drain new peer mail\n"
            "  bsq peer send teamlead 'READY T-0146 — shipped, sha abc123'\n"
            "  bsq spawn T-0150 --bundle T-0151,T-0152\n"
            "  bsq team status\n"
            "  bsq compact\n"
            "  bsq commit --ack -m 'fix: thing' path/to/file.py\n\n"
            "The 'check mail' tmux signal: `bsq peer send` nudges each live\n"
            "recipient pane with the text 'check mail' — that is an agent's\n"
            "cue to run `bsq inbox check`. The long-poll watcher\n"
            "(`bsq inbox wait`) is opt-in only."
        ),
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    # inbox
    inbox = sub.add_parser("inbox", help="peer inbox: check / wait")
    inbox_sub = inbox.add_subparsers(dest="sub", required=True)
    c = inbox_sub.add_parser("check", help="drain new peer messages for this session")
    c.add_argument("--since", help="only show messages with ISO ts >= this")
    c.add_argument("--sid", help="override this session's SID")
    c.add_argument("--json", action="store_true", help="raw JSON output")
    c.add_argument("--envelopes", action="store_true",
                   help="show only structured dispatch envelopes (T-0144)")
    c.set_defaults(func=cmd_inbox_check)
    w = inbox_sub.add_parser("wait", help="opt-in long-poll until mail arrives")
    w.add_argument("--timeout", default=1800, type=float, help="seconds (default 1800)")
    w.add_argument("--sid", help="override this session's SID")
    w.set_defaults(func=cmd_inbox_wait)

    # peer
    peer = sub.add_parser("peer", help="peer messaging")
    peer_sub = peer.add_subparsers(dest="sub", required=True)
    ps = peer_sub.add_parser("send", help="send a message + signal the recipient pane")
    ps.add_argument("to", help="target SID or role keyword (teamlead/dev/all)")
    ps.add_argument("text", help="message text")
    ps.add_argument("--from", dest="from_sid", help="override sender SID")
    ps.add_argument("--no-signal", action="store_true",
                    help="skip the 'check mail' tmux nudge")
    ps.set_defaults(func=cmd_peer_send)

    # dispatch (structured operator → TL envelope, T-0144)
    dp = peer_sub.add_parser("dispatch",
                             help="send a typed dispatch envelope (action + payload)")
    dp.add_argument("to", help="target SID or role keyword (teamlead/dev/all)")
    dp.add_argument("action", help="dispatch action (assign/archive_team/status/message)")
    dp.add_argument("--field", action="append", metavar="K=V",
                    help="payload key=value (repeatable)")
    dp.add_argument("--json", help="payload as a JSON object (merged under --field)")
    dp.add_argument("--note", help="free-text note alongside the typed payload")
    dp.add_argument("--from", dest="from_sid", help="override sender SID")
    dp.add_argument("--no-signal", action="store_true",
                    help="skip the 'check mail' tmux nudge")
    dp.set_defaults(func=cmd_dispatch)

    # spawn
    sp = sub.add_parser("spawn", help="spawn a dev session for a backlog ticket")
    sp.add_argument("ticket", help="ticket id, e.g. T-0150")
    sp.add_argument("--bundle", help="comma-separated extra ticket ids bound to the same session")
    sp.add_argument("--window", help="tmux window name (default: ticket feature slug)")
    sp.add_argument("--initiative", help="initiative md (default: from ticket frontmatter)")
    sp.add_argument("--owner", help="UI username to stamp on the session")
    sp.add_argument("--role", default="dev", choices=["dev", "tl", "teamlead", "operator"],
                    help="role contract to assemble into the prompt (default dev)")
    sp.add_argument("--prompt", help="custom initial prompt (overrides deterministic assembly)")
    sp.add_argument("--prompt-file", help="read initial prompt from a file")
    sp.add_argument("--dry-run", action="store_true", help="print params without spawning")
    sp.set_defaults(func=cmd_spawn)

    # team
    team = sub.add_parser("team", help="session roster (composes with T-0142)")
    team_sub = team.add_subparsers(dest="sub", required=True)
    ts = team_sub.add_parser("status", help="list this project's sessions")
    ts.add_argument("--all", action="store_true", help="include suspended sessions")
    ts.add_argument("--json", action="store_true", help="raw JSON output")
    ts.set_defaults(func=cmd_team_status)
    tlst = team_sub.add_parser("list", help="list persisted Team rosters (T-0142)")
    tlst.add_argument("--json", action="store_true", help="raw JSON output")
    tlst.set_defaults(func=cmd_team_list)
    ta = team_sub.add_parser("archive", help="true-archive a session (suspend + archive)")
    ta.add_argument("sid", help="target session SID")
    ta.set_defaults(func=cmd_team_archive)
    tr = team_sub.add_parser("resurrect", help="bring a session back (unarchive + resume)")
    tr.add_argument("sid", help="target session SID")
