def cmd_inbox_check(args) -> None:
    slug = resolve_slug()
    sid = require_sid(args.sid)
    res = post("peer_inbox_read", {"slug": slug, "sid": sid})
    messages = res.get("messages", [])
    if args.since:
        messages = [m for m in messages if m.split("\t", 1)[0] >= args.since]
    if args.json:
        print(json.dumps({"sid": sid, "messages": messages, "count": len(messages)}))
        return
    if not messages:
        print("(no new mail)")
        return
    for m in messages:
        env = _extract_envelope(m)
        if env and getattr(args, "envelopes", False):
            # Envelope-only view: print the typed action + payload compactly.
            print(f"[dispatch:{env.get('action')}] {json.dumps(env.get('payload', {}))}"
                  + (f"  note={env.get('note')}" if env.get("note") else ""))
            continue
        print(m)
        if env:
            print(f"    ⤷ dispatch action={env.get('action')} "
                  f"payload={json.dumps(env.get('payload', {}))}"
                  + (f" note={env.get('note')}" if env.get("note") else ""))


def cmd_inbox_wait(args) -> None:
    slug = resolve_slug()
    sid = require_sid(args.sid)
    timeout = float(args.timeout)
    res = post(
        "peer_inbox_wait",
        {"slug": slug, "sid": sid, "timeout": timeout},
        timeout=timeout + 15,
    )
    if res.get("ready"):
        print("mail ready — run `bsq inbox check`")
    else:
        reason = res.get("reason", "timeout")
        print(f"(no mail; {reason} after {res.get('elapsed_sec', 0):.0f}s)")


# --------------------------------------------------------------------------
# Structured dispatch envelope (T-0144)
# --------------------------------------------------------------------------
# Operator → TL hand-offs used to be free text the TL had to parse by eye,
# which was unreliable. A dispatch is now a typed envelope: a one-line marker
# + single-line JSON `{action, payload, note}`, embedded in the peer message so
# it still rides the normal inbox/`check mail` bus. The marker is greppable and
# the JSON parses with a plain split — see vision/roles/teamlead.md for the
# action vocabulary (assign / archive_team / status / message).
ENVELOPE_MARKER = "[[bsq-dispatch v1]]"


def _format_envelope(action: str, payload: dict, note: str | None) -> str:
    body = {"action": action, "payload": payload or {}}
    if note:
        body["note"] = note
    return ENVELOPE_MARKER + json.dumps(body, separators=(",", ":"))


def _extract_envelope(text: str) -> dict | None:
    idx = text.find(ENVELOPE_MARKER)
    if idx < 0:
        return None
    raw = text[idx + len(ENVELOPE_MARKER):].strip()
    try:
        obj = json.loads(raw)
        return obj if isinstance(obj, dict) and "action" in obj else None
    except (json.JSONDecodeError, ValueError):
        return None


def cmd_dispatch(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    payload: dict = {}
    if args.json:
        try:
            payload = json.loads(args.json)
        except json.JSONDecodeError as e:
            die(f"--json is not valid JSON: {e}")
        if not isinstance(payload, dict):
            die("--json payload must be a JSON object")
    for kv in (args.field or []):
        if "=" not in kv:
            die(f"--field expects key=value, got {kv!r}")
        k, _, v = kv.partition("=")
        payload[k.strip()] = v
    text = _format_envelope(args.action, payload, args.note)
    res = post(
        "peer_send",
        {"slug": slug, "from_sid": from_sid, "to": args.to, "text": text},
    )
    delivered = res.get("delivered_to", [])
    print(f"dispatched [{args.action}] to {len(delivered)} inbox(es): "
          f"{', '.join(delivered) or '(none)'}")
    if args.no_signal or not delivered:
        return
    for rsid in delivered:
        if rsid == from_sid:
            continue
        try:
            post("inject_input", {"sid": rsid, "text": MAIL_SIGNAL}, fatal=False)
        except WorkerError:
            pass


def cmd_tg_ping(args) -> None:
    """Explicitly DM the stakeholder on Telegram (T-0155).

    This is the ONLY agent-initiated TG path — there is no implicit per-idle
    flood any more. Use it when you genuinely need the stakeholder's input and
    don't want to wait for the 15-min stall watchdog to escalate for you.

    The message is prefixed with this session's SID, so the stakeholder can
    reply to the TG message and have his answer land back in this tmux pane.
    """
    slug = resolve_slug()
    sid = require_sid(args.sid)
    message = " ".join(args.message).strip()
    if not message:
        die("tg ping: empty message")
    res = post("tg_notify", {"slug": slug, "message": message, "sid": sid,
                             "urgent": bool(args.urgent)})
    if res.get("sent"):
        print(f"tg ping sent (slug={slug}, sid={sid})")
    else:
        print("tg ping suppressed (no bot token, debounce, or quiet hours) — "
              "not sent. Reply will still route if a prior message went out.")


def cmd_page_channel(args) -> None:
    """Show or set the human-page channel mode (T-0610).

    Default routing is TG-primary with MAX as automatic reserve. The
    stakeholder can ask (in the TG thread) to temporarily switch pages to MAX
    — the attendant runs `bsq page-channel max --by stakeholder`; `bsq
    page-channel auto` reverts. Mode persists across worker restarts.
    """
    if args.mode:
        res = post("page_channel", {"mode": args.mode, "by": args.by})
        print(f"page channel set: {res.get('mode')} (by={res.get('set_by') or '?'})")
    else:
        res = post("page_channel", {})
        print(f"page channel mode: {res.get('mode')}")


def cmd_topic_bind(args) -> None:
    """Bind a Telegram (chat_id, thread_id) to a project (T-0639).

    The runtime, configurable surface the stakeholder explicitly asked for
    ("не HardCotion, настраиваемо через чат ID") — a topic->project binding
    is set here, at runtime, never hardcoded. A project may have MULTIPLE
    bound (chat_id, thread_id) entries; rebinding one replaces it.
    """
    thread_id = None if args.thread_id in (None, "", "none", "None") else args.thread_id
    res = post("tg_topic_bind", {
        "chat_id": args.chat_id, "thread_id": thread_id, "slug": args.slug,
    })
    b = res.get("binding", {})
    print(f"bound chat_id={args.chat_id} thread_id={thread_id} -> slug={b.get('slug')}")


def cmd_topic_unbind(args) -> None:
    """Clear a (chat_id, thread_id) topic binding (T-0639). Idempotent."""
    thread_id = None if args.thread_id in (None, "", "none", "None") else args.thread_id
    res = post("tg_topic_unbind", {"chat_id": args.chat_id, "thread_id": thread_id})
    if res.get("cleared"):
        print(f"unbound chat_id={args.chat_id} thread_id={thread_id}")
    else:
        print(f"no binding existed for chat_id={args.chat_id} thread_id={thread_id} (no-op)")


def cmd_topic_list(args) -> None:
    """List every current (chat_id, thread_id) -> project topic binding."""
    res = post("tg_topic_list", {})
    bindings = res.get("bindings", {})
    if not bindings:
        print("no topic bindings set")
        return
    for key, rec in bindings.items():
        chat_id, _, thread_id = key.partition(":")
        extra = ""
        if rec.get("ticket_id") or rec.get("session_id"):
            extra = f"  ticket_id={rec.get('ticket_id')} session_id={rec.get('session_id')}"
        print(f"chat_id={chat_id}  thread_id={thread_id or '(none)'}  -> slug={rec.get('slug')}{extra}")


def cmd_peer_send(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    params = {"slug": slug, "from_sid": from_sid, "to": args.to, "text": args.text}
    # T-0157: --user widens role-keyword fan-out (teamlead/dev/all) to another
    # linux user's sessions. Without it, role keywords stay scoped to the
    # sender's own user. Ignored for a literal-SID target (always explicit).
    if getattr(args, "user", None):
        params["user"] = args.user
    res = post("peer_send", params)
    delivered = res.get("delivered_to", [])
    print(f"sent to {len(delivered)} inbox(es): {', '.join(delivered) or '(none)'}")

    if args.no_signal or not delivered:
        return
    # Primary cross-session signal: nudge each live recipient pane with the
    # "check mail" payload so the peer drains its inbox without an armed
    # long-poll. Best-effort — recipients without a live pane (suspended /
    # non-tmux) just pick the message up on their next `bsq inbox check`.
    nudged, skipped = [], []
    for rsid in delivered:
        if rsid == from_sid:
            continue
        try:
            post("inject_input", {"sid": rsid, "text": MAIL_SIGNAL}, fatal=False)
            nudged.append(rsid)
        except WorkerError:
            skipped.append(rsid)
    if nudged:
        print(f"signalled: {', '.join(nudged)}")
    if skipped:
        print(f"no live pane (will read on next check): {', '.join(skipped)}")


# --------------------------------------------------------------------------
# sync — synchronous inter-session channel (T-0498, M6/F6.2)
# --------------------------------------------------------------------------
# request -> ack -> both enter -> live 2-way `send`, closing on exit/timeout.
# Built on the async substrate (D-0037): the handshake notices + messages ride
# the durable inbox bus, and `bsq` additionally injects them straight into the
# peer's terminal (the "talking directly without interruptions" delivery).
def _sync_deliver(notify: dict | None) -> None:
    """Best-effort: drop a sync notify line into the peer's terminal pane.

    The durable copy already landed in the peer's inbox (the worker action used
    intersession.send); this is the live terminal delivery. A peer with no live
    pane (suspended / non-tmux) just reads it on its next `bsq inbox check`.
    """
    if not notify or not notify.get("sid"):
        return
    rsid = notify["sid"]
    try:
        post("inject_input", {"sid": rsid, "text": notify["text"]}, fatal=False)
        print(f"delivered to {rsid}'s terminal")
    except WorkerError:
        print(f"no live pane for {rsid} (will read on next inbox check)")


def cmd_sync_request(args) -> None:
    slug = resolve_slug()
    from_sid = require_sid(args.from_sid)
    params = {"slug": slug, "from_sid": from_sid, "to": args.to}
    if args.reason:
        params["reason"] = args.reason
    if args.ttl is not None:
        params["ttl"] = float(args.ttl)
    res = post("sync_request", params)
    cid = res["channel_id"]
    print(f"sync channel {cid} requested with {res['responder']} (status: {res['status']})")
    print(f"  peer acks with: bsq sync ack {cid}")
    if not args.no_signal:
        _sync_deliver(res.get("notify"))


def cmd_sync_ack(args) -> None:
    slug = resolve_slug()
    sid = require_sid(args.sid)
