# --------------------------------------------------------------------------
# feedback verb (T-0154) — friction-submission channel for in-project agents.
# Audit item 8 (Fork-4): writes a first-class `F-*.md` FeedbackFile DIRECTLY
# into data/<slug>/feedback/, replacing the old inbox.log line-queue. The cut
# removes the "user-feedback" constant-team firehose (auto-ticketed every line,
# bypassing the operator's Occam prune) and the side-effecting `list_feedback`
# read-time materialize — the operator's promote/dismiss path is now the single
# triage gate. --usecase still threads the note into that use case's md so the
# next testing run sees it (T-0159 integration).
# --------------------------------------------------------------------------
def _feedback_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "feedback"


_INBOX_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}")


def _render_feedback_md(ts: str, sid: str, text: str, uc: str) -> tuple[str, str]:
    """Pure renderer → ``(filename, file_content)`` for a submitted note.

    The name is content-hash keyed so an accidental double-submit dedupes; the
    body carries an H1 title (with any leading ``[TAG]`` stripped) so the API's
    promote path derives a sensible task title. Frontmatter mirrors the shape
    the old API-side materializer wrote (``source``/``submitted_at``/
    ``submitted_by``) plus the optional use-case link. No ``status`` key — its
    absence means "open/visible" to ``list_feedback`` (item 12 sets a status
    only on promote/dismiss)."""
    line = f"{ts} | {sid} | {('uc=' + uc + ' | ') if uc else ''}{text}"
    digest = hashlib.sha256(line.encode("utf-8")).hexdigest()[:10]
    date = ts[:10] if _INBOX_DATE_RE.match(ts) else "queue"
    name = f"F-{date}-bsq-{digest}.md"
    title = re.sub(r"^\[[^\]]*\]\s*", "", text).strip()
    if len(title) > 80:
        # summary heading only — full text rides in the body; mark the clip
        # so it never reads as the complete note (F-2026-07-05-bsq-30844bca41)
        title = title[:79].rstrip() + "…"
    title = title or "feedback submission"
    fm_lines = [
        "---",
        "source: bsq feedback",
        f"submitted_at: {ts}",
        f"submitted_by: {sid}",
    ]
    if uc:
        fm_lines.append(f"use_case: {uc}")
    fm_lines.append("---")
    content = (
        "\n".join(fm_lines) + "\n\n"
        f"# {title}\n\n"
        f"Submitted via `bsq feedback` at {ts} by `{sid}`.\n\n"
        f"{text}\n"
    )
    return name, content


def cmd_feedback_submit(args) -> None:
    slug = resolve_slug()
    text = " ".join(args.message).strip().replace("\n", " ")
    if not text:
        die("feedback message must not be empty")
    sid = args.sid or my_sid() or "?"
    ts = _utc_now()
    uc = (args.usecase or "").strip()

    name, content = _render_feedback_md(ts, sid, text, uc)
    fb_dir = _feedback_dir(slug)
    fb_dir.mkdir(parents=True, exist_ok=True)
    path = fb_dir / name
    # atomic dir-write (tmp + replace) so a host-uid submit and a container-uid
    # promote/dismiss never half-write; identical re-submits overwrite cleanly.
    tmp = fb_dir / (name + ".tmp")
    tmp.write_text(content, encoding="utf-8")
    os.replace(tmp, path)
    print(f"feedback filed → {path}")

    if uc:
        try:
            _attach_feedback_to_usecase(slug, uc, ts, sid, text)
            print(f"attached to use case {uc}")
        except WorkerError as e:
            print(f"(note: could not attach to use case {uc}: {e})")


# --------------------------------------------------------------------------
# usecase verbs (T-0159) — use cases / user flows as first-class storage, with
# TL tooling to launch testing-dev sessions against them. Storage lives at
# data/<slug>/use_cases/<id>.md.
# --------------------------------------------------------------------------
def _usecases_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "use_cases"


def _usecase_path(slug: str, uc_id: str) -> Path:
    uc_id = uc_id.strip()
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$", uc_id):
        die(f"invalid use-case id {uc_id!r} (allowed: letters, digits, - _ .)")
    return _usecases_dir(slug) / f"{uc_id}.md"


def _find_usecase(slug: str, uc_id: str) -> Path:
    p = _usecase_path(slug, uc_id)
    if not p.exists():
        die(f"use case not found: {uc_id} (looked in {_usecases_dir(slug)})")
    return p


_FEEDBACK_HEADING = "## Feedback"


def _attach_feedback_to_usecase(slug: str, uc_id: str, ts: str, sid: str, text: str) -> None:
    p = _usecase_path(slug, uc_id)
    if not p.exists():
        raise WorkerError(f"use case {uc_id} does not exist")
    body = p.read_text(encoding="utf-8")
    entry = f"- [{ts} · {sid}] {text}\n"
    if _FEEDBACK_HEADING in body:
        # Insert directly under the heading line.
        body = re.sub(
            rf"({re.escape(_FEEDBACK_HEADING)}\n)",
            rf"\1{entry}",
            body, count=1,
        )
    else:
        body = body.rstrip() + f"\n\n{_FEEDBACK_HEADING}\n{entry}"
    _write_atomic(p, body)


def cmd_usecase_new(args) -> None:
    slug = resolve_slug()
    p = _usecase_path(slug, args.id)
    if p.exists() and not args.force:
        print(f"use case already exists: {p}\n(edit it, or pass --force to overwrite)")
        return
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(_USECASE_TEMPLATE.format(
        id=args.id.strip(), title=args.title or args.id.strip()))
    print(f"use case written: {p}\nfill in persona/goal/success-criteria + steps, then `bsq usecase run {args.id}`.")


def cmd_usecase_list(args) -> None:
    slug = resolve_slug()
    d = _usecases_dir(slug)
    files = sorted(d.glob("*.md")) if d.exists() else []
    if args.json:
        out = []
        for f in files:
            fm = read_frontmatter(f)
            out.append({"id": f.stem, "title": fm.get("title", f.stem),
                        "status": fm.get("status", ""), "goal": fm.get("goal", "")})
        print(json.dumps(out, indent=2))
        return
    if not files:
        print(f"(no use cases yet — `bsq usecase new <id>` to add one in {d})")
        return
    rows = [("ID", "STATUS", "TITLE")]
    for f in files:
        fm = read_frontmatter(f)
        rows.append((f.stem, fm.get("status", "") or "-", fm.get("title", f.stem)))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)))


def _usecase_section(body: str, heading: str) -> str:
    """Return the text under a `## heading` up to the next `## ` (or EOF)."""
    m = re.search(rf"^{re.escape(heading)}\s*\n(.*?)(?=^\#\# |\Z)", body,
                  re.MULTILINE | re.DOTALL)
    return m.group(1).strip() if m else ""


def cmd_usecase_run(args) -> None:
    slug = resolve_slug()
    path = _find_usecase(slug, args.id)
    fm = read_frontmatter(path)
    body = _body_after_frontmatter(path)
    uc_id = path.stem

    steps = _usecase_section(body, "## Steps") or "(no steps recorded — see use case md)"
    feedback = _usecase_section(body, _FEEDBACK_HEADING)
    feedback_block = (
        f"\n\nPRIOR FEEDBACK on this use case — verify each item is addressed, "
        f"and flag any that regressed:\n{feedback}\n"
        if feedback else ""
    )
    report_to = args.report_to or my_sid() or "<your TL SID>"
    window = args.window or f"uctest-{uc_id}"[:40]

    brief = _USECASE_TEST_BRIEF.format(
        slug=slug, uc_id=uc_id, title=fm.get("title", uc_id),
        persona=fm.get("user_persona", "(unspecified)"),
        goal=fm.get("goal", "(unspecified)"),
        preconditions=fm.get("preconditions", "(unspecified)"),
        success_criteria=fm.get("success_criteria", "(unspecified)"),
        related=fm.get("related_tickets", "(none)"),
        steps=steps, feedback_block=feedback_block, report_to=report_to,
    )

    if args.dry_run:
        print(brief)
        return

    params = {"slug": slug, "window": window, "initial_prompt": brief}
    if args.owner:
        params["owner"] = args.owner
    # T-0128: stamp the spawning session's SID as the testing-dev's parent_sid.
    _self_sid = my_sid()
    if _self_sid:
        params["parent_sid"] = _self_sid
    res = post("spawn_session", params, timeout=90)
    print(f"spawned testing-dev {res.get('sid')} for use case {uc_id} (window={window})")


