def cmd_doc_sync(args) -> None:
    """Symlink data/<slug>/docs/ into the dev + master clones (T-0172).

    So `cat ~/<project>/dev/docs/architecture/...md` works for any agent
    running with a clone as cwd, without copying the docs out of bot-squad.
    """
    slug = resolve_slug()
    docs_target = _docs_dir(slug)
    docs_target.mkdir(parents=True, exist_ok=True)
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
    except OSError as e:
        die(f"cannot read {PROJECTS_TOML}: {e}")
    proj = cfg.get("projects", {}).get(slug, {})
    clones = [proj.get(k) for k in ("repo_path", "repo_master")]
    made = 0
    for clone in clones:
        if not clone:
            continue
        link = Path(clone) / "docs"
        if link.is_symlink():
            if os.path.realpath(link) == os.path.realpath(docs_target):
                print(f"ok (already linked): {link} -> {docs_target}")
                continue
            link.unlink()
        elif link.exists():
            print(f"SKIP {link}: a real directory/file already exists there "
                  f"(not clobbering — move it into {docs_target} first)", file=sys.stderr)
            continue
        if not Path(clone).is_dir():
            print(f"SKIP {clone}: clone dir does not exist", file=sys.stderr)
            continue
        link.symlink_to(docs_target)
        print(f"linked: {link} -> {docs_target}")
        made += 1
    print(f"docs sync done ({made} new symlink(s)).")


