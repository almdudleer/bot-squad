    bd_sub = bd.add_subparsers(dest="bud_cmd")
    bdd = bd_sub.add_parser(
        "dev",
        help="hand the task you hold to a DEV bud, then narrow back to the "
             "conversation (L0 -> L1)")
    bdd.add_argument("task", nargs="?",
                     help="task to hand over (default: the one you hold)")
    bdd.add_argument("--window", help="tmux window name for the bud")
    bdd.add_argument("--model", help="model override for the bud (T-0909 rules apply)")
    bdd.add_argument("--why", metavar="REASON",
                     help="why the bud needs a premium model (T-0909)")
    bdd.add_argument("--fresh", action="store_true",
                     help="skip the expert scan — force a fresh bud")
    bdd.add_argument("--sid", help="session SID (default: derived from tmux)")
    bdd.set_defaults(func=cmd_bud_dev)
    bdo = bd_sub.add_parser(
        "operator",
        help="bud an OPERATOR off to run the devs; you stay user-facing (L1 -> L2)")
    bdo.set_defaults(func=cmd_bud_operator)
    bda = bd_sub.add_parser(
        "absorb",
        help="deflation: take the last queued task yourself instead of a "
             "second process (L1 -> L0)")
    bda.add_argument("task", nargs="?",
                     help="task to take (default: the single queued one)")
    bda.add_argument("--sid", help="session SID (default: derived from tmux)")
    bda.set_defaults(func=cmd_bud_absorb)

    # pickup (T-0783a) — which tickets are takeable. `operator status` reports a
    # COUNT of pending work; this reports WHICH work, which is the question an
    # operator (or the stakeholder, when he ends up dispatching by hand) has.
    pu = sub.add_parser(
        "pickup",
        help="which board tickets are takeable right now (+ which need triage)")
    pu.add_argument("--triage", action="store_true",
                    help="show only the triage band (suspect priority / stale / another project's)")
    pu.add_argument("--all", action="store_true",
                    help="show every band, including the excluded tickets and why each was excluded")
    pu.add_argument("--brief", action="store_true",
                    help="print the exact block the operator re-drive injects")
    pu.set_defaults(func=cmd_pickup)

    # edit-begin (T-0215) — snapshot a baseline for a later `commit --hunks`
    eb = sub.add_parser(
        "edit-begin",
        help="snapshot files' baseline BEFORE editing, for a later `commit --hunks`")
    eb.add_argument("--sid", help="session SID (default: derived from tmux)")
    eb.add_argument("files", nargs="+", help="files to baseline before editing")
    eb.set_defaults(func=cmd_edit_begin)

    # verify-isolated (T-0752) — run a suite against HEAD, not the shared tree
    vi = sub.add_parser(
        "verify-isolated",
        help="run a command against a clean `git archive` extract of a ref "
             "(a worktree suite run does not certify a commit)")
    vi.add_argument("--ref", default="HEAD", help="ref to extract (default HEAD)")
    vi.add_argument("--keep", action="store_true",
                    help="leave the tree in place and print its path")
    vi.add_argument("--with-git", action="store_true",
                    help="T-1010: materialise the ref as a real CHECKOUT "
                         "(clone at the sha) instead of a `git archive` "
                         "extract, so tests needing `.git` RUN instead of "
                         "skipping. Same isolation, plus the VCS metadata.")
    # build-api (T-1005) — the weaker arm: retain, then rebuild
    ba = sub.add_parser(
        "build-api",
        help="T-1005: rebuild the api image, retaining the one it replaces "
             "(the strong arm is verify-isolated, which retains at "
             "measurement time)")
    ba.add_argument("--image", default="bot-squad-api:latest",
                    help="image reference being rebuilt (default "
                         "bot-squad-api:latest)")
    ba.add_argument("--service", default="bot-squad-api",
                    help="compose service to build (default bot-squad-api)")
    ba.add_argument("--no-build", action="store_true",
                    help="retain the current image and stop — no rebuild")
    ba.set_defaults(func=cmd_build_api)

    vi.add_argument("--image", default=None,
                    help="T-1001: the docker image reference this run uses, "
                         "when the argv is too exotic to parse. It is "
                         "replaced by the immutable image id before exec.")
    vi.add_argument("cmd", nargs=argparse.REMAINDER,
                    help="command to run inside the extract (after --)")
    vi.set_defaults(func=cmd_verify_isolated)

    # commit
    # T-0482: user-controlled execution pace (Process Paradigm M3 / F3.4).
    pace = sub.add_parser(
        "pace",
        help="user-controlled execution pace: show / set / drive / initiative / pause / resume")
    pace_sub = pace.add_subparsers(dest="sub", required=True)
    pcs = pace_sub.add_parser("show", help="print this project's pace-control config")
    pcs.set_defaults(func=cmd_pace_show)
    pcset = pace_sub.add_parser("set", help="set the global max-in-progress ceiling (0=unlimited)")
    pcset.add_argument("--max-in-progress", type=int, default=None,
                       help="max tasks kept in the in_progress board state (0 = unlimited)")
    pcset.set_defaults(func=cmd_pace_set)
    # T-0828 / D-0069: the standing per-project DRIVE MODE. Under the existing
    # `pace` verb deliberately — a new CLI noun would be the second settings
    # surface both T-0823 and T-0800 warn against creating.
    pcd = pace_sub.add_parser(
        "drive", help="set the standing drive mode: scope x stopping condition")
    pcd.add_argument("--scope", choices=list(_PACE_DRIVE_SCOPES), default=None,
                     help="which ticket statuses are in play (default: all = today's behaviour)")
    pcd.add_argument("--stop-when", dest="stop_when", choices=list(_PACE_DRIVE_STOP_WHEN),
                     default=None, help="when the drive stops (default: scope_exhausted)")
    pcd.add_argument("--on-stop", dest="on_stop", choices=list(_PACE_DRIVE_ON_STOP),
                     default=None, help="what happens AT the stop (default: nothing)")
    pcd.add_argument("--source-text", dest="source_text", default=None,
                     help="the words that set it, VERBATIM — printed back by `bsq pace show` "
                          "so the person who asked can see their instruction landed")
    pcd.add_argument("--clear", action="store_true",
                     help="drop the drive block entirely (back to defaults)")
    pcd.add_argument("--sid", help="attributing SID (default: derived from tmux)")
    pcd.set_defaults(func=cmd_pace_drive)
    pci = pace_sub.add_parser("initiative", help="steer one initiative's weight / priority / pause")
    pci.add_argument("name", help="initiative basename (e.g. process-paradigm or process-paradigm.md)")
    pci.add_argument("--weight", type=float, default=None, help="relative drain weight (default 1.0)")
    pci.add_argument("--priority", type=int, default=None, help="order rank, higher = sooner (default 0)")
    pci.add_argument("--pause", action="store_true", help="pause just this initiative's tasks")
    pci.add_argument("--resume", action="store_true", help="resume this initiative's tasks")
    pci.set_defaults(func=cmd_pace_initiative)
    pcc = pace_sub.add_parser("clear", help="drop one initiative's pace entry (revert to defaults)")
    pcc.add_argument("name", help="initiative basename")
    pcc.set_defaults(func=cmd_pace_clear)
    pcp = pace_sub.add_parser("pause", help="GLOBAL pause — stop the operator re-drive starting new work")
    pcp.add_argument("--reason", default="", help="optional note recorded with the pause")
    pcp.add_argument("--sid", help="attributing SID (default: derived from tmux)")
    pcp.set_defaults(func=cmd_pace_pause)
    pcr = pace_sub.add_parser("resume", help="clear the GLOBAL operator pause")
    pcr.set_defaults(func=cmd_pace_resume)
    # T-0929: the named drive states + the one automation-visibility read.
    pcst = pace_sub.add_parser(
        "state",
        help="set the project's drive state: one-task | finish-up | all-tasks | off")
    pcst.add_argument(
        "state",
        help="one_task (finish one before starting another) | finish_up (close "
             "what is in progress, take nothing new) | all_tasks (drive the "
             "backlog end to end) | off (THE switch — nothing automatic runs). "
             "Dashes are accepted for underscores.")
    pcst.add_argument("--because", help="the words that set it, stored verbatim "
                                        "so every surface can say why")
    pcst.set_defaults(func=cmd_pace_state)
    pcsu = pace_sub.add_parser(
        "status",
        help="is anything automatic running for this project, and in what mode")
    pcsu.set_defaults(func=cmd_pace_status)

    cm = sub.add_parser("commit", help="stage explicit paths + safe-commit")
    cm.add_argument("-m", "--message", required=True, help="commit message")
    cm.add_argument("--ack", action="store_true",
                    help="acknowledge the peer-activity report (BOT_SQUAD_ACK_PEERS=1)")
    cm.add_argument(
        "--hunks", action="store_true",
        help="T-0215: commit ONLY this session's hunks (the diff since "
             "`bsq edit-begin`) in <files>, isolating a peer's edits that were "
             "already there at edit-begin — NOT ones they add afterwards (T-0752)")
    cm.add_argument("--sid", help="session SID for --hunks (default: derived from tmux)")
    cm.add_argument(
        "--patch", metavar="FILE",
        help="T-0732: post-hoc --hunks — you forgot `bsq edit-begin`, so hand it a "
             "patch of just YOUR hunks; it is applied onto a temp index seeded from "
             "HEAD (never the shared index)")
    cm.add_argument("files", nargs="*", help="explicit file paths to stage + commit")
    cm.set_defaults(func=cmd_commit)

    cd_ = sub.add_parser(
        "clone-drift",
        help="T-0959: is this clone what deploys? (fetches origin — a stale "
             "remote-tracking ref cannot answer this)")
    cd_.set_defaults(func=cmd_drift)

    return p


def main(argv: list[str]) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main(sys.argv[1:])
