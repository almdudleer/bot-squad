    if not rows:
        print(f"(no docs yet — `bsq docs new <category> <title>` to add one in {root})")
        return
    table = [("ID", "CATEGORY", "STATUS", "TITLE")] + [
        (r["id"], r["category"], r["status"], r["title"]) for r in rows
    ]
    widths = [max(len(r[i]) for r in table) for i in range(len(table[0]))]
