#: statuses that still have a pane a user can attach to. `paused` is one: the
#: pane is open and the user can type into it, it is only Ctrl-C'd.
_ATTACHABLE_STATUSES = ("active", "paused")


def _mothership_users() -> list[dict]:
    """The mothership user records, or [] when the store is unreadable."""
    try:
        data = json.loads(
            (Path(BOT_SQUAD) / "data" / "_mothership" / "users.json").read_text())
    except (OSError, ValueError):
        return []
    users = data.get("users") if isinstance(data, dict) else None
    return [u for u in users if isinstance(u, dict)] if isinstance(users, list) else []


def _resolve_start_user(username: str | None) -> dict:
    """Which mothership user `bsq start` is starting a session FOR.

    `--user <name>` when given. Otherwise: the single user if there is only
    one, else the super-admin. Anything else is genuinely ambiguous — two
    ordinary members and no super-admin — and is refused by NAMING the
    candidates, because guessing here silently hands one person's conversation
    thread to another.
    """
    users = _mothership_users()
    if not users:
        die("no mothership users found — cannot tell whose session to start. "
            f"Expected {BOT_SQUAD}/data/_mothership/users.json")
    if username:
        want = username.strip().lower()
        for u in users:
            if str(u.get("username") or "").strip().lower() == want:
                return u
        names = ", ".join(sorted(str(u.get("username") or "?") for u in users))
        die(f"no such user {username!r}. Known users: {names}")
    if len(users) == 1:
        return users[0]
    supers = [u for u in users if u.get("is_super_admin")]
    if len(supers) == 1:
        return supers[0]
    names = ", ".join(sorted(str(u.get("username") or "?") for u in users))
    die(f"several users on this install and no single super-admin — say whose "
        f"session to start: bsq start --user <name>. Known users: {names}")


def _attach_target(row: dict) -> str:
    """`<tmux-session>:<window>` for a session row, or "" when it has no pane."""
    sess = str(row.get("tmux_session") or "").strip()
    win = str(row.get("window") or "").strip()
    if not sess or sess.startswith("("):  # "(no tmux session)" bucket
        return ""
    return f"{sess}:{win}" if win else sess


def _universal_sessions(slug: str) -> list[dict]:
    """Live user-facing sessions on this board — the ones `bsq start` counts.

    Role, not window: a session that MORPHED into `user-conversation` (the
    T-0932 budding half) is the user's session whatever its window still says,
    and a `dev_*` window is never one however it was launched.
    """
    rows = post("list_sessions", {"slug": slug}).get("sessions", [])
    return [r for r in rows
            if r.get("role") == "user-conversation"
            and str(r.get("status") or "") in _ATTACHABLE_STATUSES
            # `activity` is derived from the PANE and is forced to "suspended"
            # for every md-only row, so it is the one field that separates a
            # live session from a ZOMBIE — an md still claiming `status:
            # active` whose window the user closed. Without this, `bsq start`
            # answers "already running, go here" and points at a pane that is
            # gone, which is the one answer worse than either real branch.
            and str(r.get("activity") or "") != "suspended"
            and not r.get("archived")]


def _go_there(target: str, attach: bool) -> None:
    """Print the attach command, and — only for a real interactive terminal —
    actually take the user there.

    The TTY test is the whole safety story: an agent's tool call, a pipe or a
    cron run has no terminal, prints the command and returns, so nothing can
    hijack a non-interactive caller's process. Inside tmux we `switch-client`
    (attaching from within tmux is refused by tmux itself); outside it we
    `exec` the attach so the user's shell is replaced by the session rather
    than left waiting behind it.
    """
    print(f"\n  tmux a -t {target}\n")
    if not attach or not (sys.stdin.isatty() and sys.stdout.isatty()):
        return
    if os.environ.get("TMUX"):
        subprocess.run(["tmux", "switch-client", "-t", target], check=False)
        return
    try:
        os.execvp("tmux", ["tmux", "attach", "-t", target])
    except OSError as e:  # noqa: BLE001 — no tmux on PATH; the line above stands
        print(f"bsq: could not attach ({e}) — run the command above",
              file=sys.stderr)


def cmd_start(args) -> None:
    """T-0963: launch the project's universal session, or say where it is."""
    slug = args.slug or resolve_slug()
    attach = not getattr(args, "no_attach", False)

    running = _universal_sessions(slug)
    if running:
        # Already working — the ask is to TELL him where to go, not to spawn a
        # second one. Plural is reported honestly rather than collapsed: two
        # attendants on one board is a state he should see, not one we pick from.
        head = running[0]
        if len(running) > 1:
            print(f"{len(running)} sessions are already running for {slug}:")
            for r in running:
                print(f"  {r.get('window')}  ({r.get('sid')})"
                      f"  -> tmux a -t {_attach_target(r) or '?'}")
            return
        print(f"already running for {slug}: {head.get('window')} "
              f"({head.get('sid')})")
        target = _attach_target(head)
        if not target:
            print("bsq: that session has no live tmux pane — "
                  f"`bsq team resurrect {head.get('sid')}` to bring it back",
                  file=sys.stderr)
            return
        _go_there(target, attach)
        return

    user = _resolve_start_user(getattr(args, "user", None))
    gid = str(user.get("id") or "")
    if not gid:
        die("the resolved mothership user has no id — cannot start a session")
    print(f"no session running for {slug} — starting one for "
          f"{user.get('username') or gid} …")
    res = post("ensure_user_conversation", {"slug": slug, "global_user_id": gid})
    sid = res.get("sid")
    if not sid:
        die("the worker did not return a session id — nothing was started")

    # Re-read the roster for the pane it actually landed in: `spawn` routes the
    # window into a per-initiative sibling tmux session, so the target is not
    # derivable from the slug.
    target = ""
    for r in _universal_sessions(slug):
        if r.get("sid") == sid:
            target = _attach_target(r)
            break
    print(f"started {sid}")
    if not target:
        print("bsq: started, but its tmux pane is not visible yet — "
              "`bsq team status` in a moment", file=sys.stderr)
        return
    _go_there(target, attach)


def cmd_user_session(args) -> None:
    """T-0508 (M11/F11.1, AP#3): launch (or reuse) a dedicated user session.

    The third point of access — a global user gets a conversational attendant
    for a project. Idempotent per ``(slug, global_user_id)``: an already-live
