_KW_STOP = {"the", "and", "for", "with", "from", "into", "via", "not", "per",
            "fix", "add", "new", "use", "all", "any", "out", "off", "more"}


def _ticket_keywords(fms: dict[str, dict]) -> list[str]:
    """Derive guidance-search keywords from assigned tickets (ids + title words)."""
    kws: list[str] = list(fms.keys())  # ticket ids
    for fm in fms.values():
        for w in re.split(r"[^A-Za-z0-9]+", fm.get("title", "").lower()):
            if len(w) >= 4 and w not in _KW_STOP and w not in kws:
                kws.append(w)
    return kws[:8]


def _body_after_frontmatter(path: Path) -> str:
    raw = path.read_text(encoding="utf-8", errors="replace")
    return re.sub(r"\A---\n.*?\n---\n", "", raw, flags=re.DOTALL).strip()


def _cross_refs(bodies: list[str], own: set[str]) -> list[str]:
    """`Related: [[T-xxxx]]` ids referenced by the assigned tickets (minus own)."""
    refs: list[str] = []
    for b in bodies:
        for m in re.findall(r"\[\[(T-\d+)\]\]", b):
            if m not in own and m not in refs:
                refs.append(m)
    return refs


_H2_RE = re.compile(r"^## .*$", re.MULTILINE)
_PROGRESS_BRIEF_CAP = 15
_PROGRESS_BRIEF_CHAR_BUDGET = 20_000


def _cap_progress_for_brief(body: str, max_entries: int = _PROGRESS_BRIEF_CAP,
                            char_budget: int = _PROGRESS_BRIEF_CHAR_BUDGET) -> str:
    """Trim a ticket's ``## Progress`` feed before inlining the body into a
    spawn brief (T-0852): at most ``max_entries`` lines, and further trimmed
    from the old end if even that many still exceeds ``char_budget``.

    The Progress feed is append-only and never pruned (T-0238) — on a
    long-lived ticket it grows without bound, and `_assemble_prompt` used to
    inline it whole. Measured on T-0496: 49 entries / 144KB going into EVERY
    new session's brief for that ticket. A count-only cap under-delivers here
    because individual entries can themselves be huge (a whole compacted
    session summary pasted as one physical line, per T-0835's one-line-per-note
    contract) — the char budget is what actually bounds the worst case. This
    only shortens what gets INLINED — storage is untouched, and the full feed
    stays reachable via `bsq ticket status <id>`.
    """
    span = None
    for m in _H2_RE.finditer(body):
        if m.group(0).strip().lower() == "## progress":
            nxt = _H2_RE.search(body, m.end())
            span = (m.start(), nxt.start() if nxt else len(body))
            break
    if span is None:
        return body
    block = body[span[0]:span[1]].rstrip("\n")
    entry_lines = [ln for ln in block.split("\n") if ln.startswith("- ")]
    kept = entry_lines[-max_entries:] if len(entry_lines) > max_entries else list(entry_lines)
    total = sum(len(ln) + 1 for ln in kept)
    while len(kept) > 1 and total > char_budget:
        total -= len(kept[0]) + 1
        kept = kept[1:]
    omitted = len(entry_lines) - len(kept)
    if omitted <= 0:
        return body
    new_block = (
        "## Progress\n\n"
        f"({omitted} earlier entries omitted for brief size — full history via "
        "`bsq ticket status <id>`)\n\n" + "\n".join(kept)
    )
    rest = body[span[1]:].lstrip("\n")
    return body[:span[0]] + new_block + ("\n\n" + rest if rest else "\n")


def _assemble_prompt(slug: str, tickets: list[str], paths: dict[str, Path],
                     fms: dict[str, dict], role: str, report_to: str) -> str:
    """T-0149: deterministic per-task/role initial-prompt assembly.

    Composes the brief from the ticket bodies + role contract + initiative +
    cross-refs + prior stakeholder guidance (T-0151) + the hard process rules
    (no-superpowers-drift T-0152, manual-first verification T-0158, git/commit
    discipline, report-READY protocol). Replaces the hand-pasted brief so every
    spawn gets the same complete context regardless of who spawns it.
    """
    primary = tickets[0]
    role = role if role in _ROLE_FILES else "dev"
    roles_dir = _roles_ssot_dir()  # T-0198: git-tracked SSOT, not the drifting live copy
    role_path = roles_dir / _ROLE_FILES[role]
    role_text = role_path.read_text(encoding="utf-8", errors="replace").strip() \
        if role_path.exists() else "(role file missing)"

    bodies = {t: _cap_progress_for_brief(_body_after_frontmatter(paths[t])) for t in tickets}
    initiative = fms[primary].get("initiative") or ""
    ai_path = Path(BOT_SQUAD) / "data" / slug / "AGENT_INSTRUCTIONS.md"
    init_path = (Path(BOT_SQUAD) / "data" / slug / "vision" / "initiatives" / initiative
                 if initiative else None)

    # Prior stakeholder guidance (T-0151) folded in deterministically.
    kws = _ticket_keywords(fms)
    hits, total, _ = _collect_guidance(slug, kws, 5)
    if hits:
        guidance = "\n".join(
            f"  • [{h['source']} · {(h.get('ts') or '')[:10]}] {h['text']}" for h in hits)
        guidance = (f"Prior stakeholder guidance found for this work "
                    f"(via `bsq guidance search`, {total} hit(s); re-run for more):\n{guidance}")
    else:
        guidance = ("No prior stakeholder guidance matched. Before designing your "
                    "approach, run `bsq guidance search <keywords>` yourself with "
                    "other terms — buried guidance saves repeating questions (T-0151).")

    refs = _cross_refs(list(bodies.values()), set(tickets))
    refs_line = (f"Cross-referenced tickets (consult via `bsq ticket status <id>`): "
                 f"{', '.join(refs)}.\n\n" if refs else "")

    ticket_blocks = "\n\n".join(
        f"### {t}: {fms[t].get('title', t)}\n{bodies[t]}" for t in tickets)
    bundle_note = (f" You are bundled {len(tickets)} tickets: {', '.join(tickets)} — "
                   f"handle them together in this one session."
                   if len(tickets) > 1 else "")

    return f"""\
You are a bot-squad {role} session assigned {primary}{bundle_note}

The full scope+DoD of each assigned ticket is INLINED below — this brief is
self-contained, but FIRST also read AGENT_INSTRUCTIONS.md ({ai_path}) for
paths/git-rules and your initiative file{f' ({init_path})' if init_path else ''}.

START HERE — ANCHOR ON THE ASK (T-0483): read {primary}'s `## Stakeholder notes`
below FIRST (older tickets spell that heading `## Verbatim request` — same
section). That is his own words: the original ask, then every later quote. It was
recorded verbatim so it reaches you WITHOUT paraphrase loss — that is the whole
point: it defeats broken-telephone. Keep your work anchored to it; don't let the
target drift to the evolved mental model your accumulated context will suggest
(re-read it whenever you compact). It is the source of truth and HUMAN-ONLY —
never edit it, and never summarise it into your own words elsewhere.

CHECK IT BEFORE YOU ASK HIM ANYTHING (T-0767, his instruction): sessions
routinely go to him with questions «которые там сто раз раскрыты» — already
answered, in that section, on this ticket. Re-read it before any `bsq tg ping`.
If he answers something new, record HIS WORDS with `bsq ticket quote {primary}
'<verbatim>'` — never as a progress note, which is how his guidance used to get
buried in session narration.

A TICKET HAS THREE AUTHORED AREAS, AND THEY DO NOT OVERLAP (T-0767/T-0863).
Each answers a different question — that is the test for where something goes:
  • `## Stakeholder notes` — his words. Human-only. You append quotes, never prose.
  • `## Executive summary` — WHERE IT STANDS, and HE is the reader.
    `bsq ticket summary {primary} "<one paragraph>"` REPLACES it. Progress made
    + what remains, ONLY — never a restatement of the ask; he reads that above.
    Refuses a blank line, bullet or heading rather than reshaping what you wrote.
  • `## Context` — the WORKING AREA, shared by every session on this ticket.
    Keep it describing what is TRUE NOW: `bsq ticket context {primary} --file <f>`
    REPLACES it. Edit the final state; do not narrate how it got there.
`## Progress` is none of those. It is a one-line-per-checkpoint machine feed the stall
watchdog reads — notes are capped at 240 chars and the durable version of
anything longer belongs in `## Context`, where the next session will actually
read it.

== ASSIGNED TICKET(S) ==
{ticket_blocks}

{refs_line}== YOUR ROLE CONTRACT ({_ROLE_FILES[role]}) ==
{role_text}

== PRIOR STAKEHOLDER GUIDANCE (T-0151) ==
{guidance}

== HARD PROCESS RULES (enforced — not suggestions) ==
Ticket-only task tracking (T-0152), manual-testing-first (T-0158), git/commit
discipline, stakeholder-ping etiquette (T-0155), and feedback submission
(T-0154) are already covered above in your role contract and in
AGENT_INSTRUCTIONS.md ({ai_path}) — read both rather than re-deriving from
scratch.

STAY ON TASK (T-0149): a drift-check tick watches time-since-commit and
time-since-progress-note against {primary}'s `## Stakeholder notes` (your
anchor, printed above; `## Verbatim request` on older tickets). If you defer or descope anything, record WHY via
`bsq ticket note` — don't silently drift.

REPORT READY: when a ticket's DoD (incl. manual walkthrough) is green,
`bsq ticket update <id> to_accept` (T-0944: `totest` is the human's queue —
delivery now lands in `to_accept`, the operator's queue, one step before
that), `bsq ticket note <id> '<summary>'`, then
`bsq peer send {report_to} 'READY <id> — <summary>'`.

Run `bsq --help` for the full verb reference."""


# --------------------------------------------------------------------------
# Window → role derivation (T-0778).
#
# THIS IS A DELIBERATE, HAND-MAINTAINED THIRD COPY of one rule — not a
# delegation, and the docstring below says so because the previous one did not
# and that is how it rotted. The canonical implementation is
# `worker/bot_squad_worker/sessions.py::_derive_role`; the bash copy is
# `scripts/hooks/derive_role.sh::bsq_derive_role`. Two facts make a copy the
# right answer here rather than an import:
#
#   * `bsq` is stdlib-only by design — it runs on a bare `/usr/bin/env python3`
#     with no venv and reaches the worker ONLY over its socket. Every other
#     piece of worker logic it needs (frontmatter, pace, task_search) is
#     likewise a mirror, never an import. Importing `bot_squad_worker` here
#     WOULD work today (measured: ~0.1s, stdlib-clean import chain) but would
#     make the one file every live session runs depend at runtime on a second
#     tree being importable, and give it a new way to break for everyone at
#     once. It would also have to CHOOSE a tree (the install's worker/ vs this
#     clone's), and the two can legitimately differ across a deploy.
#   * the copy that rotted was the UNPINNED one. `derive_role.sh` has been a
#     third copy since T-0041 and never drifted, because
#     `scripts/hooks/test_derive_role.sh` cross-checks it against the live
#     python on a shared window table. This copy now has the same net:
#     `worker/tests/test_bsq_role_derivation_mirror.py` drives BOTH functions
#     over one table and requires identical answers, and also compares these
#     regex sources + their precedence order against the worker's.
#
# Patterns and ORDER are byte-identical to sessions.py's module-level regexes.
# Precedence matters: prod-TL MUST precede plain TL (T-0197), since a
# `…-prod-tl` window also ends in `tl` — the worker suite asserts that
# direction (test_sessions.py), and getting it backwards is the bug T-0778
# fixed. Any change here must be made in all three copies.
# --------------------------------------------------------------------------
_ROLE_WINDOW_RES: tuple[tuple[str, "re.Pattern[str]"], ...] = (
    # T-0964: an explicit `dev_`/`dev-` PREFIX is authoritative and comes
    # FIRST, so a bud named for its role stays that role even when its feature
    # slug ends in another marker (`dev_move_the_qa`).
    ("dev", re.compile(r"^dev[-_]", re.IGNORECASE)),
    ("operator", re.compile(r"(?:^|[-_])operator$", re.IGNORECASE)),
    # T-0197: BEFORE plain TL — a `prod-tl` window also ends in `tl`.
    ("prod-teamlead", re.compile(r"(?:^|[-_])prod[-_](?:tl|teamlead)$", re.IGNORECASE)),
    ("qa", re.compile(r"(?:^|[-_])qa$", re.IGNORECASE)),
    # T-0478: system-spawned user-conversation intake session. Its legacy
    # window is `<gu_id>-user-conversation`, so the marker is matched as a
    # SUFFIX. T-0964 adds the two user-facing names beside it.
    ("user-conversation", re.compile(r"(?:^|[-_])user[-_]conversation$", re.IGNORECASE)),
    ("user-conversation", re.compile(r"^universal[-_]bsq[-_]session(?:[-_]|$)", re.IGNORECASE)),
    ("user-conversation", re.compile(r"(?:^|[-_])user[-_]session(?:$|[-_])", re.IGNORECASE)),
    ("teamlead", re.compile(r"(?:^|[-_])(?:tl|teamlead)$", re.IGNORECASE)),
)


def _role_from_window(window: str | None) -> str:
    """Map a tmux window name → role enum, first marker wins, default ``dev``.

    Behavioural mirror of ``sessions._derive_role(window, None, None)`` — see
    the block comment above for why this is a copy and what pins it. T-0175:
    task_id / initiative deliberately do NOT influence the role, so this takes
    the window alone.
    """
    w = (window or "").strip()
    for role, marker in _ROLE_WINDOW_RES:
        if marker.search(w):
            return role
    return "dev"


def _role_from_sid(sid: str | None) -> str:
    """Role of a session from its SID (``S-<user>-<window>-p<pane>``).

    The marker is always a SUFFIX of the window, which is a suffix of the SID's
    middle segment, so stripping the user is not required for correctness (the
    worker's own ``_role_segment_of_sid`` matches the whole middle segment for
    exactly that reason); it is kept only to narrow what a malformed SID can
    match. A SID that doesn't parse is matched whole, and an empty one is dev.
    """
    if not sid:
        return "dev"
    m = re.match(r"^S-[^-]+-(.*)-p\d+$", sid)
    return _role_from_window(m.group(1) if m else sid)


def _fm_list(raw) -> list[str]:
    """Parse an inline-list frontmatter value ('[a, b]') from read_frontmatter
    into clean ids — read_frontmatter returns lists as raw strings."""
    if isinstance(raw, list):
        items = raw
    else:
        s = (raw or "").strip()
        if s.startswith("[") and s.endswith("]"):
            s = s[1:-1]
        items = s.split(",")
    return [x.strip() for x in items if x and x.strip() not in ("", "~")]


def cmd_brief(args) -> None:
    """T-0203: print the FULL orientation on demand — product + team protocol +
    role contract + this session's bindings. This is the pull-home for the
    context the SessionStart hook no longer auto-dumps on every fire/compact.
    Use it after a `/compact`, on a manually-started session, or whenever your
    memory of the role rules / protocol is stale."""
    slug = resolve_slug()
    data = Path(BOT_SQUAD) / "data" / slug
    sid = my_sid()
    role = _role_from_sid(sid)
    role_file = _ROLE_FILES.get(role, "dev.md")

    print(f"=== BRIEF: {slug} === role: {role.upper()}"
          + (f"  ·  {sid}" if sid else ""))
    provider = _project_provider_default()
    print(f"Project agent-provider default: {provider}. Ordinary `bsq spawn` "
          "must inherit it; use `--provider` only for a deliberate override.")

    def _emit(title: str, path: Path) -> None:
        if path.exists():
            print(f"\n=== {title} ===")
            print(path.read_text(encoding="utf-8", errors="replace").rstrip())
        else:
            print(f"\n=== {title} ===\n(missing: {path})")

    _emit("PRODUCT", data / "vision" / "product.md")
    _emit("TEAM PROTOCOL", data / "vision" / "team_protocol.md")
    _emit(f"YOUR ROLE CONTRACT ({role_file})", _roles_ssot_dir() / role_file)  # T-0198: SSOT

    # Bindings from the session md (primary + extras).
    if sid:
        md = data / "sessions" / f"{sid}.md"
        if md.exists():
            fm = read_frontmatter(md)
            primary_t = (fm.get("task_id") or "").strip()
            primary_t = "" if primary_t in ("", "~") else primary_t
            extras_t = _fm_list(fm.get("extra_task_ids"))
            primary_i = (fm.get("initiative") or "").strip()
            primary_i = "" if primary_i in ("", "~") else primary_i
            extras_i = _fm_list(fm.get("extra_initiatives"))
            print("\n=== YOUR BINDINGS ===")
            if primary_t or extras_t:
                parts = [f"{primary_t} (primary)"] if primary_t else []
                parts += extras_t
                print(f"Tasks: {', '.join(parts)} — read each md under "
                      f"data/{slug}/backlog/<id>-*.md")
            if primary_i or extras_i:
                parts = [f"{primary_i} (primary)"] if primary_i else []
                parts += extras_i
                print(f"Initiatives: {', '.join(parts)} — "
                      f"data/{slug}/vision/initiatives/")
            if not (primary_t or extras_t or primary_i or extras_i):
                print("(no task/initiative bound to this session)")

    print("\n(AGENT_INSTRUCTIONS.md + constitution.md are separate on-demand "
          "reads — see the ORIENTATION pointers in your session banner.)")


