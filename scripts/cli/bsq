          f"({res.get('bytes_written')} bytes, role {res.get('role')})")


def cmd_work_state(args) -> None:
    """T-0473/T-0942: read the project's WORK-STATE doc — with its staleness verdict.

    One future-focused project-management document per project (priorities /
    what's happening / delivered / next / tracked-issues — NOT an event log) at
    ``artifacts/work-state.md``, written by whichever session holds a
    project-level role. Pre-T-0942 it was ``operator-state.md`` and only an
    operator-role session's compact could reach it, which is how the seat's doc
    sat five weeks stale while the session actually holding the seat wrote a
    per-role file instead.

    The STALENESS BANNER prints to stderr before the doc, on purpose: piping
    the doc somewhere must not silently drop the one line saying it is history.
    """
    slug = resolve_slug()
    res = post("work_state_doc", {"slug": slug})
    if getattr(args, "template", False):
        sys.stdout.write(res.get("template", ""))
        return
    st = res.get("staleness") or {}
    if getattr(args, "rev", False):
        print(res.get("rev", 0))
        return
    banner = res.get("banner") or ""
    if banner:
        sys.stderr.write(banner + "\n\n")
    if res.get("exists"):
        sys.stderr.write(
            f"[rev {res.get('rev')} · written {st.get('age_human')} ago by "
            f"{st.get('updated_by') or 'an unrecorded session'} · "
            f"{'STALE' if st.get('stale') else 'current'}]\n"
            f"[to replace it: bsq work-state write --file <f> --base-rev "
            f"{res.get('rev')}]\n\n")
        sys.stdout.write(res.get("content", ""))
    else:
        print(f"work-state doc not created yet → {res.get('path')}")
        print("seed it: `bsq work-state --template` to see the schema, then "
              "`bsq work-state write --file <f> --base-rev 0`.")


def cmd_work_state_write(args) -> None:
    """T-0942: REPLACE the project's work-state doc, under the concurrency lock.

    Any live session may write it — «в него должна иметь право и юзер-сессия
    писать» — so ``--base-rev`` is what keeps two holders from silently
    clobbering each other: pass the rev you READ, and a write based on a rev
    that has since moved is REFUSED with the current one rather than merged or
    overwritten. Re-read, merge, write again.

    Text comes from ``--file`` or stdin, never argv: this is a whole document,
    and shell-quoting one is the friction that produces a one-line state doc.
    """
    slug = resolve_slug()
    sid = require_sid(getattr(args, "sid", None))
    if args.file:
        text = Path(args.file).read_text(encoding="utf-8")
    elif not sys.stdin.isatty():
        text = sys.stdin.read()
    else:
        die("no text: pass --file <path> or pipe the whole work-state doc on "
            "stdin. Read the current one (and its rev) with `bsq work-state`.")
    params = {"slug": slug, "sid": sid, "content": text}
    if args.base_rev is not None:
        params["base_rev"] = args.base_rev
    res = post("work_state_write", params)
    print(f"work-state written → {res.get('path')} "
          f"(rev {res.get('base_rev')} → {res.get('rev')}, "
          f"{res.get('bytes_written')} bytes)")
    if res.get("snapshot"):
        print(f"  previous version: {res['snapshot']}")
    if res.get("blind_over"):
        print(f"  ⚠️ overwrote a doc last written by {res['blind_over']} "
              f"without a base-rev check")


