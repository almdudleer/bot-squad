# --------------------------------------------------------------------------
def _usecases_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "use_cases"


def _usecase_path(slug: str, uc_id: str) -> Path:
    uc_id = uc_id.strip()
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$", uc_id):
        die(f"invalid use-case id {uc_id!r} (allowed: letters, digits, - _ .)")
    return _usecases_dir(slug) / f"{uc_id}.md"


def _find_usecase(slug: str, uc_id: str) -> Path:
    p = _usecase_path(slug, uc_id)
    if not p.exists():
        die(f"use case not found: {uc_id} (looked in {_usecases_dir(slug)})")
    return p


_FEEDBACK_HEADING = "## Feedback"


def _attach_feedback_to_usecase(slug: str, uc_id: str, ts: str, sid: str, text: str) -> None:
    p = _usecase_path(slug, uc_id)
    if not p.exists():
        raise WorkerError(f"use case {uc_id} does not exist")
    body = p.read_text(encoding="utf-8")
    entry = f"- [{ts} · {sid}] {text}\n"
    if _FEEDBACK_HEADING in body:
        # Insert directly under the heading line.
        body = re.sub(
            rf"({re.escape(_FEEDBACK_HEADING)}\n)",
            rf"\1{entry}",
            body, count=1,
        )
    else:
        body = body.rstrip() + f"\n\n{_FEEDBACK_HEADING}\n{entry}"
    _write_atomic(p, body)


