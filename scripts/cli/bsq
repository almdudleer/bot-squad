        raw = json.loads(
            (Path(BOT_SQUAD) / "data" / "_state" / "agent_provider.json").read_text()
        )
        return "codex" if raw.get("provider") == "codex" else "claude"
    except (OSError, ValueError, AttributeError):
        return "claude"


def _spawn_provider(args) -> str:
    if getattr(args, "provider", None):
        return args.provider
