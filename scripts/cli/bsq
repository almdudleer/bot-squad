def _docs_dir(slug: str) -> Path:
    return Path(BOT_SQUAD) / "data" / slug / "docs"


def _doc_id_from_stem(stem: str) -> str:
    """`D-NNNN-<slug>` → `D-NNNN`; any other stem IS its own id.

    T-0751: this is the third copy of the derivation the api's
    `artifact_nesting.id_from_stem` owns — scripts/cli cannot import across the
    api/worker package boundary, so the copy is pinned by
    `test_bsq_doc_id_derivation.py` instead. The old `split("-", 2)[:2]`
    assumed every doc filename is `D-NNNN-<slug>`, so `bsq docs list` printed
    `03-docs` for `roadmap/03-docs-artifacts.md` — an id the API 400'd.
    """
    m = re.match(r"^([A-Za-z]+-\d{4,})(?:-.*)?$", stem)  # T-0371: ids cross 9999
    return m.group(1) if m else stem


def _doc_id_is_linkable(doc_id: str) -> bool:
    """Mirrors the api's `artifact_nesting.is_valid_artifact_id` (T-0751).

    `bsq docs link` used to demand `D-NNNN`, so the 19 docs `bsq docs list`
    printed with a filename-derived id could not be linked from the CLI at all
    — while the web's `POST /docs/{id}/link` now accepts them. Excludes only
    what can never be a filename component.
    """
    if not doc_id or doc_id in {".", ".."}:
        return False
    if "/" in doc_id or "\\" in doc_id or "\x00" in doc_id:
        return False
    return len(doc_id.encode("utf-8")) <= 255


def _find_doc_file(slug: str, doc_id: str) -> Path | None:
    """Resolve a doc id to its file by comparing DERIVED ids (T-0751).

    Was two globs over `*/{doc_id}-*.md` — which only ever matched an
    allocated id, and interpolated the caller's string into a path pattern.
    """
    root = _docs_dir(slug)
    if not root.exists() or not _doc_id_is_linkable(doc_id):
        return None
    for cdir in sorted(p for p in root.iterdir() if p.is_dir()):
        for f in sorted(cdir.glob("*.md")):
            fm = read_frontmatter(f)
            if (fm.get("id") or _doc_id_from_stem(f.stem)) == doc_id:
                return f
    return None


def _mutate_fm_list(path: Path, field: str, value: str, *, add: bool) -> None:
    """Add/remove ``value`` from a YAML-frontmatter list field, idempotently.

    T-1049: parses AND serializes through the shared frontmatter module
    (T-1047's third mirror), not a bare ``yaml.safe_load``/``safe_dump`` pair.
    The bare dumper inherits none of what that module guarantees — no
    flow-style list representer, so lists land in BLOCK form; no width pin
    (T-1044), so a long scalar folds.

    That mattered here more than the field being written, because
    :func:`cmd_doc_link` calls this on the TICKET path (``related_docs``), so
    it rewrites a ticket's WHOLE frontmatter. Measured on the API's identical
    twin (``routes_docs._mutate_list_field``, same defect, fixed in the same
    ticket): linking a doc folded the ticket's title and flipped its
    ``session_history`` from flow to BLOCK — the field `bsq spawn`'s
    expert-resume reads. A user action with nothing to do with sessions was
    destroying the session record, silently.

    Parser and dumper move together on purpose: the shared dumper writes a
    timestamp UNQUOTED, and a bare ``yaml.safe_load`` would resolve that to a
    ``datetime`` where the shared parser (which strips the timestamp resolver)
    returns a ``str``. Splitting them changes a field's TYPE for every reader.
    """
    fm_mod = _load_frontmatter()
    text = path.read_text()
    parsed = fm_mod.parse_or_none(text)
    if parsed is None:
        die(f"no frontmatter in {path}")
    meta, body = parsed
    meta = dict(meta or {})
    cur = fm_mod.as_list(meta.get(field))
    if add and value not in cur:
        cur.append(value)
    elif not add and value in cur:
        cur = [x for x in cur if x != value]
    meta[field] = cur
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(fm_mod.dump(meta, body))
    os.replace(tmp, path)


def cmd_doc_list(args) -> None:
    slug = resolve_slug()
    root = _docs_dir(slug)
    cats = [args.category] if args.category else (
        sorted(p.name for p in root.iterdir() if p.is_dir()) if root.exists() else []
    )
    rows = []
    for cat in cats:
        cdir = root / cat
        if not cdir.is_dir():
            continue
        for f in sorted(cdir.glob("*.md")):
            fm = read_frontmatter(f)
            rows.append({
                "id": fm.get("id") or _doc_id_from_stem(f.stem),
                "category": cat,
                "status": fm.get("status", "") or "-",
                "title": fm.get("title", f.stem).strip('"'),
            })
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print(f"(no docs yet — `bsq docs new <category> <title>` to add one in {root})")
        return
    table = [("ID", "CATEGORY", "STATUS", "TITLE")] + [
        (r["id"], r["category"], r["status"], r["title"]) for r in rows
    ]
    widths = [max(len(r[i]) for r in table) for i in range(len(table[0]))]
    for r in table:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)))


def cmd_doc_link(args) -> None:
    doc_id = args.doc_id
    # T-0371: ids cross 9999. T-0751: only an ALLOCATED id is case-normalised —
    # every other doc id is a filename stem (`03-docs-artifacts`,
    # `verbatim-contract`), and upper-casing those makes them unresolvable.
    if re.match(r"^[dD]-\d{4,}$", doc_id):
        doc_id = doc_id.upper()
    # T-0892: the id, then the board it belongs to. Uppercasing has to happen
    # BEFORE the `@slug` is split off, or `T-1@watchrobot` becomes
    # `T-1@WATCHROBOT` and no such project exists.
    raw_ticket, ref_slug = split_ticket_ref(args.ticket)
    ticket = raw_ticket.upper()
    if not _doc_id_is_linkable(doc_id):
        die(f"invalid doc id: {doc_id!r}")
    if not re.match(r"^T-\d{4,}$", ticket):  # T-0371
        die(f"invalid ticket id: {ticket!r} (expect T-NNNN)")
    slug, ticket, ticket_path = resolve_ticket_ref(
        f"{ticket}@{ref_slug}" if ref_slug else ticket,
        getattr(args, "slug", None), verb="docs link")
    # BOTH sides of the link live on the board the ticket resolved to: a doc
    # and a ticket from different projects cannot reference each other.
    doc_path = _find_doc_file(slug, doc_id)
    if doc_path is None:
        die(f"doc not found: {doc_id} (looked in {_docs_dir(slug)})")
    add = not args.unlink
    _mutate_fm_list(doc_path, "related_tickets", ticket, add=add)
    _mutate_fm_list(ticket_path, "related_docs", doc_id, add=add)
    verb = "linked" if add else "unlinked"
    print(f"{verb}: {doc_id} <-> {ticket}")


def cmd_doc_sync(args) -> None:
    """Symlink data/<slug>/docs/ into the dev + master clones (T-0172).

    So `cat ~/<project>/dev/docs/architecture/...md` works for any agent
    running with a clone as cwd, without copying the docs out of bot-squad.
    """
    slug = resolve_slug()
    docs_target = _docs_dir(slug)
    docs_target.mkdir(parents=True, exist_ok=True)
    try:
        with open(PROJECTS_TOML, "rb") as f:
            cfg = tomllib.load(f)
    except OSError as e:
        die(f"cannot read {PROJECTS_TOML}: {e}")
    proj = cfg.get("projects", {}).get(slug, {})
    clones = [proj.get(k) for k in ("repo_path", "repo_master")]
    made = 0
    for clone in clones:
        if not clone:
            continue
        link = Path(clone) / "docs"
        if link.is_symlink():
            if os.path.realpath(link) == os.path.realpath(docs_target):
                print(f"ok (already linked): {link} -> {docs_target}")
                continue
            link.unlink()
        elif link.exists():
            print(f"SKIP {link}: a real directory/file already exists there "
                  f"(not clobbering — move it into {docs_target} first)", file=sys.stderr)
            continue
        if not Path(clone).is_dir():
            print(f"SKIP {clone}: clone dir does not exist", file=sys.stderr)
            continue
        link.symlink_to(docs_target)
        print(f"linked: {link} -> {docs_target}")
        made += 1
    print(f"docs sync done ({made} new symlink(s)).")


