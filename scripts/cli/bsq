def _msg_route_slug(args) -> str:
    """Which project's route map this call is about. Explicit --slug wins, else
    the cwd-resolved project — the same precedence every other per-project verb
    uses, so `bsq msg-route list` inside a project clone needs no flag."""
    return args.slug or resolve_slug()


def cmd_msg_route_list(args) -> None:
    """Show every automated message type and where it goes today (T-0799).

    Prints the RESOLVED destination per type, not the stored file: a
    `class:log` entry governs every log-class type at once, and the file cannot
    tell you which ones those are.
    """
    slug = _msg_route_slug(args)
    res = post("msg_route_list", {"slug": slug})
    rows = res.get("rows", [])
    if not rows:
        print(f"{slug}: no message types registered")
        return
    print(f"{slug}: automated message destinations "
          f"('default' = the project's own chat, i.e. today's behaviour)")
    for urg in ("urgent", "log"):
        band = [r for r in rows if r.get("urgency") == urg]
        if not band:
            continue
        print(f"\n  {urg.upper()} — "
              + ("worth waking him for" if urg == "urgent"
                 else "a record to read when he chooses to"))
        for r in band:
            dest = "default"
            if r.get("source") != "default":
                chat = r.get("chat_id") or "(project chat)"
                topic = r.get("topic_id")
                dest = f"chat={chat} topic={topic if topic is not None else '(none)'}"
                if r.get("source") != r.get("msg_type"):
                    dest += f"  via {r['source']}"
            print(f"    {r['msg_type']:<20} {dest}")
            print(f"    {'':<20} {r.get('summary', '')}")
    print(f"\nroutable keys: {', '.join(res.get('keys', []))}")


def cmd_msg_route_set(args) -> None:
    """Point a message type (or a whole urgency class) at a chat/topic (T-0799).

    `--chat`/`--topic` are each three-valued on purpose: absent = "this call
    does not name the field", an id/number = that destination, and the literal
    `default`/`none` = the explicit empty form (the project's own chat / no
    forum thread). Both empties are real destinations, so the worker refuses a
    write that would drop a stored value the call did not name — restate it, or
    ask for the empty form.
    """
    slug = _msg_route_slug(args)
    params: dict = {"slug": slug, "msg_type": args.msg_type}
    if args.chat is not None:
        params["chat_id"] = "" if args.chat in ("default", "") else args.chat
    if args.topic is not None:
        if args.topic in ("none", "None", ""):
            params["topic_id"] = None
        else:
            try:
                params["topic_id"] = int(args.topic)
            except ValueError:
                die(f"msg-route set: --topic must be a thread id or 'none', "
                    f"got {args.topic!r}")
    if "chat_id" not in params and "topic_id" not in params:
        die("msg-route set: name --chat and/or --topic (to remove a route, "
            "use `bsq msg-route clear`)")
    res = post("msg_route_set", params)
    rec = res.get("route", {})
    topic = rec.get("topic_id")
    if not rec.get("chat_id") and topic is None:
        # An explicitly-empty route PINS the type to the project's own chat,
        # which is how one type is exempted from a class:* entry governing it.
        print(f"{slug}: {res.get('msg_type')} -> pinned to the project's own "
              f"chat (exempt from any class:* route)")
    else:
        print(f"{slug}: {res.get('msg_type')} -> "
              f"chat={rec.get('chat_id') or '(project chat)'} "
              f"topic={topic if topic is not None else '(none)'}")
    changes = res.get("changes") or {}
    if changes:
        for field, mv in changes.items():
            print(f"  {field}: {mv.get('from')!r} -> {mv.get('to')!r}")
    else:
        print("  (no change — it already routed there)")


def cmd_msg_route_clear(args) -> None:
    """Drop a route, restoring that type's default destination (T-0799)."""
    slug = _msg_route_slug(args)
    res = post("msg_route_clear", {"slug": slug, "msg_type": args.msg_type})
    if res.get("cleared"):
        print(f"{slug}: {args.msg_type} -> default (the project's own chat)")
    else:
        print(f"{slug}: {args.msg_type} had no route (no-op)")


def cmd_topic_create(args) -> None:
    """Create a forum topic AND bind it to a project in one step (T-0660).

    Calls Telegram's createForumTopic then binds the returned thread_id to
    <slug> (+ optional --ticket for a per-task topic, --session to route an
    inbound topic message straight to that ORIGINATING session instead of
    the project's user-conversation attendant) — never leaves a TG topic
    that exists but isn't routed anywhere.

    T-0669: with --ticket, `name` is DERIVED server-side from the ticket's
    own title ('[<slug>] <title>') and any --name given here is ignored — so
    it's optional in that case. Without --ticket, --name is required (a
    project-level topic has no ticket to derive a title from).
    """
    if not args.ticket and not args.name:
        die("topic create: --name is required unless --ticket is given (T-0669)")
    params = {"chat_id": args.chat_id, "slug": args.slug}
    if args.name:
        params["name"] = args.name
    if args.ticket:
        # T-0892: this one was already sound — the worker derives the topic
        # NAME from the ticket, so it resolves the id against this same slug
        # before creating anything (`_derive_task_topic_name`). Routing it
        # through the shared resolver anyway buys the `T-NNNN@slug` grammar,
        # the same announcement as its siblings, and a failure that costs a
        # local lookup instead of a Telegram round trip.
        _create_slug, ticket_id, _p = resolve_ticket_ref(
            args.ticket, args.slug, verb="topic create")
        params["ticket_id"] = ticket_id
    if args.session:
        params["session_id"] = args.session
    caller_sid = my_sid()
    if caller_sid:
        params["caller_sid"] = caller_sid
    res = post("tg_topic_create", params)
    extra = ""
    if args.ticket:
        extra += f" ticket_id={params['ticket_id']}"
    if args.session:
        extra += f" session_id={args.session}"
    print(f"created topic '{res.get('name')}' chat_id={res.get('chat_id')} "
          f"thread_id={res.get('thread_id')} -> slug={res.get('slug')}{extra}")


