def _usecase_section(body: str, heading: str) -> str:
    """Return the text under a `## heading` up to the next `## ` (or EOF)."""
    m = re.search(rf"^{re.escape(heading)}\s*\n(.*?)(?=^\#\# |\Z)", body,
                  re.MULTILINE | re.DOTALL)
    return m.group(1).strip() if m else ""


def cmd_usecase_run(args) -> None:
    slug = resolve_slug()
    path = _find_usecase(slug, args.id)
    fm = read_frontmatter(path)
    body = _body_after_frontmatter(path)
    uc_id = path.stem

    steps = _usecase_section(body, "## Steps") or "(no steps recorded — see use case md)"
    feedback = _usecase_section(body, _FEEDBACK_HEADING)
    feedback_block = (
        f"\n\nPRIOR FEEDBACK on this use case — verify each item is addressed, "
        f"and flag any that regressed:\n{feedback}\n"
        if feedback else ""
    )
    report_to = args.report_to or my_sid() or "<your TL SID>"
    window = args.window or f"uctest-{uc_id}"[:40]

    brief = _USECASE_TEST_BRIEF.format(
        slug=slug, uc_id=uc_id, title=fm.get("title", uc_id),
        persona=fm.get("user_persona", "(unspecified)"),
        goal=fm.get("goal", "(unspecified)"),
        preconditions=fm.get("preconditions", "(unspecified)"),
        success_criteria=fm.get("success_criteria", "(unspecified)"),
        related=fm.get("related_tickets", "(none)"),
        steps=steps, feedback_block=feedback_block, report_to=report_to,
    )

    if args.dry_run:
        print(brief)
        return

    params = {"slug": slug, "window": window, "initial_prompt": brief}
    if args.owner:
        params["owner"] = args.owner
    res = post("spawn_session", params, timeout=90)
    print(f"spawned testing-dev {res.get('sid')} for use case {uc_id} (window={window})")


