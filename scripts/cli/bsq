_PROGRESS_LINE_RE = re.compile(r"^-\s+(\S+)\s+·\s+(\S+)\s+·\s+(.*)$")


def _progress_lines_by_sid(slug: str) -> dict[str, list[dict]]:
    """Every `## Progress` line across the project's backlog, indexed by the
    authoring SID and sorted chronologically per sid.

    Progress lines (`- <ts> · <sid> · <text>`, task_body.append_progress's
    format) are a session's own narration of its work, stamped by sid — the
    one place that trail survives archival, since a session's LIVE task
    binding (task_id) is cleared when it's archived (last_task_id is the only
    frontmatter trace left). This is the corpus session-history search runs
    over."""
    out: dict[str, list[dict]] = {}
    for p in sorted(backlog_dir(slug).glob("T-*.md")):
        section = _extract_md_section(_md_body(p), "progress")
        if not section:
            continue
        fm = read_frontmatter(p)
        tid = fm.get("id") or p.stem
        for ln in section.splitlines():
            m = _PROGRESS_LINE_RE.match(ln.strip())
            if not m:
                continue
            ts, sid, text = m.groups()
            out.setdefault(sid, []).append({"ts": ts, "ticket": tid, "text": text})
    for lines in out.values():
        lines.sort(key=lambda r: r["ts"])
    return out


def _exited_sessions(slug: str) -> list[dict]:
    """Suspended or archived sessions (the ones with a finished/paused
    history worth searching) via the worker's live session list — same
    source + filter `bsq expert find` uses (`_find_expert`), so ids stay
    real-typed rather than re-parsed from flat frontmatter."""
    sessions = post("list_sessions", {"slug": slug}).get("sessions", [])
    return [s for s in sessions
            if s.get("sid") and (s.get("status") == "suspended" or bool(s.get("archived")))]


def _session_history_tickets(s: dict) -> list[str]:
    out = _session_tickets(s) | set(_clean_id_list(s.get("last_task_id")))
    return sorted(out)


def cmd_session_search(args) -> None:
    slug = resolve_slug()
    by_sid = _progress_lines_by_sid(slug)

    if args.sid:
        sid = args.sid.strip()
        sessions = {s["sid"]: s for s in _exited_sessions(slug)}
        s = sessions.get(sid)
        lines = by_sid.get(sid, [])
        if s is None and not lines:
            die(f"no exited session found for sid {sid!r} "
                f"(no session record and no Progress notes under it)")
        if args.json:
            print(json.dumps({"sid": sid, "session": s, "progress": lines}, indent=2))
            return
        if s:
            tag = "archived" if s.get("archived") else s.get("status", "?")
            print(f"{sid}  [{tag}]  window={s.get('window', '?')}")
            print(f"  tickets: {', '.join(_session_history_tickets(s)) or '-'}")
            print(f"  started: {s.get('started_at', '?')}   "
                  f"suspended: {s.get('suspended_at', '?')}")
        else:
            print(f"{sid}  (no live session record — Progress trail only)")
        if not lines:
            print("  (no Progress notes found under this sid)")
            return
        print("  progress:")
        for r in lines:
            print(f"    {r['ts']}  {r['ticket']}  {r['text']}")
        return

    query = (args.query or "").strip()
    if not query:
        die("session search: pass a free-text query or --sid <sid>")
    kws = [w for w in re.split(r"[^A-Za-z0-9]+", query.lower()) if len(w) >= 2]
    if not kws:
        die(f"session search: query {query!r} has no usable keywords")

    cands = []
    for s in _exited_sessions(slug):
        sid = s["sid"]
        lines = by_sid.get(sid, [])
        blob = " ".join([s.get("window", "").replace("-", " ")] + [r["text"] for r in lines])
        score = _score(blob, kws)
        if score <= 0:
            continue
        cands.append({
            "sid": sid, "window": s.get("window", ""),
            "status": s.get("status", ""), "archived": bool(s.get("archived")),
            "score": score, "tickets": _session_history_tickets(s),
            "snippet": _snippet(blob, kws),
        })
    cands.sort(key=lambda c: (-c["score"], c["sid"]))
    limit = max(1, args.limit)
    cands = cands[:limit]

    if args.json:
        print(json.dumps(cands, indent=2))
        return
    if not cands:
        print(f"(no exited session matched {query!r})")
        return
    print(f"session-history matches for {query!r} (best first):\n")
    for c in cands:
        tag = "archived" if c["archived"] else c["status"]
        print(f"• {c['sid']}  [{tag}, score {c['score']}]")
        print(f"  window: {c['window']}   tickets: {', '.join(c['tickets']) or '-'}")
        print(f"  {c['snippet']}\n")


