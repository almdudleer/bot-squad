# arg parsing
# --------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="bsq",
        description="Slim bot-squad CLI for agents — wraps worker-socket actions "
                    "as kubectl-style verbs. Canonical agent reference.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  bsq inbox check                  drain new peer mail\n"
            "  bsq peer send teamlead 'READY T-0146 — shipped, sha abc123'\n"
            "  bsq spawn T-0150 --bundle T-0151,T-0152\n"
            "  bsq team status\n"
            "  bsq compact\n"
            "  bsq commit --ack -m 'fix: thing' path/to/file.py\n\n"
            "The 'check mail' tmux signal: `bsq peer send` nudges each live\n"
            "recipient pane with the text 'check mail' — that is an agent's\n"
            "cue to run `bsq inbox check`. The long-poll watcher\n"
            "(`bsq inbox wait`) is opt-in only."
        ),
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    # inbox
    inbox = sub.add_parser("inbox", help="peer inbox: check / wait")
    inbox_sub = inbox.add_subparsers(dest="sub", required=True)
    c = inbox_sub.add_parser("check", help="drain new peer messages for this session")
    c.add_argument("--since", help="only show messages with ISO ts >= this")
    c.add_argument("--sid", help="override this session's SID")
    c.add_argument("--json", action="store_true", help="raw JSON output")
    c.add_argument("--envelopes", action="store_true",
                   help="show only structured dispatch envelopes (T-0144)")
    c.set_defaults(func=cmd_inbox_check)
    w = inbox_sub.add_parser("wait", help="opt-in long-poll until mail arrives")
    w.add_argument("--timeout", default=1800, type=float, help="seconds (default 1800)")
    w.add_argument("--sid", help="override this session's SID")
    w.set_defaults(func=cmd_inbox_wait)

    # peer
    peer = sub.add_parser("peer", help="peer messaging")
    peer_sub = peer.add_subparsers(dest="sub", required=True)
    ps = peer_sub.add_parser("send", help="send a message + signal the recipient pane")
    ps.add_argument("to", help="target SID or role keyword (teamlead/dev/all)")
    ps.add_argument("text", help="message text")
    ps.add_argument("--from", dest="from_sid", help="override sender SID")
    ps.add_argument("--no-signal", action="store_true",
                    help="skip the 'check mail' tmux nudge")
    ps.set_defaults(func=cmd_peer_send)

    # dispatch (structured operator → TL envelope, T-0144)
    dp = peer_sub.add_parser("dispatch",
                             help="send a typed dispatch envelope (action + payload)")
    dp.add_argument("to", help="target SID or role keyword (teamlead/dev/all)")
    dp.add_argument("action", help="dispatch action (assign/archive_team/status/message)")
    dp.add_argument("--field", action="append", metavar="K=V",
                    help="payload key=value (repeatable)")
    dp.add_argument("--json", help="payload as a JSON object (merged under --field)")
    dp.add_argument("--note", help="free-text note alongside the typed payload")
    dp.add_argument("--from", dest="from_sid", help="override sender SID")
    dp.add_argument("--no-signal", action="store_true",
                    help="skip the 'check mail' tmux nudge")
    dp.set_defaults(func=cmd_dispatch)

    # tg (T-0155) — explicit stakeholder DM; the only agent-initiated TG path.
    tg = sub.add_parser("tg", help="Telegram: explicitly DM the stakeholder")
    tg_sub = tg.add_subparsers(dest="sub", required=True)
    tgp = tg_sub.add_parser(
        "ping",
        help="DM the stakeholder now (reply routes back to your tmux pane)")
    tgp.add_argument("message", nargs="+", help="message text for the stakeholder")
    tgp.add_argument("--sid", help="override this session's SID")
    tgp.add_argument("--urgent", action="store_true",
                     help="bypass quiet hours (use sparingly — hard blockers only)")
    tgp.set_defaults(func=cmd_tg_ping)

    # spawn
    sp = sub.add_parser("spawn", help="spawn a dev session for a backlog ticket")
    sp.add_argument("ticket", help="ticket id, e.g. T-0150")
    sp.add_argument("--bundle", help="comma-separated extra ticket ids bound to the same session")
    sp.add_argument("--window", help="tmux window name (default: ticket feature slug)")
    sp.add_argument("--initiative", help="initiative md (default: from ticket frontmatter)")
    sp.add_argument("--owner", help="UI username to stamp on the session")
    sp.add_argument("--role", default="dev", choices=["dev", "tl", "teamlead", "operator"],
                    help="role contract to assemble into the prompt (default dev)")
    sp.add_argument("--prompt", help="custom initial prompt (overrides deterministic assembly)")
    sp.add_argument("--prompt-file", help="read initial prompt from a file")
    sp.add_argument("--dry-run", action="store_true", help="print params without spawning")
    sp.set_defaults(func=cmd_spawn)

    # team
    team = sub.add_parser("team", help="session roster (composes with T-0142)")
    team_sub = team.add_subparsers(dest="sub", required=True)
    ts = team_sub.add_parser("status", help="list this project's sessions")
    ts.add_argument("--all", action="store_true", help="include suspended sessions")
    ts.add_argument("--json", action="store_true", help="raw JSON output")
    ts.set_defaults(func=cmd_team_status)
    tlst = team_sub.add_parser("list", help="list persisted Team rosters (T-0142)")
    tlst.add_argument("--json", action="store_true", help="raw JSON output")
    tlst.set_defaults(func=cmd_team_list)
    ta = team_sub.add_parser("archive", help="true-archive a session (suspend + archive)")
    ta.add_argument("sid", help="target session SID")
    ta.set_defaults(func=cmd_team_archive)
    tr = team_sub.add_parser("resurrect", help="bring a session back (unarchive + resume)")
    tr.add_argument("sid", help="target session SID")
    tr.set_defaults(func=cmd_team_resurrect)
    trn = team_sub.add_parser("rename", help="rename a session (tmux + UI + registry sync)")
    trn.add_argument("sid", help="target session SID")
    trn.add_argument("name", help="new session/window name")
    trn.set_defaults(func=cmd_team_rename)

    # guidance (T-0151: surface buried stakeholder guidance)
    gd = sub.add_parser("guidance", help="search prior stakeholder guidance (T-0151)")
    gd_sub = gd.add_subparsers(dest="sub", required=True)
    gds = gd_sub.add_parser("search",
                            help="grep tickets + sessions + jsonl logs for stakeholder comments")
    gds.add_argument("keywords", nargs="+", help="keywords (e.g. a ticket id + title words)")
    gds.add_argument("--limit", type=int, default=12, help="max hits to show (default 12)")
    gds.add_argument("--all-projects", action="store_true",
                     help="grep every ~/.claude/projects dir (default: slug-matched dirs only)")
    gds.add_argument("--json", action="store_true", help="raw JSON output")
    gds.set_defaults(func=cmd_guidance_search)

    # ticket (T-0152: native bot-squad-ticket task management)
    tk = sub.add_parser("ticket", help="bot-squad backlog ticket status / update / note")
    tk_sub = tk.add_subparsers(dest="sub", required=True)
    tks = tk_sub.add_parser("status", help="show a ticket's status + bindings")
    tks.add_argument("id", help="ticket id, e.g. T-0149")
    tks.add_argument("--json", action="store_true", help="raw JSON output")
    tks.set_defaults(func=cmd_ticket_status)
    tku = tk_sub.add_parser("update", help="set a ticket's status (canonical schema)")
    tku.add_argument("id", help="ticket id")
    tku.add_argument("status", help="new status: " + "/".join(TICKET_STATUSES))
    tku.set_defaults(func=cmd_ticket_update)
    tkn = tk_sub.add_parser("note", help="append a progress note to a ticket")
    tkn.add_argument("id", help="ticket id")
    tkn.add_argument("body", help="progress note text")
    tkn.add_argument("--sid", help="override this session's SID")
    tkn.set_defaults(func=cmd_ticket_note)

    # scenario (T-0158: manual-testing-first discipline)
    sc = sub.add_parser("scenario", help="manual test scenario templates (T-0158)")
    sc_sub = sc.add_subparsers(dest="sub", required=True)
    scn = sc_sub.add_parser("new", help="write a scenario template for a ticket")
    scn.add_argument("ticket", help="ticket id, e.g. T-0149")
    scn.add_argument("--force", action="store_true", help="overwrite an existing scenario file")
    scn.set_defaults(func=cmd_scenario_new)

    # feedback (T-0154: friction-submission channel for in-project agents)
    fb = sub.add_parser("feedback", help="submit process/product friction upstream (T-0154)")
    fb_sub = fb.add_subparsers(dest="sub", required=True)
    fbs = fb_sub.add_parser("submit", help="append a friction note to the project feedback queue")
    fbs.add_argument("message", nargs="+", help="what bit you + what would help")
    fbs.add_argument("--usecase", help="attach this feedback to a use case id (T-0159)")
    fbs.add_argument("--sid", help="override this session's SID")
    fbs.set_defaults(func=cmd_feedback_submit)

    # usecase (T-0159: use cases / user flows as first-class storage + tooling)
    uc = sub.add_parser("usecase", help="use cases / user flows: new / list / run (T-0159)")
    uc_sub = uc.add_subparsers(dest="sub", required=True)
    ucn = uc_sub.add_parser("new", help="scaffold a use-case md")
    ucn.add_argument("id", help="use-case id, e.g. UC-operator-dispatch-loop")
    ucn.add_argument("--title", help="human title (default: the id)")
    ucn.add_argument("--force", action="store_true", help="overwrite an existing use case")
    ucn.set_defaults(func=cmd_usecase_new)
    ucl = uc_sub.add_parser("list", help="list this project's use cases")
    ucl.add_argument("--json", action="store_true", help="raw JSON output")
    ucl.set_defaults(func=cmd_usecase_list)
    ucr = uc_sub.add_parser("run", help="spawn a testing-dev session to walk a use case")
    ucr.add_argument("id", help="use-case id to run")
    ucr.add_argument("--window", help="tmux window name (default: uctest-<id>)")
    ucr.add_argument("--owner", help="UI username to stamp on the session")
    ucr.add_argument("--report-to", dest="report_to", help="SID to report PASS/FAIL to (default: this session)")
    ucr.add_argument("--dry-run", action="store_true", help="print the testing brief without spawning")
    ucr.set_defaults(func=cmd_usecase_run)

    # autopilot (T-0153: prompt-driven, time-boxed autonomous runs)
    ap = sub.add_parser("autopilot", help="prompt-driven, time-boxed autonomous runs (T-0153)")
    ap_sub = ap.add_subparsers(dest="sub", required=True)
    aps = ap_sub.add_parser("start", help="start an autopilot run for a team/session/project")
    aps.add_argument("kind", choices=["team", "session", "project"], help="target level")
    aps.add_argument("prompt", help="the autopilot task prompt the TL will drive")
    aps.add_argument("--ref", help="team name or session SID (omit for project-level)")
    aps.add_argument("--early-exit", dest="early_exit", help="early-exit condition (TL-evaluated)")
    aps.add_argument("--hours", type=float, help="duration in hours (default 8)")
    aps.add_argument("--stall", type=int, help="stall threshold in minutes (default 60)")
    aps.add_argument("--watchdog", type=int, help="watchdog cadence in minutes (default 5)")
    aps.set_defaults(func=cmd_autopilot_start)
    apx = ap_sub.add_parser("stop", help="end an autopilot early (TL early-exit, or operator cancel)")
    apx.add_argument("--key", help="autopilot key (default: the run targeting this session)")
    apx.add_argument("--reason", help="early-exit reason (set ⟹ exited; omit ⟹ stopped)")
    apx.add_argument("--sid", help="override this session's SID (target match)")
    apx.set_defaults(func=cmd_autopilot_stop)
    apl = ap_sub.add_parser("status", help="list autopilot runs for this project")
    apl.add_argument("--json", action="store_true", help="raw JSON output")
    apl.set_defaults(func=cmd_autopilot_status)

    # compact
    cp = sub.add_parser("compact", help="send /compact to a session (self by default)")
    cp.add_argument("--sid", help="target SID (default: this session)")
    cp.set_defaults(func=cmd_compact)

    # commit
    cm = sub.add_parser("commit", help="stage explicit paths + safe-commit")
    cm.add_argument("-m", "--message", required=True, help="commit message")
    cm.add_argument("--ack", action="store_true",
                    help="acknowledge the peer-activity report (BOT_SQUAD_ACK_PEERS=1)")
    cm.add_argument("files", nargs="*", help="explicit file paths to stage + commit")
    cm.set_defaults(func=cmd_commit)

    return p


def main(argv: list[str]) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main(sys.argv[1:])
