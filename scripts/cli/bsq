            print(path.read_text(encoding="utf-8", errors="replace").rstrip())
        else:
            print(f"\n=== {title} ===\n(missing: {path})")

    _emit("PRODUCT", data / "vision" / "product.md")
    _emit("TEAM PROTOCOL", data / "vision" / "team_protocol.md")
    _emit(f"YOUR ROLE CONTRACT ({role_file})", _roles_ssot_dir() / role_file)  # T-0198: SSOT

    # Bindings from the session md (primary + extras).
    if sid:
        md = data / "sessions" / f"{sid}.md"
        if md.exists():
            fm = read_frontmatter(md)
            primary_t = (fm.get("task_id") or "").strip()
            primary_t = "" if primary_t in ("", "~") else primary_t
            extras_t = _fm_list(fm.get("extra_task_ids"))
            primary_i = (fm.get("initiative") or "").strip()
            primary_i = "" if primary_i in ("", "~") else primary_i
            extras_i = _fm_list(fm.get("extra_initiatives"))
            print("\n=== YOUR BINDINGS ===")
            if primary_t or extras_t:
                parts = [f"{primary_t} (primary)"] if primary_t else []
                parts += extras_t
                print(f"Tasks: {', '.join(parts)} — read each md under "
                      f"data/{slug}/backlog/<id>-*.md")
            if primary_i or extras_i:
                parts = [f"{primary_i} (primary)"] if primary_i else []
                parts += extras_i
                print(f"Initiatives: {', '.join(parts)} — "
                      f"data/{slug}/vision/initiatives/")
            if not (primary_t or extras_t or primary_i or extras_i):
                print("(no task/initiative bound to this session)")

    print("\n(AGENT_INSTRUCTIONS.md + constitution.md are separate on-demand "
          "reads — see the ORIENTATION pointers in your session banner.)")


