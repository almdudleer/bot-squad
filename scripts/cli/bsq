# --------------------------------------------------------------------------
# entity creation verbs (T-0174) — atomic, collision-free ids for EVERY
# entity type. Each wraps the matching worker `*_new` action, which allocates
# from a per-type fcntl-locked counter (data/<slug>/_counters/<type>.txt). No
# hand-picked ids anywhere — that was the root cause of the collision
# incidents (T-0042 / T-0114 / T-0120).
# --------------------------------------------------------------------------
# next-wave #14 (T-0452): provenance gate at ticket-creation time. The grammar
# MUST stay byte-compatible with the post-hoc SSOT lint
# scripts/lint/backlog_provenance.py (test_bsq_task_provenance asserts they
# agree). Allowed tokens (comma-separated list permitted):
#   corpus:<token> | F-NNNN | T-NNNN | stakeholder:YYYY-MM-DD
_PROVENANCE_TOKEN_RE = re.compile(
    r"\A(?:"
    r"corpus:[a-z0-9][a-z0-9-]*"
    r"|F-\d+"
    r"|T-\d{4,}"
    r"|stakeholder:\d{4}-\d{2}-\d{2}"
    r")\Z"
)
_PROVENANCE_HELP = (
    "corpus:<token> | F-NNNN | T-NNNN | stakeholder:YYYY-MM-DD "
    "(comma-separated list allowed)"
)


def _provenance_valid(value: str) -> bool:
    parts = [p.strip() for p in value.split(",") if p.strip()]
    return bool(parts) and all(_PROVENANCE_TOKEN_RE.match(p) for p in parts)


def _stamp_provenance(text: str, value: str) -> str:
    """Insert/replace ``provenance: <value>`` in a ticket's YAML frontmatter.

    Pure function (testable). Drops any existing ``provenance:`` line and appends
    the new one as the last frontmatter key; if the doc has no frontmatter block
    a minimal one is prepended.
    """
    m = re.match(r"\A(---\n)(.*?)(\n---\n)(.*)\Z", text, re.DOTALL)
    if not m:
        return f"---\nprovenance: {value}\n---\n\n{text}"
    head, fm, close, rest = m.groups()
    fm_lines = [ln for ln in fm.split("\n") if not re.match(r"\s*provenance\s*:", ln)]
    fm_lines.append(f"provenance: {value}")
    return head + "\n".join(fm_lines) + close + rest


def cmd_task_new(args) -> None:
    slug = resolve_slug()
    prov = (getattr(args, "provenance", None) or "").strip()
    if not prov:
        die("task new requires --provenance (alias --source): cite the source so "
            "the ticket isn't minted sourceless.\n"
            f"  allowed: {_PROVENANCE_HELP}\n"
            "  see data/<slug>/docs/roadmap/provenance.md")
    if not _provenance_valid(prov):
        die(f"task new: invalid --provenance {prov!r}\n  allowed: {_PROVENANCE_HELP}")
    params = {"slug": slug, "title": args.title}
    for k in ("initiative", "priority", "owner"):
        v = getattr(args, k, None)
        if v:
            params[k] = v
    # T-0577: only sent when the user opts in, so an unpatched worker (no
    # dedupe gate yet) still accepts the call unchanged.
    if getattr(args, "force", False):
        params["force"] = True
    verbatim = getattr(args, "verbatim", None)
    if verbatim:
        params["verbatim"] = verbatim
    # T-0519: pass the (client-validated) provenance INTO the action so the
    # worker requires+validates+stamps it at the gate. Fall back to the legacy
    # post-hoc stamp for a pre-T-0519 worker that doesn't yet accept the param
    # (deploy-ordering shim — bsq is instant-live, the worker gate rides a
    # deploy; this keeps `bsq task new` working against both. Remove the
    # fallback once the gate is everywhere).
    try:
        res = post("task_new", {**params, "provenance": prov}, fatal=False)
    except WorkerError as e:
        if "unexpected params" not in str(e):
            die(str(e))
        res = post("task_new", params)
        path = Path(res["file_path"])
        try:
            _write_atomic(path, _stamp_provenance(path.read_text(encoding="utf-8"), prov))
        except OSError as ex:
            die(f"task new: created {res['id']} but failed to stamp provenance: {ex}")
    print(f"{res['id']}  ->  {res['file_path']}  (provenance: {prov})")


