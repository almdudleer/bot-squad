def cmd_ticket_update(args) -> None:
    slug = resolve_slug()
    status = args.status.strip()
    if status not in TICKET_STATUSES:
        die(f"invalid status {status!r}; canonical: {', '.join(TICKET_STATUSES)}")
    path = find_ticket(slug, args.id.strip())
    # T-0591 (F3.3): gate the planned/open -> in_progress transition — the
    # moment real build work starts — on a stakeholder-sourced ticket having
    # ACTUAL verbatim words, not the task_new stub. Later transitions
    # (totest/closed/reopened) aren't re-checked: by then the builder has
    # already either fixed it or hit this same gate on a later restart.
    if status == "in_progress":
        fm = read_frontmatter(path)
        if _is_stakeholder_provenance(fm.get("provenance", "")):
            verbatim = _extract_verbatim_section(path)
            if _verbatim_is_placeholder(verbatim):
                die(
                    f"{args.id}: refusing planned/open -> in_progress — "
                    "this is a stakeholder-sourced ticket but its "
                    "'## Verbatim request' section is empty or still the "
                    "task_new placeholder. Paste the stakeholder's actual "
                    "words into that section first (edit the ticket body), "
                    "then retry."
                )
    text = path.read_text()
    m = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        die(f"no frontmatter in {path}")
    fm_block = text[m.start(1):m.end(1)]
    lines = fm_block.splitlines()
    old = "?"
    found = False
    for i, ln in enumerate(lines):
        mm = re.match(r"^status:\s*(.*)$", ln)
        if mm:
            old = mm.group(1).strip()
            lines[i] = f"status: {status}"
            found = True
            break
    if not found:
        lines.append(f"status: {status}")
    new_fm = "\n".join(lines)
    new_text = text[:m.start(1)] + new_fm + text[m.end(1):]
    _write_atomic(path, new_text)
    print(f"{args.id}: status {old} -> {status}")
    # No tree-wide lint here: the status value was validated against
    # TICKET_STATUSES before the write, so the file we just wrote is
    # canonical by construction. (scripts/lint/backlog_frontmatter.py scans
    # every project — it would false-warn on other projects' legacy values.)


