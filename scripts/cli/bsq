    pending = res.get("pending_backlog")
    if res.get("paused"):
        print(f"operator re-drive: ⏸ PAUSED for {slug} ({pending} pending)")
        return
    live = res.get("live_operators") or []
    seat = (res.get("operator_seat") or {}).get("holder")
    if live:
        print(f"operator re-drive: ▶ DRIVING for {slug} "
              f"(operator {live[0]}, {pending} pending)")
    elif res.get("state") == "seat-held":
        # T-0937: no operator SESSION, and not because nothing is happening —
        # a root session holds the seat and is driving the board itself. This
        # holds at any tier, which is what separates it from `direct-tier`.
        print(f"operator re-drive: 🪑 SEAT HELD for {slug} — no operator "
              f"by design ({pending} pending)")
        print(f"  driving           : {_seat_line(seat)}")
        print("  `bsq operator seat status` for the claim, `bsq route` for "
              "the load")
    elif res.get("state") == "direct-tier":
        # T-0855: no operator ON PURPOSE — small flow, a user session drives the
        # devs. Printing this as "pending re-drive" would read as a stuck project.
        topo = res.get("topology") or {}
        c = topo.get("counts") or {}
        ucs = topo.get("attending_user_session_sids") or []
        print(f"operator re-drive: ⇢ DIRECT TIER for {slug} — no operator by "
              f"design ({pending} pending, {c.get('tasks_in_flight', '?')} task(s) "
              f"in flight, {c.get('live_devs', '?')} live dev(s))")
        print(f"  driven by: {ucs[0] if ucs else '(none)'}   ·   `bsq route` for "
              f"the thresholds")
    else:
        print(f"operator re-drive: idle for {slug} (empty backlog)")


# --------------------------------------------------------------------------
# T-0937: the operator SEAT — who is DRIVING this board, whatever their role.
# `live_operators` only ever showed sessions whose ROLE is operator, so a root
# user-conversation session that had claimed the drive was invisible to every
# gate and the 60s re-drive minted a second dispatcher behind it. The seat is
# that root's claim, and it is a HAT rather than a morph: the session keeps its
# own role, its TG attendance and its routing («ты должен стать оператором
# одновременно с юзер-сессией»). Read-and-write; the worker owns the rule.
# --------------------------------------------------------------------------

def _seat_line(seat: dict | None) -> str:
    """One line describing a seat record from `operator_seat.seat_holder`."""
    if not seat:
        return "(vacant)"
    how = {"claim": "claimed", "drive": "drive mode"}.get(seat.get("kind"), seat.get("kind"))
    since = f", since {seat['since']}" if seat.get("since") else ""
    return f"{seat.get('sid')}  [{seat.get('role')} session, via {how}{since}]"


def cmd_operator_seat_status(args) -> None:
    slug = resolve_slug()
    res = post("operator_status", {"slug": slug})
    seat = res.get("operator_seat") or {}
    if getattr(args, "json", False):
        print(json.dumps(seat, indent=2, sort_keys=True))
        return
    if seat.get("enabled") is False:
        print(f"operator seat: DISABLED for this worker "
              f"(BOT_SQUAD_OPERATOR_SEAT=0) — the re-drive ignores every claim")
        return
    # An unreadable seat is NOT an empty one: printing them the same way is the
    # silent-None failure the drive-mode design (D-0069) names as its worst case.
    if seat.get("error"):
        print(f"operator seat: UNREADABLE for {slug} — {seat['error']}")
        print("  the re-drive treats this as VACANT and will mint an operator")
        return
    holder = seat.get("holder")
    print(f"operator seat for {slug}: "
          + ("HELD by " + _seat_line(holder) if holder else "VACANT"))
    if holder and holder.get("source"):
        print(f"  source            : {holder['source']}")
    live = res.get("live_operators") or []
    if live:
        print(f"  live operator     : {live[0]}   (it drives the board by role)")
    for why in (seat.get("rejected") or []):
        # WHY a candidate is not the holder — a claim by a session that has since
        # died reads identically to no claim at all unless this is printed.
        print(f"  not holding       : {why}")
    if not holder and not live:
        print("  → `bsq operator seat claim` to drive the board yourself, or "
              "let the 60s re-drive mint an operator")


