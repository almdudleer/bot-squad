_MORPH_ROLE_ALIASES = {
    "dev": "dev",
    "tl": "teamlead", "teamlead": "teamlead", "team-lead": "teamlead",
    "op": "operator", "operator": "operator",
    # T-0932: the DE-differentiation direction — narrow back down to the
    # conversation after handing your work to a bud («отделение себя в
    # юзер-сессию»). Sheds the task binding worker-side.
    "uc": "user-conversation", "user": "user-conversation",
    "user-conversation": "user-conversation",
    "user_conversation": "user-conversation",
}


def _normalize_morph_role(raw: str) -> str:
    role = _MORPH_ROLE_ALIASES.get((raw or "").strip().lower())
    if role is None:
        die(f"--role must be one of dev|tl|operator|uc (got {raw!r})")
    return role


def _my_pane_fields() -> "tuple[str | None, str | None]":
    """Current tmux pane's (window, cwd) — used to seed an md for an
    unregistered, manually-launched user session that has none yet."""
    if not os.environ.get("TMUX"):
        return None, None
    target = ["-t", os.environ["TMUX_PANE"]] if os.environ.get("TMUX_PANE") else []
    try:
        window = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#W"],
            capture_output=True, text=True,
        ).stdout.strip()
        window = re.sub(r"[^A-Za-z0-9_-]", "_", window) or None
        cwd = subprocess.run(
            ["tmux", "display-message", "-p", *target, "-F", "#{pane_current_path}"],
            capture_output=True, text=True,
        ).stdout.strip() or None
        return window, cwd
    except (OSError, subprocess.SubprocessError):
        return None, None


def cmd_morph(args) -> None:
    """T-0509 (M11/F11.2): MORPH this user session's role in place.

    A user-launched claude session is a USER session by default; it can take on
    a task and become a dev, spawn teammates and become a team-lead, or become
    the operator if none is running ("sessions are transient, system is
    persistent"). Updates this session's role/task/initiative metadata in place
    — the peer-bus SID is unchanged (no window rename). ``--role operator`` is
    refused when an operator already holds the project."""
    slug = resolve_slug()
    sid = require_sid(getattr(args, "sid", None))
    role = _normalize_morph_role(args.role)
    params = {"slug": slug, "sid": sid, "role": role}
    if getattr(args, "task", None):
        params["task_id"] = args.task
    if getattr(args, "initiative", None):
        params["initiative"] = args.initiative
    # Seed the live-pane identity so the worker can upsert an md for an
    # unregistered (manually-launched) user session.
    win, cwd = _my_pane_fields()
    if win:
        params["window"] = win
    if cwd:
        params["cwd"] = cwd
    res = post("morph_session", params)
    bits = [f"role={res.get('role')}"]
    if res.get("task_id"):
        bits.append(f"task={res.get('task_id')}")
    if res.get("initiative"):
        bits.append(f"initiative={res.get('initiative')}")
    suffix = " (registered new session md)" if res.get("created") else ""
    print(f"morphed {res.get('sid', sid)}: {', '.join(bits)}{suffix}")


def cmd_write(args) -> None:
    """T-0508 (M11/F11.1, AP#2): attach-and-write to ANY session.

    The second point of access — most often the operator dropping a line into a
    running session. Wraps the live ``inject_input`` primitive (the same
    mechanism behind the peer-bus "check mail" nudge), so the target pane
    receives ``text`` as composer input. The target SID is explicit (you are
    writing to ANOTHER session), never derived from this pane."""
    res = post("inject_input", {"sid": args.sid, "text": args.text})
    n = res.get("lines_sent")
    suffix = f" ({n} line(s))" if n is not None else ""
    print(f"wrote to {args.sid}{suffix}")


def cmd_send_input(args) -> None:
    """T-0469 (M1/F1.6): multiplexed, queue-backed write to a session's channel.

    The agent-facing input channel. Unlike ``bsq write`` (the raw inject_input
    primitive), this QUEUES the write (never rejected), COALESCES concurrent
    callers into one batched delivery with author captions, and DEFERS delivery
    while the user is live-typing / Claude is mid-generation — so other inputs
    never mix with the user's composer text. Agents call this instead of raw
    send-keys. The author caption defaults to THIS session's SID."""
    author = args.author or my_sid() or "system"
    res = post("send_input", {"sid": args.sid, "text": args.text,
                              "author": author})
    delivered = res.get("delivered", 0)
    queued = res.get("queued")
    if delivered:
        print(f"sent to {args.sid}: {delivered} message(s) delivered "
              f"(author={author})")
    elif res.get("deferred"):
        print(f"queued for {args.sid} (depth {queued}, author={author}) — "
              f"deferred: {res.get('reason')} (delivers when composer is ready)")
    else:
        print(f"queued for {args.sid} (depth {queued}, author={author})")


