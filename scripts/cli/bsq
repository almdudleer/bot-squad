_PROGRESS_LINE_RE = re.compile(r"^-\s+(\S+)\s+·\s+(\S+)\s+·\s+(.*)$")


def _progress_lines_by_sid(slug: str) -> dict[str, list[dict]]:
    """Every `## Progress` line across the project's backlog, indexed by the
    authoring SID and sorted chronologically per sid.

    Progress lines (`- <ts> · <sid> · <text>`, task_body.append_progress's
    format) are a session's own narration of its work, stamped by sid — the
    one place that trail survives archival, since a session's LIVE task
    binding (task_id) is cleared when it's archived (last_task_id is the only
    frontmatter trace left). This is the corpus session-history search runs
    over."""
    out: dict[str, list[dict]] = {}
    for p in sorted(backlog_dir(slug).glob("T-*.md")):
        section = _extract_md_section(_md_body(p), "progress")
        if not section:
            continue
        fm = read_frontmatter(p)
        tid = fm.get("id") or p.stem
        for ln in section.splitlines():
            m = _PROGRESS_LINE_RE.match(ln.strip())
            if not m:
                continue
            ts, sid, text = m.groups()
            out.setdefault(sid, []).append({"ts": ts, "ticket": tid, "text": text})
    for lines in out.values():
        lines.sort(key=lambda r: r["ts"])
    return out


def _exited_sessions(slug: str) -> list[dict]:
    """Suspended or archived sessions (the ones with a finished/paused
    history worth searching) via the worker's live session list — same
    source + filter `bsq expert find` uses (`_find_expert`), so ids stay
    real-typed rather than re-parsed from flat frontmatter."""
    sessions = post("list_sessions", {"slug": slug}).get("sessions", [])
    return [s for s in sessions
            if s.get("sid") and (s.get("status") == "suspended" or bool(s.get("archived")))]


def _session_history_tickets(s: dict) -> list[str]:
    out = _session_tickets(s) | set(_clean_id_list(s.get("last_task_id")))
    return sorted(out)


def cmd_session_search(args) -> None:
    slug = resolve_slug()
    by_sid = _progress_lines_by_sid(slug)

    if args.sid:
        sid = args.sid.strip()
        sessions = {s["sid"]: s for s in _exited_sessions(slug)}
        s = sessions.get(sid)
        lines = by_sid.get(sid, [])
        if s is None and not lines:
            die(f"no exited session found for sid {sid!r} "
                f"(no session record and no Progress notes under it)")
        if args.json:
            print(json.dumps({"sid": sid, "session": s, "progress": lines}, indent=2))
            return
        if s:
            tag = "archived" if s.get("archived") else s.get("status", "?")
            print(f"{sid}  [{tag}]  window={s.get('window', '?')}")
            print(f"  tickets: {', '.join(_session_history_tickets(s)) or '-'}")
            print(f"  started: {s.get('started_at', '?')}   "
                  f"suspended: {s.get('suspended_at', '?')}")
        else:
            print(f"{sid}  (no live session record — Progress trail only)")
        if not lines:
            print("  (no Progress notes found under this sid)")
            return
        print("  progress:")
        for r in lines:
            print(f"    {r['ts']}  {r['ticket']}  {r['text']}")
        return

    query = (args.query or "").strip()
    if not query:
        die("session search: pass a free-text query or --sid <sid>")
    kws = [w for w in re.split(r"[^A-Za-z0-9]+", query.lower()) if len(w) >= 2]
    if not kws:
        die(f"session search: query {query!r} has no usable keywords")

    cands = []
    for s in _exited_sessions(slug):
        sid = s["sid"]
        lines = by_sid.get(sid, [])
        blob = " ".join([s.get("window", "").replace("-", " ")] + [r["text"] for r in lines])
        score = _score(blob, kws)
        if score <= 0:
            continue
        cands.append({
            "sid": sid, "window": s.get("window", ""),
            "status": s.get("status", ""), "archived": bool(s.get("archived")),
            "score": score, "tickets": _session_history_tickets(s),
            "snippet": _snippet(blob, kws),
        })
    cands.sort(key=lambda c: (-c["score"], c["sid"]))
    limit = max(1, args.limit)
    cands = cands[:limit]

    if args.json:
        print(json.dumps(cands, indent=2))
        return
    if not cands:
        print(f"(no exited session matched {query!r})")
        return
    print(f"session-history matches for {query!r} (best first):\n")
    for c in cands:
        tag = "archived" if c["archived"] else c["status"]
        print(f"• {c['sid']}  [{tag}, score {c['score']}]")
        print(f"  window: {c['window']}   tickets: {', '.join(c['tickets']) or '-'}")
        print(f"  {c['snippet']}\n")


_ROLE_FILES = {"dev": "dev.md", "tl": "teamlead.md", "teamlead": "teamlead.md",
               "operator": "operator.md",
               # T-0478: user-conversation intake session role contract.
               "user-conversation": "user-conversation.md"}


def _roles_ssot_dir() -> Path:
    """T-0198: the git-tracked role-contract SSOT (``api/app/resources/roles``).

    The spawn assembler (``_assemble_prompt``) and ``bsq brief`` read role
    contracts from HERE — NOT the per-project live copy
    (``data/<slug>/vision/roles``), which is seeded once at scaffold by
    ``project_scaffold._seed_vision_roles`` and then drifts (the role-doc-drift
    bug). Reading the SSOT makes editing the git-tracked contract in ONE place
    what a spawned session actually receives — no dual-edit. The live copy is
    Vision-tab / onboarding DISPLAY only; per-project role edits via the Vision
    tab are intentionally NOT authoritative for the assembler (decision: not a
    supported feature — see docs/architecture/D-0043)."""
    return Path(BOT_SQUAD) / "api" / "app" / "resources" / "roles"
_KW_STOP = {"the", "and", "for", "with", "from", "into", "via", "not", "per",
            "fix", "add", "new", "use", "all", "any", "out", "off", "more"}


def _ticket_keywords(fms: dict[str, dict]) -> list[str]:
    """Derive guidance-search keywords from assigned tickets (ids + title words)."""
    kws: list[str] = list(fms.keys())  # ticket ids
    for fm in fms.values():
        for w in re.split(r"[^A-Za-z0-9]+", fm.get("title", "").lower()):
            if len(w) >= 4 and w not in _KW_STOP and w not in kws:
                kws.append(w)
    return kws[:8]


def _body_after_frontmatter(path: Path) -> str:
    raw = path.read_text(encoding="utf-8", errors="replace")
    return re.sub(r"\A---\n.*?\n---\n", "", raw, flags=re.DOTALL).strip()


def _cross_refs(bodies: list[str], own: set[str]) -> list[str]:
    """`Related: [[T-xxxx]]` ids referenced by the assigned tickets (minus own)."""
    refs: list[str] = []
    for b in bodies:
        for m in re.findall(r"\[\[(T-\d+)\]\]", b):
            if m not in own and m not in refs:
                refs.append(m)
    return refs


def _assemble_prompt(slug: str, tickets: list[str], paths: dict[str, Path],
                     fms: dict[str, dict], role: str, report_to: str) -> str:
    """T-0149: deterministic per-task/role initial-prompt assembly.

    Composes the brief from the ticket bodies + role contract + initiative +
    cross-refs + prior stakeholder guidance (T-0151) + the hard process rules
    (no-superpowers-drift T-0152, manual-first verification T-0158, git/commit
    discipline, report-READY protocol). Replaces the hand-pasted brief so every
    spawn gets the same complete context regardless of who spawns it.
    """
    primary = tickets[0]
    role = role if role in _ROLE_FILES else "dev"
    roles_dir = _roles_ssot_dir()  # T-0198: git-tracked SSOT, not the drifting live copy
    role_path = roles_dir / _ROLE_FILES[role]
    role_text = role_path.read_text(encoding="utf-8", errors="replace").strip() \
        if role_path.exists() else "(role file missing)"

    bodies = {t: _body_after_frontmatter(paths[t]) for t in tickets}
    initiative = fms[primary].get("initiative") or ""
    ai_path = Path(BOT_SQUAD) / "data" / slug / "AGENT_INSTRUCTIONS.md"
    init_path = (Path(BOT_SQUAD) / "data" / slug / "vision" / "initiatives" / initiative
                 if initiative else None)

    # Prior stakeholder guidance (T-0151) folded in deterministically.
    kws = _ticket_keywords(fms)
    hits, total, _ = _collect_guidance(slug, kws, 5)
    if hits:
        guidance = "\n".join(
            f"  • [{h['source']} · {(h.get('ts') or '')[:10]}] {h['text']}" for h in hits)
        guidance = (f"Prior stakeholder guidance found for this work "
                    f"(via `bsq guidance search`, {total} hit(s); re-run for more):\n{guidance}")
    else:
        guidance = ("No prior stakeholder guidance matched. Before designing your "
                    "approach, run `bsq guidance search <keywords>` yourself with "
                    "other terms — buried guidance saves repeating questions (T-0151).")

    refs = _cross_refs(list(bodies.values()), set(tickets))
    refs_line = (f"Cross-referenced tickets (consult via `bsq ticket status <id>`): "
                 f"{', '.join(refs)}.\n\n" if refs else "")

    ticket_blocks = "\n\n".join(
        f"### {t}: {fms[t].get('title', t)}\n{bodies[t]}" for t in tickets)
    bundle_note = (f" You are bundled {len(tickets)} tickets: {', '.join(tickets)} — "
                   f"handle them together in this one session."
                   if len(tickets) > 1 else "")

    return f"""\
You are a bot-squad {role} session assigned {primary}{bundle_note}

The full scope+DoD of each assigned ticket is INLINED below — this brief is
self-contained, but FIRST also read AGENT_INSTRUCTIONS.md ({ai_path}) for
paths/git-rules and your initiative file{f' ({init_path})' if init_path else ''}.

START HERE — ANCHOR ON THE ASK (T-0483): read {primary}'s `## Verbatim request`
below FIRST. That exact string is your target. It was recorded once, verbatim,
from the stakeholder so it reaches you WITHOUT paraphrase loss — that is the
whole point of the task: it defeats broken-telephone. Keep your work anchored to
it; don't let the target drift to the evolved mental model your accumulated
context will suggest (re-read it whenever you compact). It is the source of truth
and HUMAN-ONLY — never edit it.

== ASSIGNED TICKET(S) ==
{ticket_blocks}

{refs_line}== YOUR ROLE CONTRACT ({_ROLE_FILES[role]}) ==
{role_text}

== PRIOR STAKEHOLDER GUIDANCE (T-0151) ==
{guidance}

== HARD PROCESS RULES (enforced — not suggestions) ==
1. TASK MANAGEMENT VIA BOT-SQUAD TICKETS ONLY (T-0152). Do NOT write planning
   artifacts, notes, or task lists into ~/.claude/superpowers/* or other doc
   folders — that's where sessions get lost. Track all multi-step work on the
   ticket: `bsq ticket note <id> <text>` for progress, `bsq ticket update <id>
   <status>` for status. In-session TodoWrite/TaskCreate is ONLY for sub-steps
   within one ticket.
2. MANUAL-TESTING-FIRST (T-0158). For any verification DoD item: (a) write the
