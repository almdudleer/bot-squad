#: (CLI flag attr, monitor-spec key, is-duration) — the monitor flags on
#: `routine declare` (T-0604, D-0048 §5.2). Only flags the user actually set
#: enter the spec; engine defaults apply to the rest.
_MONITOR_FLAG_SPECS = [
    ("probe", "probe", False),
    ("cmd", "cmd", False),
    ("url", "url", False),
    ("expect_status", "expect_status", False),
    ("latency_budget_ms", "latency_budget_ms", False),
    ("interval", "interval_s", True),
    ("timeout", "timeout_s", True),
    ("judge", "judge", False),
    ("threshold", "threshold", False),
    ("persist", "persist_s", True),
    ("cooldown", "cooldown_s", True),
    ("on_breach", "on_breach", False),
    ("on_recover", "on_recover", False),
]


def cmd_routine_declare(args) -> None:
    """T-0464/T-0604: declare a Routine — an instruction + a trigger that
    spawns a session to work per the instruction each time the trigger fires.

    Trigger ``schedule`` (default): a standard 5-field cron expression (UTC)
    via ``--schedule``, e.g. ``"0 9 * * *"`` (daily 09:00) — one session per
    due tick. Trigger ``monitor`` (D-0048): a code-only probe watched by the
    worker's 5s monitor tick; AI attaches only on a persist-confirmed
    threshold breach. Zero tokens while healthy."""
    slug = resolve_slug()
    trigger = (args.trigger or "schedule").strip().lower()
    params = {"slug": slug, "instruction": args.instruction, "trigger": trigger}

    monitor: dict = {}
    for attr, key, is_duration in _MONITOR_FLAG_SPECS:
        val = getattr(args, attr, None)
        if val is None:
            continue
        monitor[key] = parse_duration_s(val) if is_duration else val

    if trigger == "monitor":
        if args.schedule:
            die("--trigger monitor takes probe/judge flags, not --schedule")
        if "threshold" in monitor:
            # numeric judges want a number; regex_match keeps the string
            try:
                as_num = float(monitor["threshold"])
                monitor["threshold"] = (int(as_num) if as_num == int(as_num)
                                        else as_num)
            except ValueError:
                pass
        params["monitor"] = monitor
    else:
        if monitor:
            die(f"monitor flags ({', '.join(sorted(monitor))}) need "
                "--trigger monitor")
        if not args.schedule:
            die(f"--trigger {trigger} requires --schedule "
                "(5-field cron expression, UTC)")
        params["schedule"] = args.schedule
    if getattr(args, "title", None):
        params["title"] = args.title
    if getattr(args, "provenance", None):
        params["provenance"] = args.provenance
    res = post("routine_declare", params)
    print(f"{res['id']}  ->  {res['file_path']}  (next run: {res.get('next_run_at')})")


def cmd_routine_list(args) -> None:
