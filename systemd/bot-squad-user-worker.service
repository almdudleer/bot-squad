# bot-squad per-user worker (Phase 2 multi-user, tmux ops only).
#
# One copy per non-coordinator Linux user (e.g. edem, dima). Runs in
# `systemd --user` for that user. Binds a Unix socket at
# /home/www/bot-squad/data/_sock/user-<USER>.sock and handles only
# tmux-tagged worker actions (list_sessions / pause / suspend / resume
# / spawn / inject_input). Coordinator actions (deploy, tg_notify,
# peer_send, autonomous_*, scheduler_state, task_progress_add) are
# refused with ActionError in this mode.
#
# T-0067: this unit is installed SYSTEM-WIDE by the installer's
# step_per_user_worker_unit (drops it into /etc/systemd/user/) so a
# fresh attached user does NOT need a separate sudo cycle to discover
# it. Per-user enablement is a one-shot the user themselves runs on
# first login:
#
#   bash /home/www/bot-squad/scripts/install/enable-per-user-worker.sh
#
# The script does:
#   sudo loginctl enable-linger <USER>          # survives logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now bot-squad-user-worker.service
#
# Then add the UI user mapping to /home/www/bot-squad/config/auth.toml:
#   [user_meta.<ui_name>]
#   linux_user = "<USER>"
#   is_admin = false
#
# Verify (from any account with read on /home/www/bot-squad/data/_sock):
#   ls -l /home/www/bot-squad/data/_sock/user-<USER>.sock  (group www, 0660)
#   curl --unix-socket .../user-<USER>.sock http://w/health

[Unit]
Description=bot-squad per-user worker (tmux ops)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/www/bot-squad
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=info
# T-0179: load the install .env so the worker sees BOT_SQUAD_SECRETS_KEY (the
# at-rest encryption key for secrets.toml). Leading '-' = optional so a missing
# .env never blocks startup (no key → secrets stay plaintext). See the
# coordinator unit for the full rationale.
EnvironmentFile=-/home/www/bot-squad/.env
Environment=BOT_SQUAD_MODE=user-worker
ExecStart=/home/www/bot-squad/worker/.venv/bin/python -m bot_squad_worker --config /home/www/bot-squad/config
Restart=on-failure
RestartSec=10s
# T-0119: same graceful-shutdown cap as the coordinator unit.
TimeoutStopSec=10s

# Hardening — same posture as the coordinator unit but without the
# heartbeat / deploy writes. The user-worker still needs tmux + claude
# in the user's HOME.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/www/bot-squad/data
# PrivateTmp INTENTIONALLY DISABLED — the worker needs to see the
# user's tmux server at /tmp/tmux-<uid>/default to control panes.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=default.target
